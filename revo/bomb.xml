<drv mrk="bomb.0o">
  <kap><tld/>o</kap>
  <snc mrk="bomb.0o.armilo">
    <uzo tip="fak">MIL</uzo>
    <dif>
      Eksplodkapabla metala globo a&ubreve; kesto, uzata kiel armilo.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x53EF;&#x7206;&#x70B8;&#x7684;&#x91D1;&#x5C5E;&#x7403;&#x6216;&#x91D1;&#x5C5E;&#x7BB1;&#xFF0C;&#x7528;&#x4F5C;&#x6B66;&#x5668;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An explosive metal sphere or box used as a weapon.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Explosionsf&auml;hige metallene Kugel oder Kiste, die als Waffe verwendet wird.</dif>
    <subsnc mrk="bomb.0o.falanta">
      <dif>
        Armilo trafanta sian celon per libera falo, &jcirc;etite el
        bombavio a&ubreve; bombopafilo:
        <ekz>
          NATO dum la aeratakoj en 1999 kontra&ubreve; Jugoslavio
          super&scirc;utis la landon [...] per <tld/>oj
          <fnt>
            <aut>S. Maul</aut>
            <vrk>Trompitaj dizertintoj</vrk>
            <bib>Monato</bib>
            <lok>2000:12, p. 9a</lok>
          </fnt>.
        </ekz>
      </dif>
      <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A weapon that strikes its target by free fall, dropped from a bomber or fired from a mortar.</dif>
      <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Waffe, die ihr Ziel im freien Fall trifft, abgeworfen von einem Bombenflugzeug oder abgefeuert aus einem M&ouml;rser.</dif>
      <refgrp tip="vid">
        <ref cel="grenad.0o">grenado</ref>,
        <ref cel="obus.0o">obuso</ref>.
      </refgrp>
      <trd lng="pl">bomba<klr> lotnicza</klr></trd>
    </subsnc>
    <subsnc mrk="bomb.0o.terorista">
      <dif>
        Eksploda aran&gcirc;a&jcirc;o farita de teroristoj:
        <ekz>
          en a&ubreve;gusto 1998 preska&ubreve; samtempe eksplodis
          <tld/>oj anta&ubreve; la
          usonaj ambasadorejoj en Najrobo (Kenjo) kaj Daresalamo
          (Tanzanio)
          <fnt>
            <aut>W. Klag</aut>
            <vrk>Bariloj kontra&ubreve; bomboj</vrk>
            <bib>Monato</bib>
            <lok>1999:3, p. 7a</lok>
          </fnt>.
        </ekz>
      </dif>
      <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 90%">&#x6050;&#x6016;&#x5206;&#x5B50;&#x5236;&#x9020;&#x7684;&#x7206;&#x70B8;&#x88C5;&#x7F6E;&#x3002;</dif>
      <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An explosive device made by terrorists.</dif>
      <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Von Terroristen hergestellte Sprengvorrichtung.</dif>
      <ref tip="vid" cel="min.0o">mino</ref>
      <adm>
        infera ma&scirc;ino?? <aut>Sergio</aut>
      </adm>
      <trdgrp lng="pl">
        <trd>bomba</trd>,
        <trd>&lstroke;adunek wybuchowy</trd>
      </trdgrp>
      <trdgrp lng="zh">
        <trd fnt="AI: en; proponis gpt-5.6-luna; taksis Jev 92%">&#x70B8;&#x5F48; <pr>zh&agrave;d&agrave;n</pr></trd>,
        <trd fnt="AI: en; proponis gpt-5.6-luna; taksis Jev 92%">&#x70B8;&#x5F39; <pr>zh&agrave;d&agrave;n</pr></trd>
      </trdgrp>
    </subsnc>
    <trdgrp lng="zh">
    <trd>&#x7206;&#x70B8;&#x7269; <pr>b&agrave;ozh&agrave;w&ugrave;</pr></trd>,
    <trd>&#x5F15;&#x7206;&#x88C5;&#x7F6E; <pr>y&#x1D0;nb&agrave;ozhu&amacron;ngzh&igrave;</pr></trd>,
    <trd>&#x7206;&#x70B8;&#x88C5;&#x7F6E; <pr>b&agrave;ozh&agrave;zhu&amacron;ngzh&igrave;</pr></trd>,
    <trd>&#x70B8;&#x5F39; <pr>zh&agrave;d&agrave;n</pr></trd>
  </trdgrp>
</snc>
  <trd lng="be">&c_b;&c_o;&c_m;&c_b;&c_a;</trd>
  <trd lng="bo">&t_-a;&t_ba;&t_naro;&t_ma;&t_tsheg;</trd>
