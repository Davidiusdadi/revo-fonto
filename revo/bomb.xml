<drv mrk="bomb.atom0o">
  <kap>
    atom<tld/>o
  </kap>
  <snc>
    <dif>
      <tld lit="B"/>o funkcianta per &ccirc;enreago de disparti&gcirc;antaj atomoj:
      <ekz>
        la 9an de a&ubreve;gusto 1945 usona <tld/>aviadilo B-29 kun atom<tld/>o ekflugis
        <klr>[&#x2026;]</klr> al Nagasako kaj faligis &gcirc;in je alteco de 9600 metroj
        <fnt>
          <bib>Monato</bib>
          <aut>Hori Yasuo</aut>
          <vrk><url ref="&Monato;/2008/009358.php">Nagasako</url></vrk>
          <lok>2008</lok>
        </fnt>;
      </ekz>
      <ekz>
        Usono ne devis &jcirc;eti atom<tld/>ojn sur Japanion, se iu pacdefendanto sukcesplene
        anta&ubreve;e &leftquot;diskutus&rightquot; kun japanaj militistoj
        <fnt>
          <bib>Monato</bib>
          <vrk><url ref="&Monato;/2003/007981.html">Al la intelektuloj de
          Monato</url></vrk>
          <lok>2003</lok>
        </fnt>;
      </ekz>
      <ekz>
        nun do anka&ubreve; Nord-Koreio havas &gcirc;in, la atom<tld/>on
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2009/009837.php">Monstra atompotenco</url></vrk>
          <lok>2009</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_t;&c_a;&c_m;&c_n;&c_a;&c_ja; &c_b;&c_o;&c_m;&c_b;&c_a;</trd>
  <trd lng="de">Atombombe</trd>
  <trd lng="en">atomic bomb</trd>
  <trd lng="fr">bombe atomique</trd>
  <trd lng="ja">&#x539F;&#x5B50;&#x7206;&#x5F3E;  <pr>&#x3052;&#x3093;&#x3057;&#x3070;&#x304F;&#x3060;&#x3093;</pr></trd>
  <trd lng="pl">bomba atomowa</trd>
  <trd lng="uk">&c_a;&c_t;&c_o;&c_m;&c_n;&c_a; &c_b;&c_o;&c_m;&c_b;&c_a;</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: zh en ja; taksis Jev 97%">&#x539F;&#x5B50;&#x5F48; <pr>yu&aacute;nz&#x01D0;d&agrave;n</pr></trd>,
    <trd fnt="Vikt: zh en ja; taksis Jev 97%">&#x539F;&#x5B50;&#x5F39; <pr>yu&aacute;nz&#x01D0;d&agrave;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="bomb.horlogx0o">
  <kap>horlo&gcirc;<tld/>o,
  <var><kap>prokrasta <tld/>o</kap></var></kap>
  <snc mrk="bomb.horlogx0o.ARM">
    <dif>
      <tld lit="B"/>o, kiu eksplodas post determinita tempo
      dank'al horlo&gcirc;a me&hcirc;anismo:
      <ekz>
        <uzo tip="stl">FIG</uzo>
        <ctl>Deprimo: socia kaj ekonomia horlo&gcirc;-<tld/>o</ctl>
        <fnt>
          <aut>P. S. Viana</aut>
          <vrk>Deprimo</vrk>
          <bib>Monato</bib>
          <lok>2001:6, p. 11a</lok>
        </fnt>;
      </ekz>
      <ekz>
        [t]io faris al la resani&gcirc;antaj amikoj de Vla&ccirc;jo
        impreson multe pli grandan, ol se &ccirc;i tie, en
        profunda malfronto, eksplodus prokrasta <tld/>o peza
        je tuno
        <fnt>
          <aut>J. German, trad. J. Finkel</aut>
          <vrk><url ref="https://www.esperanto.mv.ru/German/kara-12-4.html">
          Kara mia homo</url></vrk>
          <lok>2016-2017</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A bomb that explodes after a set time by means of a clockwork mechanism.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Bombe, die dank eines Uhrwerks nach einer bestimmten Zeit explodiert.</dif>
    <trd lng="zh">&#x5B9A;&#x65F6;&#x70B8;&#x5F39; <pr>d&igrave;ngsh&iacute;zh&agrave;d&agrave;n</pr></trd>
</snc>
  <trd lng="be">&c_b;&c_o;&c_m;&c_b;&c_a; &c_z; &c_g;&c_a;&c_d;&c_z;&c_ib;&c_n;&c_mol;&c_n;&c_ib;&c_k;&c_a;&c_v;&c_y;&c_m; &c_m;&c_e;&c_h;&c_a;&c_n;&c_ib;&c_z;&c_m;&c_a;&c_m;</trd>
  <trd lng="de">Zeitbombe</trd>
  <trd lng="es">bomba de relojer&iacute;a</trd>
  <trd lng="en">time bomb</trd>
  <trd lng="fr">bombe &agrave; retardement</trd>
  <trdgrp lng="it">
    <trd><ind>bomba</ind> a orologeria</trd>,
