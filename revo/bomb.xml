<drv mrk="bomb.0opafilo">
  <kap><tld/>opafilo, <var><kap><tld/>okanono</kap></var></kap>
  <uzo tip="fak">MIL</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="paf.0ilego">Pafilego</ref>, plej ofte
      glattuba, por pafi <ref cel="bomb.0o.falanta"><tld/>ojn</ref>
      la&ubreve; alta, arkforma trajektorio, uzata ekz-e por pafi trans
      monto a&ubreve; alia vertikala baro. Tipa <tld/>opafilo konsistas
      el
      tubo, dukrura <ref tip="prt" cel="afust.0o">afusto</ref>,
      apoga plato kaj celilo. La kutimaj kalibroj estas
      50&ndash;60mm (rota <tld/>opafilo), 81&ndash;90mm (bataliona),
      105mm (a&ubreve; pli, regimenta).
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x7528;&#x4E8E;&#x53D1;&#x5C04;&#x70B8;&#x5F39;&#x7684;&#x706B;&#x70AE;&#xFF0C;&#x901A;&#x5E38;&#x4E3A;&#x6ED1;&#x819B;&#x70AE;&#xFF0C;&#x4F7F;&#x70B8;&#x5F39;&#x6CBF;&#x9AD8;&#x800C;&#x5F2F;&#x66F2;&#x7684;&#x8F68;&#x8FF9;&#x98DE;&#x884C;&#xFF0C;&#x4F8B;&#x5982;&#x7528;&#x4E8E;&#x8D8A;&#x8FC7;&#x5C71;&#x6216;&#x5176;&#x4ED6;&#x5782;&#x76F4;&#x969C;&#x788D;&#x7269;&#x5C04;&#x51FB;&#x3002;&#x5178;&#x578B;&#x7684;&#x8FEB;&#x51FB;&#x70AE;&#x7531;&#x70AE;&#x7BA1;&#x3001;&#x53CC;&#x811A;&#x67B6;&#x3001;&#x5E95;&#x677F;&#x548C;&#x7784;&#x51C6;&#x5177;&#x7EC4;&#x6210;&#x3002;&#x5E38;&#x7528;&#x53E3;&#x5F84;&#x4E3A;50&mdash;60&#x6BEB;&#x7C73;&#xFF08;&#x8F7B;&#x578B;&#x8FEB;&#x51FB;&#x70AE;&#xFF09;&#x3001;81&mdash;90&#x6BEB;&#x7C73;&#xFF08;&#x8425;&#x5C5E;&#x8FEB;&#x51FB;&#x70AE;&#xFF09;&#x3001;105&#x6BEB;&#x7C73;&#xFF08;&#x6216;&#x66F4;&#x5927;&#xFF0C;&#x56E2;&#x5C5E;&#x8FEB;&#x51FB;&#x70AE;&#xFF09;&#x3002;</dif>
    <ref tip="vid" cel="hauxbi.0o">ha&ubreve;bizo</ref>
    <rim>
      PIV preferas la formon <tld/>okanono, sed tio kolizias kun
      la rusa-germana difino de la vorto en la 1a Oficiala Aldono,
      la&ubreve; kiu kanonon karakterizas plata trajektorio.
      <aut>Sergio Pokrovskij</aut>
    </rim>
  </snc>
  <trd lng="be">&c_m;&c_ib;&c_n;&c_a;&c_m;&c_jo;&c_t;</trd>
  <trdgrp lng="cs">
    <trd>hmo&zcaron;d&iacute;&rcaron;</trd>,
    <trd>houfnice</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>M&ouml;rser</trd>,
    <trd>Granatwerfer</trd>
  </trdgrp>
<trdgrp lng="en">
  <trd>mortar</trd>,
  <trd>canon</trd>
</trdgrp>
  <trd lng="es">mortero</trd>
  <trd lng="fr">mortier</trd>
  <trd lng="he">&tav;&vav;&tav;&het; &pe;&tsadi;&tsadi;&he;</trd>
  <trd lng="it">mortaio<klr> (mil.)</klr></trd>
  <trd lng="ja">&#x81FC;&#x7832;  <pr>&#x304D;&#x3085;&#x3046;&#x307B;&#x3046;</pr></trd>
  <trd lng="pl">mo&zacute;dzierz</trd>
  <trd lng="ru">&c_m;&c_i;&c_n;&c_o;&c_m;&c_jo;&c_t;</trd>
  <trd lng="sk">h&uacute;fnica</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: de en fr; proponis gpt-5.6-luna; taksis Jev 95%">&#x8FEB;&#x64CA;&#x7832; <pr>p&#x01CE;ij&#x012B;p&agrave;o</pr></trd>,
    <trd fnt="AI: de en fr; proponis gpt-5.6-luna; taksis Jev 95%">&#x8FEB;&#x51FB;&#x70AE; <pr>p&#x01CE;ij&#x012B;p&agrave;o</pr></trd>
  </trdgrp>
