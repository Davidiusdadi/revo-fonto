<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bej.xml,v 1.9 2025/03/02 11:21:24 revo Exp $">
<kap>
  <rad>bej</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="bej.0o">
  <kap><tld/>o</kap>
  <snc mrk="bej.0o.RANGO">
    <uzo tip="fak">POL</uzo>
    <dif>
      Turkdevena titolo de landestro,
      poste uzata kiel honora alnomo
      malpli alta ol tiu de
      <ref tip="vid" cel="pasxa.0o.POL">pa&scirc;ao</ref>:
      <ekz>
        la <tld/>o estis gardokaptita sur la insulo Santa Cruz
        <fnt>
          <aut>J. Rejt&otilde;, trad. L. Bal&aacute;zs</aut>,
          <vrk><url ref="http://www.freeweb.hu/verkoj/13.htm">
          Mar&scirc;i a&ubreve; morti</url></vrk>,
          <lok>[vidita en 2011]</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x6E90;&#x81EA;&#x571F;&#x8033;&#x5176;&#x8BED;&#x7684;&#x5730;&#x65B9;&#x7EDF;&#x6CBB;&#x8005;&#x79F0;&#x53F7;&#xFF0C;&#x540E;&#x6765;&#x7528;&#x4F5C;&#x4F4E;&#x4E8E;&#x5E15;&#x590F;&#x79F0;&#x53F7;&#x7684;&#x5C0A;&#x79F0;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A title of Turkish origin for a provincial ruler, later used as an honorific below the rank of pasha.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Titel t&uuml;rkischen Ursprungs f&uuml;r einen Landesherrn, sp&auml;ter als Ehrenbeiname gebraucht, der unter dem eines Paschas steht.</dif>
    <trd lng="be">&c_b;&c_e;&c_j;</trd>
  <trd lng="ca">bei</trd>
  <trdgrp lng="de">
    <trd fnt="AI: fr pl ca; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Bei</trd>,
    <trd fnt="AI: fr cs; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Bey</trd>
  </trdgrp>
  <trd lng="en" kod="HIS" fnt="AI: de fr ca; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">bey <klr>(historical)</klr></trd>
  <trd lng="fr">bey</trd>
  <trd lng="pl">bej</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: fr de dif; proponis gpt-5.6-luna; taksis Jev 89%">&#x8C9D;&#x4F0A;</trd>,
    <trd fnt="AI: fr de dif; proponis gpt-5.6-luna; taksis Jev 89%">&#x8D1D;&#x4F0A;</trd>
  </trdgrp>
  </snc>
  <trdgrp lng="cs">
    <trd>bej</trd>,
    <trd>bey</trd>
  </trdgrp>
  <trd lng="he">&#x5DE;&#x5D5;&#x5E9;&#x5DC; &#x5EA;&#x5D5;&#x5E8;&#x5DB;&#x5D9;</trd>
  <trd lng="sk">bej</trd>
  <trd lng="uk">&c_b;&c_je;&c_j;</trd>
</drv>
</art>

