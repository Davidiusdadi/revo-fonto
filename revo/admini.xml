<drv mrk="admini.0ado">
  <kap>
    <tld/>ado
  </kap>
  <snc mrk="admini.0ado.ago">
    <dif>
      La ago <tld/>i:
      <ekz>
        ekscii pli detale pri <tld/>ado de la projekto
        <fnt>
          <bib>Kon11</bib>
          <lok>En Benino komenci&gcirc;is afrika-e&ubreve;ropa kapabliga projekto</lok>
        </fnt>;
      </ekz>
      <ekz>
        estis diversaj problemoj en la lernejo, &ccirc;efe pro malbona <tld/>ado kaj tro
        strikta bu&gcirc;eto
        <fnt>
          <bib>Kon11</bib>
          <lok>Intervjuo</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x7BA1;&#x7406;&#x7684;&#x884C;&#x4E3A;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">The act of administering.</dif>
    <trd lng="de">Verwaltung <klr>(Handlung)</klr></trd>
    <trd lng="en">administration <klr>(action)</klr></trd>
  </snc>
  <snc mrk="admini.0ado.respondeco">
    <dif>
      La <ref tip="super" cel="respon.0eco.responso">respondeco</ref> pri la <tld/>a agado
      rilate iun aferon:
      <ekz>
        mia sinjoro deprenas de mi la <tld/>adon
        <fnt>
          <bib>NT</bib>
          <lok>Luko 16:3</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiu letero venos al vi, <klr>[&#x2026;]</klr> sub kies <tld/>ado trovi&gcirc;as la &ccirc;aroj kaj
        la &ccirc;evaloj
        <fnt>
          <bib>MT</bib>
          <lok>II. Re&gcirc;oj 10:2</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[jen]</klr> la kadukulejoj konfiditaj al mia <tld/>ado
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        la plej bona solvo <klr>[&#x2026;]</klr> estus instali la Muzeon sub &scirc;tata <tld/>ado
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Responsibility for administrative activity concerning a particular matter.</dif>
    <ref tip="vid" cel="regi.0o">regio</ref>
    <trdgrp lng="de">
      <trd>Verwaltung <klr>(Befugnis)</klr></trd>,
      <trd>Verwaltungshoheit</trd>
    </trdgrp>
    <trd lng="en" fnt="AI: de dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">charge</trd>
  </snc>
  <snc mrk="admini.0ado.procedaro">
    <dif>
      La tuta procedaro rilate la prizorgadon de iu institucio;
      <tld/>a <ref tip="super" cel="fak.0o.brancxo">fako</ref>:
      <ekz>
        la po&scirc;ta <tld/>ado
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi estas studento pri la fako komerco kaj <tld/>ado
        <fnt>
          <bib>Kon11</bib>
          <lok>Saluton, Nepalo! (Flama Floro)</lok>
        </fnt>;
      </ekz>
      <ekz>
        la oficiala latina <klr>[servis kiel]</klr> lingvo de la armeo, <tld/>ado kaj
        juro
        <fnt>
          <bib>EeP</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x4E0E;&#x7167;&#x7BA1;&#x67D0;&#x673A;&#x6784;&#x6709;&#x5173;&#x7684;&#x5168;&#x90E8;&#x7A0B;&#x5E8F;&#xFF1B;&#x884C;&#x653F;&#x90E8;&#x95E8;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">The entire set of procedures relating to the management of an institution; an administrative field.</dif>
    <trd lng="de">Verwaltung <klr>(Beh&ouml;rde)</klr></trd>
    <trd lng="en">administration <klr>(institution)</klr></trd>
  </snc>
<trdgrp lng="id">
  <trd><baz>kelola</baz>pengelolaan</trd>,
  <trd><baz>urus</baz>pengurusan</trd>,
  <trd>administrasi</trd>
</trdgrp>
<trdgrp lng="zh">
  <trd fnt="Vikt: ru; taksis Jev 82%">&#x7BA1;&#x7406; <pr>gu&#x01CE;nl&#x01D0;</pr></trd>,
  <trd fnt="Vikt: ru; taksis Jev 80%">&#x884C;&#x653F;&#x7BA1;&#x7406; <pr>x&iacute;ngzh&egrave;nggu&#x01CE;nl&#x01D0;</pr></trd>,
  <trd fnt="Vikt: en; taksis Jev 13%">&#x653F;&#x5E9C; <pr>zh&egrave;ngf&#x01D4;</pr></trd>
</trdgrp>
</drv>

