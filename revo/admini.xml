    <trd>&#x7D4C;&#x55B6;&#x8005;  <pr>&#x3051;&#x3044;&#x3048;&#x3044;&#x3057;&#x3083;</pr></trd>,
    <trd>&#x904B;&#x55B6;&#x8005;  <pr>&#x3046;&#x3093;&#x3048;&#x3044;&#x3057;&#x3083;</pr></trd>,
    <trd>&#x884C;&#x653F;&#x5B98;  <pr>&#x304E;&#x3087;&#x3046;&#x305B;&#x3044;&#x304B;&#x3093;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
