<drv mrk="admini.0a">
  <kap><tld/>a</kap>
  <snc mrk="admini.0a.rilata">
    <dif>
      Rilata al <tld/>ado:
      <ekz>
        mi estos eksigita el la <tld/>a ofico
        <fnt>
          <bib>NT</bib>
          <lok>&Luk; 16:4</lok>
        </fnt>;
      </ekz>
      <ekz>
        tedis la <tld/>aj demandoj kaj vizitoj
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro 23a</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> parolis kun aplombo de persono, kiu havas envidon en aferojn
        <tld/>ajn kaj politikajn
        <fnt>
          <bib>I&scirc;tar</bib>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a centro
        <fnt>
          <bib>&Ccirc;uk&ccirc;oj</bib>
          <lok>8. La plej amika kompleza&jcirc;o</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 86%">&#x4E0E;&#x7BA1;&#x7406;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
    <trdgrp lng="de">
      <trd fnt="Vikt: fr ku pl; juĝis claude-opus-5">Verwaltungs-</trd>,
      <trd fnt="Vikt: en ku pl; juĝis claude-opus-5">administrativ</trd>,
      <trd fnt="Vikt: fr ku ru; juĝis claude-opus-5">verwaltend</trd>
    </trdgrp>
    <trd lng="en" fnt="Vikt: en fr ku pl ru; juĝis claude-opus-5">administrative</trd>
    <trd lng="zh" fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 89%">&#x884C;&#x653F;&#x7684;</trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_d;&c_m;&c_ib;&c_n;&c_ib;&c_s;&c_t;&c_r;&c_a;&c_c;&c_y;&c_j;&c_n;&c_y;</trd>,
    <trd>&c_k;&c_ib;&c_r;&c_a;&c_w;&c_n;&c_ib;&c_ch;&c_y;</trd>
  </trdgrp>
  <trd lng="es">administrativo</trd>
  <trd lng="id">administratif</trd>
  <trdgrp lng="ja">
    <trd>&#x7BA1;&#x7406;&#x306E;  <pr>&#x304B;&#x3093;&#x308A;&#x306E;</pr></trd>,
    <trd>&#x7D4C;&#x55B6;&#x306E;  <pr>&#x3051;&#x3044;&#x3048;&#x3044;&#x306E;</pr></trd>,
    <trd>&#x904B;&#x55B6;&#x306E;  <pr>&#x3046;&#x3093;&#x3048;&#x3044;&#x306E;</pr></trd>,
    <trd>&#x884C;&#x653F;&#x306E;  <pr>&#x304E;&#x3087;&#x3046;&#x305B;&#x3044;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="pl">administracyjny</trd>
