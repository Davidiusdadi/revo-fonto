<drv mrk="admini.0anto">
  <kap>
    <tld/>anto
  </kap>
  <snc mrk="admini.0anto.POL">
    <dif>
      Iu, kiu <tld/>as:
      <ekz>
        <nom>Abraham</nom> diris al sia sklavo, la <tld/>anto de lia domo, kiu regis &ccirc;ion, kio
        apartenis al li <klr>[&#x2026;]</klr>
        <fnt>
          <bib>MT</bib>
          <lok>&Gen; 24:2</lok>
        </fnt>;
      </ekz>
      <ekz>
        la &ccirc;efo <klr>[&#x2026;]</klr> deziris, ke lia <tld/>anto havu same bonajn teoriajn
        konojn pri agrikulturo
        <fnt>
          <bib>HsT</bib>
        </fnt>;
      </ekz>
      <ekz>
        en la korto ili estis haltigitaj de l&#x2019; <tld/>anto
        <fnt>
          <bib>ChL</bib>
        </fnt>;
      </ekz>
      <ekz>
        kion mi faris, tion mi sendube iam legos en la &scirc;uldolibro de la &ccirc;ielo, sed kun
        &gcirc;iaj mizeraj <tld/>antoj <klr>(<ref cel="klerik.0o">kleriko</ref>j)</klr> mi volas perdi plu
        neniun vorton
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="sub">
      <ref cel="ekonom.0o">ekonomo</ref>,
      <ref cel="intend.0o">intendanto</ref>
    </refgrp>
    <refgrp tip="vid">
      <ref cel="gvid.afer0anto">afergvidanto</ref>,
      <ref cel="managx.0o">mana&gcirc;ero</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_a;&c_d;&c_m;&c_ib;&c_n;&c_ib;&c_s;&c_t;&c_r;&c_a;&c_t;&c_a;&c_r;</trd>
  <trd lng="de">Verwalter</trd>
  <trd lng="en">administrator</trd>
  <trd lng="es">administrador</trd>
  <trdgrp lng="id">
    <trd>admin</trd>,
    <trd>administrator</trd>,
    <trd><baz>kelola</baz>pengelola</trd>,
    <trd><baz>urus</baz>pengurus</trd>
