<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: albigens.xml,v 1.6 2026/01/24 18:47:19 revo Exp $">
<kap>
  <rad>albigens</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="albigens.0o">
  <kap><tld/>o</kap>
  <snc mrk="albigens.0o.REL">
    <dif>
      Ano de
      <ref tip="vid" cel="albigens.0ismo.REL"><tld/>ismo</ref>:
      <ekz>
        la herezaj <tld lit="A"/>oj <klr>...</klr> plenigis per
        malsanigaj eraroj la sudajn regionojn de Francio kaj aliajn
        regionojn de la latina mondo
        <fnt>
          <aut>Leono la 13a, trad. -</aut>,
          <vrk><url ref="http://www.ikue.org/papoj/leonoxiii/encrozario.htm">
          Supera Apostolado</url></vrk>,
          <lok>[2006?]</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x963F;&#x5C14;&#x6BD4;&#x6D3E;&#x4E3B;&#x4E49;&#x7684;&#x4FE1;&#x5F92;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Adherent of Albigensianism.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Anh&auml;nger der albigensischen Lehre.</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: fr en; proponis gpt-5.6-luna; taksis Jev 90%">&#x963F;&#x723E;&#x6BD4;&#x6D3E;&#x6559;&#x5F92; <pr>&#x0100;'&ecaron;rb&#x01D0;p&agrave;i ji&agrave;ot&uacute;</pr></trd>,
      <trd fnt="AI: fr en; proponis gpt-5.6-luna; taksis Jev 90%">&#x963F;&#x5C14;&#x6BD4;&#x6D3E;&#x6559;&#x5F92; <pr>&#x0100;'&ecaron;rb&#x01D0;p&agrave;i ji&agrave;ot&uacute;</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_mol;&c_b;&c_ib;&c_g;&c_o;&c_je;&c_c;</trd>
  <trdgrp lng="de">
    <trd fnt="AI: fr pl uk be; proponis claude-opus-5-5; kontrolis claude-opus-5-5; serĉo">Albigenser</trd>,
    <trd fnt="AI: fr pl; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Katharer</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd fnt="AI: fr pl id uk be; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Albigensian</trd>,
    <trd fnt="AI: fr pl id; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Cathar</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>Albigeois<klr> (Cathare, subst.)</klr></trd>,
    <trd>Cathare<klr> (subst.)</klr></trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>kaum Katari</trd>,
    <trd>kaum Albigens</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>Katar</trd>,
    <trd>Albigens</trd>
  </trdgrp>
  <trd lng="uk">&c_a;&#x43B;&#x44C;&c_b;&c_ib;&c_gu;&#x43E;&c_jeu;&c_c;&#x44C;</trd>
</drv>

<drv mrk="albigens.0ismo">
  <kap><tld/>ismo</kap>
  <snc mrk="albigens.0ismo.REL">
    <uzo tip="fak">HIS</uzo>
    <uzo tip="fak">REL</uzo>
    <dif>
      Doktrino kaj praktiko de
      <ref tip="vid" cel="albigens.0o.REL"><tld/>oj</ref>,
      religia grupo prosperinta en la 12a kaj 13a jarcentoj
      en la sudokcidenta parto de nuna Francujo,
      rigardata kiel herezo de kristanismo kaj
      perforte ekstermita:
      <ekz>
        <tld lit="A"/>ismo instruis, ke estas du dioj: unu bona dio,
        kiu kreis la spiritan mondon, kaj unu malbona dio, kiu kreis la
        materian mondon
        <fnt>
          <bib>Viki</bib>,
          <lok><url ref="&Viki;/Albigensismo">
          Albigensismo</url>, 2010-11-29</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x963F;&#x5C14;&#x6BD4;&#x6D3E;&#x7684;&#x6559;&#x4E49;&#x548C;&#x5B9E;&#x8DF5;&#xFF1B;&#x8FD9;&#x662F;&#x4E00;&#x4E2A;&#x5728;&#x73B0;&#x4ECA;&#x6CD5;&#x56FD;&#x897F;&#x5357;&#x90E8;&#x4E8E;12&#x4E16;&#x7EAA;&#x548C;13&#x4E16;&#x7EAA;&#x5174;&#x76DB;&#x7684;&#x5B97;&#x6559;&#x56E2;&#x4F53;&#xFF0C;&#x88AB;&#x89C6;&#x4E3A;&#x57FA;&#x7763;&#x6559;&#x5F02;&#x7AEF;&#x5E76;&#x906D;&#x5230;&#x66B4;&#x529B;&#x6D88;&#x706D;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Doctrine and practice of the Albigensians, a religious group that flourished in the 12th and 13th centuries in the south-western part of present-day France, regarded as a heresy of Christianity and violently exterminated.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Lehre und Praxis der Albigenser, einer religi&ouml;sen Gruppe, die im 12. und 13. Jahrhundert im S&uuml;dwesten des heutigen Frankreich bl&uuml;hte, als H&auml;resie des Christentums angesehen und gewaltsam ausgerottet wurde.</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: fr en; proponis gpt-5.6-luna; taksis Jev 91%">&#x963F;&#x723E;&#x6BD4;&#x6D3E;&#x4E3B;&#x7FA9; <pr>&#x0100;'&ecaron;rb&#x01D0;p&agrave;i zh&#x01D4;y&igrave;</pr></trd>,
      <trd fnt="AI: fr en; proponis gpt-5.6-luna; taksis Jev 91%">&#x963F;&#x5C14;&#x6BD4;&#x6D3E;&#x4E3B;&#x4E49; <pr>&#x0100;'&ecaron;rb&#x01D0;p&agrave;i zh&#x01D4;y&igrave;</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_mol;&c_b;&c_ib;&c_g;&c_o;&c_j;&c_s;&c_t;&c_v;&c_a;</trd>
  <trd lng="de" fnt="AI: fr pl id; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Katharismus</trd>
  <trdgrp lng="en">
    <trd fnt="AI: fr pl id; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Catharism</trd>,
    <trd fnt="AI: id be; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Albigensianism</trd>
  </trdgrp>
  <trd lng="fr">Catharisme</trd>
  <trdgrp lng="id">
    <trd>katarisme</trd>,
    <trd>albigensis</trd>
  </trdgrp>
  <trd lng="pl">kataryzm</trd>
 </drv>
</art>

