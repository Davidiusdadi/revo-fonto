    <kap>
      <rad>Adan</rad>/o
    </kap>

<drv mrk="adan.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Granda <ref tip="lst" lst="voko:urboj" cel="urb.0o.ARKI">urbo</ref>
      en la sudo de <ref tip="malprt" cel="turk.T0ujo">Turkujo</ref>,
      &ccirc;. 200&#8239;km nordokcidente de <ref cel="halep.0o">Halepo</ref>
      kaj 260&#8239;km nordoriente de <ref cel="nikozi.0o">Nikozio</ref>:
      <ekz>
        la masakroj en <tld/>o 1909
        <fnt>
          <bib>Viki</bib>
          <vrk><url ref="&Viki;/Armena_genocido">Armena genocido</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la alia amiko <klr>[estis]</klr> 20-jara&gcirc;a turka manlaboristo el <tld/>o
        <fnt>
          <aut>Behzad Yaghmaian</aut>
          <vrk><url ref="&Mondediplo;article779.html">Persono kiu ne koncernas, 1a majo
          2003</url></vrk>
          <lok>Le Monde diplomatique' en Esperanto</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x571F;&#x8033;&#x5176;&#x5357;&#x90E8;&#x7684;&#x4E00;&#x5EA7;&#x5927;&#x57CE;&#x5E02;&#xFF0C;&#x4F4D;&#x4E8E;&#x963F;&#x52D2;&#x9887;&#x897F;&#x5317;&#x7EA6;200&#x516C;&#x91CC;&#x3001;&#x5C3C;&#x79D1;&#x897F;&#x4E9A;&#x4E1C;&#x5317;260&#x516C;&#x91CC;&#x5904;&#x3002;</dif>
    <trd lng="be">&c_A;&c_d;&c_a;&c_n;&c_a;</trd>
    <trd lng="de">Adana</trd>
    <trd lng="en">Adana</trd>
    <trd lng="fr">Adana</trd>
    <trd lng="grc">&Alfa_ton;&delta;&alfa;&ny;&alfa;</trd>
    <trd lng="hy">&#1329;&#1380;&#1377;&#1398;&#1377;</trd>
    <trd lng="pl">Adana</trd>
    <trd lng="tr">Adana</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: de en tr ref dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x963F;&#x9054;&#x7D0D; <pr>&#x0100;d&aacute;n&agrave;</pr></trd>,
      <trd fnt="AI: de en tr ref dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x963F;&#x8FBE;&#x7EB3; <pr>&#x0100;d&aacute;n&agrave;</pr></trd>
    </trdgrp>
  </snc>
</drv>
