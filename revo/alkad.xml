<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: alkad.xml,v 1.8 2025/03/02 07:39:32 revo Exp $">
<kap>
  <rad>alkad</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="alkad.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">HIS</uzo>
  <uzo tip="fak">JUR</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="jugx.0isto">Ju&gcirc;isto</ref> kun
      urb-administraj funkcioj en malnovaj Hispanujo kaj hispanaj kolonioj:
      <ekz>
        la <tld/>o de <nom>Antequera</nom> <klr>[&#x2026;]</klr> arestas kaj
        en&scirc;losas lin
        <fnt><bib>DonKihxoto</bib> <lok>&ccirc;apitro 5a, p. 52a</lok></fnt>;
      </ekz>
      <ekz>
        la famo disvasti&gcirc;is, ke iu <tld/>o estis el&scirc;ipi&gcirc;onta, kaj ke oni persekutas la
        murdintojn
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro XIII</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 85%">&#x53E4;&#x4EE3;&#x897F;&#x73ED;&#x7259;&#x53CA;&#x897F;&#x73ED;&#x7259;&#x6B96;&#x6C11;&#x5730;&#x4E2D;&#x517C;&#x6709;&#x57CE;&#x5E02;&#x884C;&#x653F;&#x804C;&#x80FD;&#x7684;&#x6CD5;&#x5B98;&#x3002;</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: en de dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x963F;&#x723E;&#x5361;&#x723E;&#x5FB7;</trd>,
      <trd fnt="AI: en de dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x963F;&#x5C14;&#x5361;&#x5C14;&#x5FB7;</trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_l;&c_mol;&c_k;&c_a;&c_l;&c_mol;&c_d;</trd>,
    <trd>&c_a;&c_l;&c_mol;&c_k;&c_a;&c_j;&c_d;</trd>
  </trdgrp>
  <trd lng="de">Alkalde</trd>
  <trd lng="en">alcalde</trd>
  <trd lng="es">alcaide</trd>
  <trd lng="fr">alcade</trd>
  <trdgrp lng="hu">
    <trd>b&iacute;r&oacute;</trd>,
    <trd>el&ouml;lj&aacute;r&oacute;</trd>
  </trdgrp>
  <trd lng="pl">alkad</trd>
</drv>
</art>

