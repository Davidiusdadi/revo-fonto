<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: bigos.xml,v 1.4 2024/01/25 09:24:54 revo Exp $">
<kap>
    <rad>bigos</rad>/o
</kap>
<drv mrk="bigos.0o">
  <kap><tld/>o</kap>
  <snc mrk="bigos.0o.SNC">
    <uzo tip="fak">KUI</uzo>
    <dif>
      <ref tip="super" cel="ragu.0o">Raguo</ref>
      el viando kaj acida kaja&ubreve; fre&scirc;a brasiko:
      <ekz>
        Sed e&ccirc; sen tiaj spicoj bonegas aparte &#11005;
        <tld lit="B"/>o, &ccirc;ar el bonaj legomoj &gcirc;i arte &#11005;
        Kunmeti&gcirc;as: hakita brasiko acida, &#11005;
        Kiu la&ubreve; la proverbo, mem en bu&scirc;on iras &#11005;
        Fermite en kaldrono, per sino humida, &#11005;
        &Gcirc;i kovras elektitajn pecojn de viandoj, &#11005;
        Kaj varmi&gcirc;as, &gcirc;is fajro el &gcirc;i pleneltiras &#11005;
        Nutrajn sukojn kaj &scirc;prucas broga&jcirc;o el randoj, &#11005;
        Kaj aero &ccirc;irka&ubreve;e per aromo spiras
        <fnt><vrk>Sinjoro Tadeo</vrk>,
          <lok>Libro 4&#170;, vv. 832&ndash;840</lok></fnt>;
      </ekz>
      <ekz>
        <tld/>o estas <ctl>peza</ctl> por la stomako, sed bongusta
        <fnt><aut>Nina Pietuchowska</aut>:
          <vrk>La pola bigoso</vrk>.
          <bib>LOdE</bib>, <lok>272 (2017:6)</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x7528;&#x8089;&#x548C;&#x9178;&#x767D;&#x83DC;&#x6216;&#x65B0;&#x9C9C;&#x767D;&#x83DC;&#x7096;&#x6210;&#x7684;&#x83DC;&#x3002;</dif>
    <trd lng="de" fnt="Vikt: pl; juĝis claude-opus-5">Bigos</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 87%">&#x6BD4;&#x6208;&#x65AF;&#x71C9;&#x8089; <pr>b&#x01D0;g&#x0113;s&#x012B; d&ugrave;nr&ograve;u</pr></trd>,
      <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 87%">&#x6BD4;&#x6208;&#x65AF;&#x7096;&#x8089; <pr>b&#x01D0;g&#x0113;s&#x012B; d&ugrave;nr&ograve;u</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_b;&c_ib;&c_g;&c_a;&c_s;</trd>
  <trd lng="en">bigos</trd>
  <trd lng="fr">bigos</trd>
  <trd lng="pl">bigos</trd>
  <trd lng="ru">&c_b;&c_i;&c_g;&c_o;&c_s;</trd>
</drv>
</art>

