<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bobsled.xml,v 1.10 2022/05/23 06:42:30 revo Exp $">
<kap>
  <rad>bobsled</rad>/o
</kap>

<drv mrk="bobsled.0o">
  <kap><tld/>o</kap>
  <snc mrk="bobsled.0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Sport<ref tip="super" cel="sled.0o.glitveturilo">sledo</ref> por du
a&ubreve; 
      kvar veturantoj, tre rapide iranta sur anta&ubreve;preparita
glitvojo
      &ndash; la&ubreve;vorte &leftquot;skusledo&rightquot;:
      <ekz>
        tagoj pasigitaj sur la ne&gcirc;okampoj je skiado,
se&gcirc;glitado, 
        <tld/>ado
        <fnt>
          <aut>R. Frison-Roche, trad. R. Bernard</aut>,
          <vrk><url ref="http://donh.best.vwh.net/Esperanto/Literaturo/Revuoj/nlr/nlr34/negx
          ou.html">
          La ne&gcirc;o estas &gcirc;ojo!</url></vrk>,
          <lok>Nica Literatura Revuo, 1958-03 &gcirc;is 04, numero 3-4a,
p. 
          140a-142a</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 80%">&#x4F9B;&#x4E24;&#x540D;&#x6216;&#x56DB;&#x540D;&#x4E58;&#x5458;&#x4F7F;&#x7528;&#x7684;&#x8FD0;&#x52A8;&#x96EA;&#x6A47;&#xFF0C;&#x5728;&#x9884;&#x5148;&#x51C6;&#x5907;&#x597D;&#x7684;&#x6ED1;&#x9053;&#x4E0A;&#x9AD8;&#x901F;&#x884C;&#x9A76;&#xFF1B;&#x5B57;&#x9762;&#x610F;&#x601D;&#x662F;&rightquot;&#x6447;&#x52A8;&#x7684;&#x96EA;&#x6A47;&#x201D;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A sports sled for two or four people that travels very quickly on a specially prepared ice track&mdash;literally &#x2018;shaking sled&#x2019;.</dif>
    <rim mrk="bobsled.0o.RIM_SIN">
      Alia esperantigo:
      <em>Bobsleo</em> <fnt><bib>NeoGlo</bib></fnt>.
    </rim>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_b;&c_s;&c_l;&c_je;&c_j;</trd>
  <trd lng="bg">&c_b;&c_o;&c_b;&c_s;&c_l;&c_je;&c_j;</trd>
  <trdgrp lng="cs">
    <trd>bobsleigh</trd>,
    <trd>boby</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Bob</trd>,
    <trd>Bobschlitten</trd>
  </trdgrp>
  <trd lng="en" fnt="AI: de fr cs no; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">bobsleigh <klr>(British)</klr></trd>
  <trd lng="fr">bobsleigh</trd>
  <trd lng="he">&#x5DE;&#x5D6;&#x5D7;&#x5DC;&#x5EA;</trd>
  <trdgrp lng="it">
    <trd>bob</trd>,
    <trd>guidoslitta</trd>
  </trdgrp>
  <trd lng="nl">bobslee</trd>
  <trdgrp lng="no">
    <trd>bobsleigh</trd>,
    <trd>bobsled</trd>
  </trdgrp>
  <trd lng="pl">bobslej</trd>
  <trd lng="sk">boby</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 90%">&#x96EA;&#x8ECA;</trd>,
    <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 90%">&#x96EA;&#x8F66;</trd>
  </trdgrp>
</drv>
</art>

