<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: espres.xml,v 1.5 2025/12/08 08:00:21 afido Exp $">
<kap>
  <rad>espres</rad>/o <fnt><bib>SPIV</bib></fnt>
</kap>

<drv mrk="espres.0o">
  <kap><tld/>o</kap>
  <snc mrk="espres.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      <ref tip="super" cel="kaf.0o.KUI">Kafo</ref> pretigita per forta trapremo
      de varmega akvo tra subtila kafpulvoro:
      <ekz>
        <tld/>o estas konsiderata perfekta se la fajnporeca &scirc;a&ubreve;mo restas staranta dum du
        minutoj
        <fnt>
          <vrk><url
          ref="http://esperantaretradio.blogspot.com/2020/01/formulo-por-perfekta-espreso-kafo.html"
              >Formulo por perfekta Espreso-kafo</url></vrk>
          <lok>Esperanta Retradio, 25a jan. 2020</lok>
        </fnt>;
      </ekz>
      <ekz>
        kafo makulata <klr>[&#8230;]</klr> estas <tld/>o kun iom da lakto&scirc;a&ubreve;mo
        <fnt>
          <bib>Viki</bib>
          <vrk><url ref="https://eo.wikipedia.org/wiki/Kafo_makulata"
              >Kafo makulata</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Espresso</trd>
    <trd lng="en">espresso</trd>
    <trd lng="fr">espresso</trd>
    <trd lng="it">caff&egrave; espresso</trd>
    <trd lng="pl">kawa z ekspresu</trd>
    <trd lng="ru">&c_e;&c_s;&c_p;&c_r;&c_je;&c_s;&c_s;&c_o;</trd>
    <trdgrp lng="zh">
      <trd fnt="Vikt: zh en; taksis Jev 95%">&#x6FC3;&#x7E2E;&#x5496;&#x5561; <pr>n&oacute;ngsu&#x014D; k&#x0101;f&#x0113;i</pr></trd>,
      <trd fnt="Vikt: zh en; taksis Jev 95%">&#x6D53;&#x7F29;&#x5496;&#x5561; <pr>n&oacute;ngsu&#x014D; k&#x0101;f&#x0113;i</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 95%">&#x610F;&#x5F0F;&#x6FC3;&#x7E2E; <pr>Y&igrave;sh&igrave;n&oacute;ngsu&#x014D;</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 95%">&#x610F;&#x5F0F;&#x6D53;&#x7F29; <pr>Y&igrave;sh&igrave;n&oacute;ngsu&#x014D;</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 72%">&#x6FC3;&#x5496;&#x5561; <pr>n&oacute;ngk&#x0101;f&#x0113;i</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 72%">&#x6D53;&#x5496;&#x5561; <pr>n&oacute;ngk&#x0101;f&#x0113;i</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_e;&c_s;&c_p;&c_r;&c_e;&c_s;&c_a; <klr>(&c_k;&c_a;&c_v;&c_a;)</klr></trd>
  <trdgrp lng="ca">
    <trd>caf&egrave; expr&eacute;s</trd>,
    <trd>expr&eacute;s</trd>
  </trdgrp>
  <trd lng="es">caf&eacute; expreso</trd>
</drv>
</art>

