<drv mrk="boeci.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">PERS</uzo>
  <snc>
    <dif>
      Familia nomo de pluraj historiaj personoj, i.a. de <nom>Anicius Manlius Severinus
      Boethius</nom> (&ccirc;. 480 - 525),
      romia politikisto de la malfrua antikvo:
      <ekz>
        el &ccirc;iuj verkoj de Platono, en Latino ekzistis nur Timeo, tial <tld/>o, la lasta
        romiano, decidis traduki por siaj samlingvanoj la verkojn de Platono kaj
        Aristotelo
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 2 (52)</lok>
        </fnt>;
      </ekz>
      <ekz>
        filozofoj sinkretistoj <klr>[&#8230;]</klr> la vivon kaj &gcirc;iajn fenomenojn komentis per
        mallongaj, foje spritaj a&ubreve; e&ccirc; acidaj pensofulmoj (kiel ekz. Seneko, A&ubreve;relio,
        Boecio <klr>[&#8230;]</klr>)
        <fnt>
          <aut>Vinko O&scaron;lak</aut>
          <vrk><url ref="https://libro.ee/file.php?id=2086"
              >Foje e&ccirc; pensi estas &gcirc;uo</url></vrk>
          <lok>Enkonduko</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x51E0;&#x4E2A;&#x5386;&#x53F2;&#x4EBA;&#x7269;&#x7684;&#x59D3;&#x6C0F;&#xFF0C;&#x5C24;&#x5176;&#x6307;&#x963F;&#x5C3C;&#x57FA;&#x4E4C;&#x65AF;&middot;&#x66FC;&#x5229;&#x4E4C;&#x65AF;&middot;&#x585E;&#x7EF4;&#x91CC;&#x52AA;&#x65AF;&middot;&#x6CE2;&#x7231;&#x4FEE;&#x65AF;&#xFF08;&#x7EA6;480&mdash;525&#x5E74;&#xFF09;&#xFF0C;&#x53E4;&#x4EE3;&#x665A;&#x671F;&#x7684;&#x7F57;&#x9A6C;&#x653F;&#x6CBB;&#x5BB6;&#x3002;</dif>
    <trd lng="de">Boethius</trd>
    <trd lng="en">Boethius</trd>
    <trd lng="pl">Seweryn <ind>Boecjusz</ind></trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de pl; proponis gpt-5.6-luna; taksis Jev 90%">&#x6CE2;&#x611B;&#x4FEE;&#x65AF; <pr>B&#x014D;'&agrave;i s&#x012B;</pr></trd>,
