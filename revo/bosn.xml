<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bosn.xml,v 1.19 2026/07/03 14:00:23 revo Exp $">
<kap>
  <ofc>10</ofc>
  <rad>bosn</rad>/o
</kap>

<drv mrk="bosn.0o">
  <kap><ofc>10</ofc><tld/>o</kap>
  <snc mrk="bosn.0o.sxtatano">
    <dif>
      <ref tip="super" cel="sxtat.0ano">&Scirc;tatano</ref> de
      <ref tip="malprt" cel="bosn.B0ujo"><tld lit="B"/>ujo</ref>.
    </dif>
  </snc>
  <snc mrk="bosn.0o.naciano">
    <dif>
      Homo kun <tld/>a nacieco:
      <ekz>
        kantono <nom>Zenica-Doboj</nom> <klr>[&#8230;]</klr> lo&gcirc;antaro:
        <tld lit="B"/>oj 334 031 (83,6%)
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=4606">Kantono
          Zenica-Doboj</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        oni ne sukcesos nei la nemezureble pli ampleksajn perfortadojn
        kaj
        bu&ccirc;adojn faritajn de serboj kontra&ubreve; kroatoj, <tld/>oj kaj
        albanoj ol inverse
        <fnt>
	<aut>Uwe Joachim Moritz/Aldo de' Giorgi</aut>
	<vrk><url ref="&Monato;/2000/007043.php">Du opinioj</url></vrk>
	<bib>Monato</bib>
	<lok>2000/07, p. 4</lok>
        </fnt>;
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_s;&c_mol;&c_n;&c_ib;&c_je;&c_c;</trd>
  <trd lng="ca">bosni&agrave;</trd>
  <trd lng="de">Bosnier</trd>
  <trd lng="en">Bosnian</trd>
  <trd lng="fr">Bosniaque<klr> (subst.)</klr></trd>
  <trd lng="he">&bet;&vav;&samekh;&nun;&yod;&he;</trd>
  <trdgrp lng="io">
    <trd>Bosniano</trd>,
    <trd>Bosno</trd>
  </trdgrp>
  <trd lng="nl">Bosni&euml;r</trd>
  <trd lng="tok">jan pi ma Posan</trd>
  <trd lng="vo">Bosn&auml;nan</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: de fr; taksis Jev 94%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9E;&#x4EBA; <pr>b&#x014D;s&#x012B;n&iacute;y&agrave;r&eacute;n</pr></trd>,
    <trd fnt="Vikt: de fr; taksis Jev 94%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9A;&#x4EBA; <pr>b&#x014D;s&#x012B;n&iacute;y&agrave;r&eacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="bosn.0a">
  <kap><ofc>10</ofc><tld/>a</kap>
  <snc>
    <dif>
      Rilatanta al <tld/>oj, ilia nacieco a&ubreve; &scirc;tato:
      <ekz>
        en tiu regiono lo&gcirc;as pli<klr>[ ]</klr>multe <tld/>aj serboj,
        sed dum jarcentoj ili vivis kiel najbaroj de islamanoj kaj
        kroatoj
        kaj ili alkutimi&gcirc;is al diverseco kaj kuna vivo
        <fnt>
	<aut>Zlatko Ti&scaron;ljar</aut>
	<vrk><url ref="&Monato;/2000/006811.php">Nekredeblaj malveroj</url></vrk>
	<bib>Monato</bib>
	<lok>2000/03, p. 12-13</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x4E0E;&#x6CE2;&#x65AF;&#x5C3C;&#x4E9A;&#x4EBA;&#x3001;&#x5176;&#x6C11;&#x65CF;&#x6216;&#x56FD;&#x5BB6;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_s;&c_mol;&c_n;&c_ib;&c_j;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">bosni&agrave;</trd>
  <trd lng="de">bosnisch</trd>
  <trd lng="en">Bosnian</trd>
  <trd lng="fr">bosniaque<klr> (adj.)</klr></trd>
  <trd lng="he">&bet;&vav;&samekh;&nun;&yod;</trd>
  <trdgrp lng="io">
    <trd>Bosniana</trd>,
    <trd>Bosna</trd>
  </trdgrp>
  <trd lng="nl">Bosnisch</trd>
  <trd lng="tok">pi ma Posan</trd>
  <trd lng="vo">Bosn&auml;nik</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 93%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9E;&#x7684;</trd>,
    <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 93%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9A;&#x7684;</trd>
  </trdgrp>
</drv>

<drv mrk="bosn.0alingvo">
  <kap><tld/>a lingvo</kap>
  <snc>
    <dif>Oficiala lingvo de <ref tip="malprt" cel="bosn.B0ujoHercegovino.sxtato">Bosnujo kaj
    Hercegovino</ref>:
      <ekz>
        la slava lingvaro <klr>[&#8230;]</klr> dividi&gcirc;as je la orienta (rusa,
        ukraina,
        belorusa lingvoj), la okcidenta (pola, &ccirc;e&hcirc;a, slovaka, ka&scirc;uba,
        soraba
        lingvoj) kaj la suda (slovena, kroata, <tld/>a, montenegra,
        serba, makedona, bulgara lingvoj)
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=3842">Slava
          lingvaro</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 84%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9A;&#x548C;&#x9ED1;&#x585E;&#x54E5;&#x7EF4;&#x90A3;&#x7684;&#x5B98;&#x65B9;&#x8BED;&#x8A00;&#x3002;</dif>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_s;&c_mol;&c_n;&c_ib;&c_j;&c_s;&c_k;&c_a;&c_ja;
  &c_m;&c_o;&c_v;&c_a;</trd>
  <trd lng="ca">bosni&agrave;</trd>
  <trd lng="de">Bosnisch <klr>(Sprache)</klr></trd>
  <trd lng="en">Bosnian language</trd>
  <trd lng="hu">bosny&aacute;k nyelv</trd>
  <trdgrp lng="io">
    <trd>Bosniana linguo</trd>,
    <trd>Bosna linguo</trd>
  </trdgrp>
  <trd lng="nl">Bosnisch</trd>
  <trd lng="pl"><klr tip="amb">j&eogonek;zyk </klr>bo&sacute;niacki</trd>
  <trd lng="ru">&c_b;&c_o;&c_s;&c_n;&c_i;&c_j;&c_s;&c_k;&c_i;&c_j; &c_ja;&c_z;&c_y;&c_k;</trd>
  <trd lng="tok">toki Posan</trd>
  <trd lng="vo">Bosn&auml;nap&uuml;k</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 94%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9E;&#x8A9E;</trd>,
    <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 94%">&#x6CE2;&#x65AF;&#x5C3C;&#x4E9A;&#x8BED;</trd>
  </trdgrp>
</drv>

<drv mrk="bosn.B0ujo">
  <kap>
    <ofc>10</ofc><tld lit="B"/>ujo
    <fnt><bib>RLN</bib></fnt>
  </kap>
  <snc mrk="bosn.B0ujo.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <uzo tip="fak">POL</uzo>
    <dif>
      Lando en la suda <ref tip="malprt" cel="euxrop1.E0o.geog">E&ubreve;ropo</ref>
      nuntempe parto de la teritorio de <ref tip="malprt" cel="bosn.B0ujoHercegovino.sxtato">Bosnujo
      kaj Hercegovino</ref>.
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A region in southern Europe that now forms part of Bosnia and Herzegovina.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Land in S&uuml;deuropa, heute Teil des Gebiets von Bosnien und Herzegowina.</dif>
    <ref tip="sin" cel="bosni.B0o.GEOG">Bosnio</ref>
    <ref tip="vid" cel="hercegov.H0o.GEOG">Hercegovino</ref>
    <trd lng="zh">&#27874;&#26031;&#23612;&#20126;&#21312; <pr>b&#333;s&#299;n&iacute;y&agrave;q&#363;</pr></trd>
</snc>
  <trd lng="be">&c_B;&c_o;&c_s;&c_mol;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="bg">&c_B;&c_o;&c_s;&c_n;&c_a;</trd>
  <trd lng="ca">B&ograve;snia</trd>
  <trd lng="de">Bosnien</trd>
  <trd lng="en">Bosnia</trd>
  <trd lng="fr">Bosnie</trd>
  <trd lng="fy">Bosnje</trd>
  <trd lng="id">Bosnia</trd>
  <trd lng="io">Bosnia</trd>
  <trd lng="nl">Bosni&euml;</trd>
  <trdgrp lng="pl">
    <trd>Bo&sacute;nia</trd>
  </trdgrp>
  <trd lng="pt">B&oacute;snia</trd>
  <trd lng="tok">ma Posan</trd>
  <trd lng="vo">Bosn&auml;n</trd>
</drv>

<drv mrk="bosn.B0ujoHercegovino">
  <kap>
    <ofc>10</ofc><tld lit="B"/>ujo kaj Hercegovino
    <fnt><bib>RLN</bib></fnt>
  </kap>
  <mlg kod="ISO-3166">BA</mlg>
  <snc mrk="bosn.B0ujoHercegovino.sxtato">
    <uzo tip="fak">GEOG</uzo>
    <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="lst" lst="voko:&scirc;tatoj" cel="sxtat.0o">&Scirc;tato</ref>
      en la suda <ref tip="malprt" cel="euxrop1.E0o.geog">E&ubreve;ropo</ref>
      kun &ccirc;efurbo Sarajevo; teritorio de Federacio Bosnujo kaj
      Hercegovino
      kaj Respubliko Serbujo;
      iam parto de <ref tip="malprt" cel="jugoslav.J0ujo.GEOG">Jugoslavujo</ref>.
      &Gcirc;i limas kun
      <ref tip="vid" cel="kroat.K0ujo.GEOG">Kroatujo</ref>,
      <ref tip="vid" cel="monteneg.M0o.GEOG">Montenegro</ref>,
      <ref tip="vid" cel="serb.S0ujo.GEOG">Serbujo</ref>
      kaj Adriatiko:
      <ekz>
        la plej granda mezurita ordinara piceo, kiu altas 63 m, trovi&gcirc;as
        en Praarbaro <nom>Perucika</nom>, Nacia Parko
        <nom>Sutjeska</nom>, <tld lit="B"/>ujo kaj Hercegovino
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=337773">Ordinara
          piceo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A country in southern Europe with Sarajevo as its capital, comprising the Federation of Bosnia and Herzegovina and Republika Srpska; formerly part of Yugoslavia. It borders Croatia, Montenegro, Serbia and the Adriatic Sea.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Staat in S&uuml;deuropa mit der Hauptstadt Sarajevo; Gebiet der F&ouml;deration Bosnien und Herzegowina und der Republika Srpska; einst Teil Jugoslawiens. Er grenzt an Kroatien, Montenegro, Serbien und die Adria.</dif>
    <ref tip="sin" cel="bosni.B0oHercegovino.sxtato">Bosnio kaj
      Hercegovino</ref>
    <trdgrp lng="zh">
    <trd>&#27874;&#26031;&#23612;&#20122;&#21644;&#40657;&#22622;&#21733;&#32500;&#37027; <pr>b&#333;s&#299;n&iacute;y&agrave;h&egrave;h&#275;is&#257;ig&#275;w&eacute;in&agrave;</pr></trd>,
    <trd>&#27874;&#40657; <pr>b&#333;h&#275;i</pr></trd>
  </trdgrp>
</snc>
  <trd lng="be">&c_B;&c_o;&c_s;&c_mol;&c_n;&c_ib;&c_ja; &c_ib;
  &c_G;&c_je;&c_r;&c_c;&c_a;&c_g;&c_a;&c_v;&c_ib;&c_n;&c_a;</trd>
  <trd lng="bg">&c_B;&c_o;&c_s;&c_n;&c_a; &c_i;
  &c_H;&c_je;&c_r;&c_c;&c_je;&c_g;&c_o;&c_v;&c_i;&c_n;&c_a;</trd>
  <trd lng="ca">B&ograve;snia i Hercegovina</trd>
  <trd lng="de">Bosnien und Herzegowina</trd>
  <trd lng="en">Bosnia and Herzegovina</trd>
  <trd lng="fr">Bosnie-Herz&eacute;govine</trd>
  <trd lng="fy">Bosnje-Hertsegovina</trd>
  <trd lng="id">Bosnia Herzegovina</trd>
  <trd lng="io">Bosnia e Herzegovina</trd>
  <trd lng="nl">Bosni&euml; en Herzegovina</trd>
  <trd lng="pl">Bo&sacute;nia i Hercogowina</trd>
  <trd lng="vo">Bosn&auml;n e H&auml;rzegov&auml;n</trd>
</drv>

</art>

