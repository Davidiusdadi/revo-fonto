<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bori.xml,v 1.21 2025/12/31 18:43:51 revo Exp $">
<kap>
  <rad>bori</rad>/o
</kap>
<drv mrk="bori.0o">
  <kap><tld/>o</kap>
  <mlg kod="IUPAC">Bh</mlg>
  <snc>
  <uzo tip="fak">KEM</uzo>
    <dif>
      &Hcirc;emia <ref tip="lst" cel="elemen.0o.KEM" lst="voko:&hcirc;emiaj_elementoj" val="107">elemento</ref>
      kun
      atomnumero 107, atompezo 262,1229, nomita la&ubreve; la dana
      fizikisto <nom>Niels Bohr</nom>; <ref tip="super" cel="urani.trans0o">transuranio</ref>, kies
      &ccirc;iuj <ref tip="super" cel="izotop.0o">izotopoj</ref>
      estas radioaktivaj:
      <ekz>
        transirmetaloj estas: <klr>[&#x2026;]</klr> ruterfordio, dubnio, seborgio, <tld/>o, hasio
        <klr>[&#x2026;]</klr>
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=4279">Transirmetalo</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Niels Bohr</nom> <klr>[&#x2026;]</klr> <tld/>o, la kemia elemento, nomi&gcirc;as tiel en lia honoro
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=17316">Niels Bohr</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 86%">&#x539F;&#x5B50;&#x5E8F;&#x6570;&#x4E3A;107&#x3001;&#x539F;&#x5B50;&#x91CF;&#x4E3A;262.1229&#x7684;&#x5316;&#x5B66;&#x5143;&#x7D20;&#xFF0C;&#x4EE5;&#x4E39;&#x9EA6;&#x7269;&#x7406;&#x5B66;&#x5BB6;&#x5C3C;&#x5C14;&#x65AF;&middot;&#x73BB;&#x5C14;&#x547D;&#x540D;&#xFF1B;&#x4E00;&#x79CD;&#x8D85;&#x94C0;&#x5143;&#x7D20;&#xFF0C;&#x5176;&#x6240;&#x6709;&#x540C;&#x4F4D;&#x7D20;&#x90FD;&#x5177;&#x6709;&#x653E;&#x5C04;&#x6027;&#x3002;</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Chemisches Element mit der Ordnungszahl 107 und der Atommasse 262,1229, benannt nach dem d&auml;nischen Physiker Niels Bohr; ein Transuran, dessen Isotope alle radioaktiv sind.</dif>
    <rim>
      <nom>IUPAC</nom> en 1997 jaro findecidis pri la nomo borio,
      anta&ubreve;e estis uzata provizore la nomo unnilseptio
      <klr>(science <nac>Unnilseptium</nac>)</klr>.
    </rim>
  <trd lng="en">Bohrium</trd>
  <trd lng="zh" fnt="AI: en de fr; proponis gpt-5.6-luna; taksis Jev 93%">&#x2CB5B; <pr>b&#x014D;</pr></trd>
  </snc>
  <trd lng="be">&c_b;&c_o;&c_r;&c_y;&c_j;</trd>
  <trd lng="bg">&c_b;&c_o;&c_r;&c_i;&c_j;</trd>
  <trd lng="cs">b&oacute;r</trd>
  <trd lng="de">Bohrium</trd>
  <trd lng="fa">&a_b;&a_w;&a_r;&f_y;&a_m;</trd>
  <trd lng="fr">bohrium</trd>
  <trd lng="hu">bohrium</trd>
  <trd lng="id">bohrium</trd>
  <trd lng="la">Bohrium</trd>
  <trd lng="nl">bohrium</trd>
  <trd lng="pl">bohr</trd>
  <trd lng="ru">&c_b;&c_o;&c_r;&c_i;&c_j;</trd>
  <trdgrp lng="sk">
    <trd>b&oacute;rium</trd>,
    <trd>b&oacute;rium</trd>
  </trdgrp>
  <trd lng="sv">bohrium</trd>
  <trd lng="uk">&c_b;&c_o;&c_r;&c_ib;&c_j;</trd>
</drv>
</art>
