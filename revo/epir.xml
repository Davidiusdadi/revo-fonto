<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: epir.xml,v 1.3 2025/03/12 22:29:45 afido Exp $">
    <kap>
      <rad>Epir</rad>/o, <var><kap><rad var="os">Epiros</rad>/o</kap></var>
    </kap>

<drv mrk="epir.0o">
  <kap><tld/>o, <var><kap><tld var="os"/>o</kap></var></kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">HIS</uzo>
  <snc>
    <dif>
      Balkana <ref tip="lst" lst="voko:regionoj" cel="region.0o.land">regiono</ref> kontra&ubreve; la
      insulo Korfuo:
      <ekz>
        oni venigadis <klr>[&#8230;]</klr> hundojn-molosojn el <tld/>o
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro LII</lok>
        </fnt>;
      </ekz>
      <ekz>
        Akarnanio kaj Fokis insultis lin esti kaoniano kaj moloso el <tld var="os"/>o
        <fnt>
          <bib>VRA</bib>
          <lok>Eyvind Johnson</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o ne kongruis e&ccirc; nur pli-malpli kun la nuna Albanio, sed inkluzivis nur
        ties ekstreman sudon
        <fnt>
          <bib>Monato</bib>
          <aut>Guido Van Damme</aut>
          <vrk>Na&ubreve; kontra&ubreve;batoj</vrk>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[de]</klr> senlaboreco <klr>[&#8230;]</klr> plej trafitaj regionoj estas
        Makedonio, Trakio, <tld/>o kaj Tesalio
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk>Mil senlaboruloj tage</vrk>
          <lok>2012</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Epirus</trd>
    <trd lng="en">Epirus</trd>
    <trd lng="fr">&Eacute;pire</trd>
    <trd lng="pl">Epir</trd>
    <trd lng="ru">&c_E;&c_p;&c_i;&c_r;</trd>
    <trdgrp lng="zh">
      <trd fnt="Vikt: zh en; taksis Jev 94%">&#x4F0A;&#x5E87;&#x9B6F;&#x65AF; <pr>Y&#x012B;b&igrave;l&#x01D4;s&#x012B;</pr></trd>,
      <trd fnt="Vikt: zh en; taksis Jev 94%">&#x4F0A;&#x5E87;&#x9C81;&#x65AF; <pr>Y&#x012B;b&igrave;l&#x01D4;s&#x012B;</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 87%">&#x4F0A;&#x5E87;&#x9B6F;&#x65AF;&#x5927;&#x5340; <pr>Y&#x012B;b&igrave;l&#x01D4;s&#x012B;d&agrave;q&#x016B;</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 87%">&#x4F0A;&#x5E87;&#x9C81;&#x65AF;&#x5927;&#x533A; <pr>Y&#x012B;b&igrave;l&#x01D4;s&#x012B;d&agrave;q&#x016B;</pr></trd>,
      <trd fnt="Vikt: el; taksis Jev 93%">&#x4F0A;&#x76AE;&#x9C81;&#x65AF; <pr>y&#x012B;p&iacute;l&#x016B;s&#x012B;</pr></trd>
    </trdgrp>
  </snc>
<trd lng="be">&c_E;&c_p;&c_ib;&c_r;</trd>
</drv>
  </art>

