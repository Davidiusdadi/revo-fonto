<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: vulkanolog.xml,v 1.3 2026/08/19 14:51:36 afido Exp $">
<kap>
    <rad>vulkanolog</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="vulkanolog.0o">
  <kap><tld/>o</kap>
  <snc mrk="vulkanolog.0o.GEOL">
    <uzo tip="fak">GEOL</uzo>
    <dif>
      Fakulo pri <ref tip="vid" cel="vulkanologi.0o.GEOL">vulkanologio</ref>, pri <ref tip="vid"
      cel="vulkan.0o">vulkanoj</ref>:
      <ekz>
        la <tld/>oj povas anta&ubreve;vidi la momenton, kiam la vulkano ekaktivas
        <fnt>
        <aut>A. Vandewiele, trad. J. L. Jacobsen</aut>
        <vrk><url ref="https://verkoj.com/dn/Scienco/La_bildlibro_de_la_tero.pdf">
        La bildlibro de la tero</url></vrk>
        <lok>[vidita en 2026]</lok>
        </fnt>;
      </ekz>
      <ekz>
        italaj <tld/>oj proponis teorion, la&ubreve; kiu la lo&gcirc;antoj de Pompejo mortis ne pro malrapida
        sufoko,
        sed pro forta ondo de ardaj vulkangasoj
        <fnt>
          <aut>O. &Scirc;ilajeva</aut>
          <vrk>Fajra bato de Vezuvio</vrk>
          <lok>Kontakto, 2011-2019</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de" fnt="Vikt: en ko zh; juĝis claude-opus-5">Vulkanologe</trd>
    <trdgrp lng="en">
      <trd fnt="Vikt: fr ko ru zh; juĝis claude-opus-5">vulcanologist</trd>,
      <trd fnt="Vikt: en ko zh; juĝis claude-opus-5">volcanologist</trd>
    </trdgrp>
  </snc>
  <trd lng="fr">volcanologue</trd>
<trdgrp lng="id">
  <trd>ahli vulkanologi</trd>,
  <trd>ahli gunung berapi</trd>
</trdgrp>
<trdgrp lng="zh">
  <trd fnt="Vikt: zh en fr ko ru; taksis Jev 96%">&#x706B;&#x5C71;&#x5B78;&#x5BB6; <pr>hu&#x01D2;sh&#x0101;nxu&eacute;ji&#x0101;</pr></trd>,
  <trd fnt="Vikt: zh en fr ko ru; taksis Jev 96%">&#x706B;&#x5C71;&#x5B66;&#x5BB6; <pr>hu&#x01D2;sh&#x0101;nxu&eacute;ji&#x0101;</pr></trd>
</trdgrp>
</drv>
</art>

