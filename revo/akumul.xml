<drv mrk="akumul.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="akumul.0i.KOMUNE">
    <dif>
      <ref tip="super" cel="kolekt.0i">Kolekti</ref>,
      <ref tip="vid" cel="amas.0igi">amasigi</ref>
      provizon da io:
      <ekz>
        <tld/>i kapitalon, pruvojn;
      </ekz>
      <ekz>
        <tld/>i varmenergion
        <fnt>
          <bib>CKv</bib>
          <lok>19</lok>
        </fnt>;
      </ekz>
      <ekz>
        la tuta mondo <tld/>is
        kolosan neel&ccirc;erpeblan sperton pri sano
        <fnt>
          <aut>A. Gon&ccirc;arov</aut>,
          <vrk>Via sano en viaj manoj</vrk>,
          <bib>Monato</bib>
        </fnt>;
      </ekz>
      <ekz>
        liberi&gcirc;i de la koleron kaj de la stre&ccirc;o <tld/>itaj
        <fnt>
          <bib>Kon11</bib>
          <lok>Dek konsiloj por ne perdi la paciencon. (Manuela Ronco)</lok>
        </fnt>;
      </ekz>
      <ekz>
        la cerbo havas limigitan kapablon <tld/>i informojn
        <fnt>
          <bib>Kon11</bib>
          <lok>Redakcie</lok>
        </fnt>;
      </ekz>
      <ekz>
        por financi sian dol&ccirc;an neniofaradon, li prenis kreditojn kaj fine <tld/>is
        &scirc;uldojn de plurmil e&ubreve;roj
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2008/009448.php"
              >Krimaj ri&ccirc;uloj</url></vrk>
          <lok>2008</lok>
        </fnt>;
      </ekz>
      <ekz>
        Moskvo estis redonanta la ardon <tld/>itan en la asfalto
        dum la tago, kaj estis evidenta, ke la nokto ne alportos
        facili&gcirc;on
        <fnt><bib>MkM</bib>, <lok>&ccirc;ap. 5a</lok></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>anh&auml;ufen</trd>,
      <trd>sammeln</trd>,
      <trd>horten</trd>,
      <trd>raffen</trd>,
      <trd>zusammenraffen</trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd>hoard</trd>,
      <trd>accumulate</trd>
    </trdgrp>
    <trd lng="sk">hromadi&tcaron;</trd>
    <trdgrp lng="zh">
      <trd>&#20648;&#29289; <pr>ch&#468;w&ugrave;</pr></trd>,
      <trd>&#20786;&#29289; <pr>ch&#468;w&ugrave;</pr></trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_n;&c_a;&c_z;&c_a;&c_p;&c_a;&c_sh;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_z;&c_mol;&c_b;&c_ib;&c_r;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_a;&c_k;&c_u;&c_m;&c_u;&c_l;&c_ja;&c_v;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="ca">acumular</trd>
  <trdgrp lng="cs">
    <trd>akumulovat  hromadit</trd>,
    <trd>kupit</trd>
  </trdgrp>
  <trd lng="es">acumular</trd>
  <trdgrp lng="fr">
    <trd>accumuler</trd>,
    <trd>amasser</trd>
  </trdgrp>
  <trd lng="he">&lamed;&#1460;&tsadi;&#1456;&bet;&#1468;&vav;&#1465;&resh;</trd>
  <trdgrp lng="hu">
    <trd>felhalmoz</trd>,
    <trd>akkumul&aacute;l</trd>
  </trdgrp>
  <trd lng="ja">&#33988;&#31309;&#12377;&#12427;  <pr>&#12385;&#12367;&#12379;&#12365;&#12377;&#12427;</pr></trd>
  <trd lng="nl">accumuleren</trd>
  <trd lng="pt">acumular</trd>
  <trdgrp lng="ru">
    <trd>&c_k;&c_o;&c_p;&c_i;&c_t;&c_mol;</trd>,
    <trd>&c_n;&c_a;&c_k;&c_o;&c_p;&c_l;&c_ja;&c_t;&c_mol;</trd>,
    <trd>&c_a;&c_k;&c_k;&c_u;&c_m;&c_u;&c_l;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_n;&c_a;&c_g;&c_r;&c_o;&c_m;&c_a;&c_d;&c_zh;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_z;&c_b;&c_i;&c_r;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_n;&c_a;&c_k;&c_o;&c_p;&c_i;&c_ch;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_a;&c_k;&c_u;&c_m;&c_u;&c_l;&c_ju;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
</drv>

