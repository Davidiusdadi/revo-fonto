  <trd lng="he">&lamed;&tsadi;&bet;&vav;&resh;</trd>
  <trdgrp lng="ja">
    <trd>&#12383;&#12414;&#12427;</trd>,
    <trd>&#38598;&#12414;&#12427;  <pr>&#12354;&#12388;&#12414;&#12427;</pr></trd>,
    <trd>&#33988;&#31309;&#12377;&#12427;  <pr>&#12385;&#12367;&#12379;&#12365;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="Vikt: pt; taksis Jev 27%">&#x589E;&#x9577; <pr>z&#x0113;ngzh&#x01CE;ng</pr></trd>,
