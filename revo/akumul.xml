<drv mrk="akumul.0ilo">
  <kap><tld/>ilo</kap>
  <snc mrk="akumul.0ilo.ELE">
    <uzo tip="fak">ELE</uzo>
    <dif>
      <ref tip="dif" cel="akumul1.0o">Akumulatoro</ref>:
      <ekz>
        la unuo enhavas &ccirc;ion: la programaron, la antenon, <tld/>ilon kaj malgrandan
        ekranon kaj parolilon, per kiu <nom>TomTom Go</nom> komuniki&gcirc;as kun la &scirc;oforo
        <fnt>
          <bib>Monato</bib>
          <aut>Paul Peeraerts</aut>
          <vrk><url ref="&Monato;/2004/008419.html"
              >Birada sistemo helpas pli kaj pli da &scirc;oforoj</url></vrk>
          <lok>2004</lok>
        </fnt>;
      </ekz>
      <ekz>
        vindozuloj pli ofte re&scirc;argas sian operaciumon ol mi la <tld/>ilojn de mia Mako
        <fnt>
          <bib>LOdE</bib>
          <lok>2002, &#8470; 10</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Akkumulator <klr>(Elektr.)</klr></trd>
