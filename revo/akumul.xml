<drv mrk="akumul.0igxi">
  <kap><tld/>i&gcirc;i</kap>
  <snc mrk="akumul.0igxi.KOMUNE">
    <dif>
      <ref tip="super" cel="amas.0igxi">Amasi&gcirc;i</ref> la&ubreve;tempe en &ccirc;iam pli granda kvanto:
      <ekz>
        seni&gcirc;i de <tld/>i&gcirc;inta kolero
        <fnt>
          <bib>FSI</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi devas verki ion, <tld/>i&gcirc;is tro da nediritaj vortoj, tro da neesprimitaj sentoj
        <fnt>
          <bib>FSI</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>i&gcirc;o de <klr>[&#8230;]</klr> aferoj
        <fnt>
          <bib>VaK</bib>
          <lok>Kvina &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiu gaso povas <tld/>i&gcirc;i ene de la metroa tunelo, kie betono abundas kaj aero
        malbone cirkulas
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>!
      </ekz>
      <ekz>
        dum miaj 28 jaroj jam <tld/>i&gcirc;is en mi tiel
        multege da ombroj
        <fnt>
          <aut>Ba Jin, trad. Li Shijun</aut>,
          <vrk>A&ubreve;tuno en la Printempo</vrk>,
          <lok>1980</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 90%">&#x968F;&#x7740;&#x65F6;&#x95F4;&#x63A8;&#x79FB;&#x4EE5;&#x8D8A;&#x6765;&#x8D8A;&#x5927;&#x7684;&#x6570;&#x91CF;&#x805A;&#x96C6;&#x8D77;&#x6765;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Pile up over time in ever greater quantity.</dif>
  <trdgrp lng="de">
    <trd>sich <ind>anh&auml;ufen</ind></trd>,
    <trd>sich <ind>ansammeln</ind></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="AI: de en dif; proponis gpt-5.6-luna; taksis Jev 91%">&#x7A4D;&#x805A; <pr>j&#x012B;j&ugrave;</pr></trd>,
    <trd fnt="AI: de en dif; proponis gpt-5.6-luna; taksis Jev 91%">&#x79EF;&#x805A; <pr>j&#x012B;j&ugrave;</pr></trd>
  </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_n;&c_a;&c_z;&c_a;&c_p;&c_a;&c_sh;&c_v;&c_a;&c_c;&c_c;&c_a;</trd>,
    <trd>&c_z;&c_mol;&c_b;&c_ib;&c_r;&c_a;&c_c;&c_c;&c_a;</trd>,
    <trd>&c_a;&c_k;&c_u;&c_m;&c_u;&c_l;&c_ja;&c_v;&c_a;&c_c;&c_c;&c_a;</trd>,
    <trd>&c_s;&c_k;&c_u;&c_p;&c_ch;&c_a;&c_c;&c_c;&c_a;</trd>
  </trdgrp>
  <trd lng="ca">acumular-se</trd>
  <trdgrp lng="en">
