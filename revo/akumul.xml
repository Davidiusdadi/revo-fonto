<drv mrk="akumul.0igxa">
  <kap><tld/>i&gcirc;a</kap>
  <uzo tip="fak">MAT</uzo>
  <snc mrk="akumul.0igxa.punkto">
    <fnt><bib>PIV2</bib><lok>diskreta</lok></fnt>
    <dif>
      <klr>(p.p. <ref cel="punkt.0o.spaco">punkto</ref>
      <frm><k>x</k></frm> en
      <ref cel="spac.topologia0o">topologia spaco</ref>, rilate al
      subaro <frm><g>A</g></frm>)</klr>
      Tia, ke &ccirc;iu
      <ref cel="cxirka.0ajxo.topologio">&ccirc;irka&ubreve;a&jcirc;o</ref>
      de <frm><k>x</k></frm> enhavas punkton de <frm><g>A</g></frm>,
      alian ol <frm><k>x</k></frm>.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 93%">&#xFF08;&#x5BF9;&#x4E8E;&#x62D3;&#x6251;&#x7A7A;&#x95F4;&#x4E2D;&#x76F8;&#x5BF9;&#x4E8E;&#x5B50;&#x96C6; A &#x7684;&#x70B9; x&#xFF09;&#x8FD9;&#x6837;&#x7684;&#x70B9;&#xFF1A;x &#x7684;&#x6BCF;&#x4E2A;&#x90BB;&#x57DF;&#x90FD;&#x5305;&#x542B; A &#x4E2D;&#x5F02;&#x4E8E; x &#x7684;&#x4E00;&#x4E2A;&#x70B9;&#x3002;</dif>
    <ref tip="ant" cel="izol.0ita.punkto">izolita.</ref>
    <ref tip="vid" cel="adher.0a.punkto">adhera.</ref>
    <rim>
      &Ccirc;i-sence troveblas <ctl><tld/>punkto</ctl> en
      <fnt><bib>EKV</bib><lok>&para;9</lok></fnt>,
      sed adjektiva formo estas utila kaj &gcirc;i pli nature devenas
      de <ctl><tld/>i&gcirc;o</ctl> ol de <ctl><tld/>o</ctl>. La formo
      <ctl><tld/>i&gcirc;a</ctl> aperas en la citita fonto, &scirc;ajne
      kun la senco, kiun ni prezentas, sed aliloke, en
      <fnt><bib>PIV2</bib><lok>punkto</lok></fnt>, &gcirc;i
      havas sencon, por kiu ni preferis la terminon
      &leftquot;<ref cel="adher.0a.vico">adhera</ref>&rightquot;.
    </rim>
    <trd lng="ca">d'acumulaci&oacute; <klr>(punt)</klr></trd>
    <trd lng="de">H&auml;ufungs-<klr tip="amb">(punkt)</klr></trd>
    <trdgrp lng="en">
      <trd>accumulation<klr tip="amb"> (point)</klr></trd>,
      <trd>cluster<klr tip="amb"> (point)</klr></trd>
    </trdgrp>
    <trd lng="fr"><klr tip="amb">(point)
    </klr>d'<ind>accumulation</ind></trd>
    <trd lng="hu">torl&oacute;d&aacute;si <klr tip="amb">(pont)</klr></trd>
    <trd lng="pl"><klr tip="amb">(punkt) </klr>skupienia</trd>
    <trdgrp lng="ru">
      <trd>&c_p;&c_r;&c_je;&c_d;&c_je;&c_l;&c_mol;&c_n;&c_a;&c_ja;
      <klr tip="amb"> (&c_t;&c_o;&c_ch;&c_k;&c_a;)</klr></trd>,
      <trd><klr tip="amb"> (&c_t;&c_o;&c_ch;&c_k;&c_a;)</klr>
      <ind>&c_s;&c_g;&c_u;&c_shch;&c_je;&c_n;&c_i;&c_ja;</ind></trd>,
      <trd><klr tip="amb"> (&c_t;&c_o;&c_ch;&c_k;&c_a;)</klr>
      <ind>&c_n;&c_a;&c_k;&c_o;&c_p;&c_l;&c_je;&c_n;&c_i;&c_ja;</ind></trd>
    </trdgrp>
    <trd lng="sk">hromadn&yacute; <klr>(bod)</klr></trd>
  </snc>
  <trdgrp lng="be">
    <trd><klr>(&c_p;&c_u;&c_n;&c_k;&c_t;)</klr>
    <ind>&c_s;&c_k;&c_u;&c_p;&c_ch;&c_e;&c_n;&c_mol;&c_n;&c_ja;</ind></trd>,
    <trd><klr>(&c_p;&c_u;&c_n;&c_k;&c_t;)</klr>
    <ind>&c_z;&c_g;&c_u;&c_sh;&c_ch;&c_e;&c_n;&c_mol;&c_n;&c_ja;</ind></trd>,
    <trd><klr>(&c_p;&c_u;&c_n;&c_k;&c_t;)</klr>
    <ind>&c_l;&c_ib;&c_m;&c_ib;&c_t;&c_a;&c_v;&c_y;</ind></trd>
  </trdgrp>
  <trd lng="he">&he;&tsadi;&tet;&bet;&resh;&vav;&tav;</trd>
