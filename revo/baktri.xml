  <art mrk="$Id: baktri.xml,v 1.14 2025/04/26 02:00:59 revo Exp $">
    <kap>
      <rad>Baktri</rad>/o
    </kap>

    <drv mrk="baktri.B0o">
      <kap>
        <tld/>o
      </kap>
      <snc>
        <uzo tip="fak">GEOG</uzo>
        <uzo tip="fak">HIS</uzo>
        <dif>
          Historia <ref tip="lst" cel="region.0o.land" lst="voko:regionoj">regiono</ref> en la
          <ref tip="malprt" cel="azi.InternaA0o">Interna Azio</ref>,
          inter la montaro <ref cel="hindukusx.H0o">Hinduku&scirc;o</ref>
          sude kaj la supra kaj meza partoj de
          <ref cel="amudarj.A0o">Amudarjo</ref> norde (nun en norda
          Afganujo,
          kaj en partoj de Uzbekujo kaj Turkmenujo), kies &ccirc;efurbo
          estis
          <em>Baktra</em>, la nuna Bal&hcirc;o.  Konkerite de la nomadoj
          (to&hcirc;aroj), &gcirc;i i&gcirc;is <em>To&hcirc;arujo</em>
          en 2a jc a.K.:
          <ekz>
            la loka legendo konservis ligon inter la edzino de
            Aleksandro kaj <tld/>o, lando de &scirc;ia vera patro
            <fnt>
              <aut>Marko Polo, trad. D. Moirand</aut>:
              <vrk>La libro de la mirinda&jcirc;oj a&ubreve; la
              priskribo de la mondo</vrk>,
              <lok>UEA, 2001, p. 125.</lok>
            </fnt>.
          </ekz>
        </dif>
        <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 84%">&#x4E2D;&#x4E9A;&#x7684;&#x4E00;&#x4E2A;&#x5386;&#x53F2;&#x5730;&#x533A;&#xFF0C;&#x5357;&#x4E34;&#x5174;&#x90FD;&#x5E93;&#x4EC0;&#x5C71;&#x8109;&#xFF0C;&#x5317;&#x81F3;&#x963F;&#x59C6;&#x6CB3;&#x7684;&#x4E0A;&#x6E38;&#x548C;&#x4E2D;&#x6E38;&#xFF08;&#x4ECA;&#x5C5E;&#x963F;&#x5BCC;&#x6C57;&#x5317;&#x90E8;&#x4EE5;&#x53CA;&#x4E4C;&#x5179;&#x522B;&#x514B;&#x65AF;&#x5766;&#x548C;&#x571F;&#x5E93;&#x66FC;&#x65AF;&#x5766;&#x7684;&#x90E8;&#x5206;&#x5730;&#x533A;&#xFF09;&#xFF0C;&#x9996;&#x90FD;&#x662F;&#x5DF4;&#x514B;&#x7279;&#x62C9;&#xFF0C;&#x5373;&#x4ECA;&#x5DF4;&#x5C14;&#x8D6B;&#x3002;&#x516C;&#x5143;&#x524D;2&#x4E16;&#x7EAA;&#x88AB;&#x6E38;&#x7267;&#x6C11;&#x65CF;&#xFF08;&#x5410;&#x706B;&#x7F57;&#x4EBA;&#xFF09;&#x5F81;&#x670D;&#x540E;&#xFF0C;&#x6210;&#x4E3A;&#x5410;&#x706B;&#x7F57;&#x3002;</dif>
        <trd lng="be">&c_B;&c_a;&c_k;&c_t;&c_r;&c_y;&c_ja;</trd>
        <trd lng="ca">Bactriana</trd>
        <trd lng="de">Baktrien</trd>
        <trdgrp lng="en">
          <trd>Bactria</trd>,
          <trd>Bactriane</trd>,
          <trd>Zariaspa</trd>
        </trdgrp>
        <trd lng="fr">Bactriane</trd>
        <trdgrp lng="grc">
          <trd>&Beta;&alfa;&kappa;&tau;&rho;&jota_ton;&alfa;</trd>,
          <trd>&Beta;&alfa;&kappa;&tau;&rho;&jota;&alfa;&ny;&eta_ton;</trd>
        </trdgrp>
        <trd lng="hu">Baktria</trd>
        <trd lng="pl">Baktria</trd>
        <trd lng="ru">&c_B;&c_a;&c_k;&c_t;&c_r;&c_i;&c_ja;</trd>
        <trdgrp lng="zh">
          <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 95%">&#x5DF4;&#x514B;&#x7279;&#x91CC;&#x4E9E; <pr>b&#x0101;k&egrave;t&egrave;l&#x01D0;y&agrave;</pr></trd>,
          <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 95%">&#x5DF4;&#x514B;&#x7279;&#x91CC;&#x4E9A; <pr>b&#x0101;k&egrave;t&egrave;l&#x01D0;y&agrave;</pr></trd>
        </trdgrp>
      </snc>
      <trd lng="he">&het;&yod;&yod;&dalet;&qof;</trd>
  <trd lng="ja">&#12496;&#12463;&#12488;&#12522;&#12450;</trd>
  <trd lng="uk">&c_B;&c_a;&c_k;&c_t;&c_r;&c_ib;&c_ja;</trd>
</drv>

    <drv mrk="baktri.b0akamelo">
      <kap>
        <tld/>a kamelo
      </kap>
      <snc mrk="baktri.b0akamelo.ZOO">
        <uzo tip="fak">ZOO</uzo>
        <dif>
          Specio de <ref tip="super" cel="kamel.0o">kamelo</ref>
          (<trd lng="la">Camelus ferus <klr>(sova&gcirc;a)</klr></trd> kaj
            <trd lng="la">Camelus bactrianus
            <klr>(hejmigita)</klr></trd>)
            kun du &gcirc;iboj, vivanta en centra <ref tip="vid" cel="azi.A0o">Azio</ref>.
        </dif>
        <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">The two-humped camels Camelus ferus (wild) and Camelus bactrianus (domesticated), native to Central Asia.</dif>
        <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Kamelart (Camelus ferus (wild) und Camelus bactrianus (domestiziert)) mit zwei H&ouml;ckern, die in Zentralasien lebt.</dif>
        <ref tip="vid" cel="dromed.0o.ZOO">dromedaro</ref>
        <trd lng="be">&c_b;&c_a;&c_k;&c_t;&c_r;&c_y;&c_ja;&c_n;</trd>
        <trd lng="ca"><ind>camell</ind> bactri&agrave;</trd>
        <trdgrp lng="de">
          <trd fnt="AI: en pl la; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Trampeltier</trd>,
          <trd fnt="AI: pl dif; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Zweih&ouml;ckriges Kamel</trd>
        </trdgrp>
        <trdgrp lng="pl">
          <trd>baktrian</trd>,
          <trd>wielb&lstroke;&aogonek;d dwugrabny</trd>
        </trdgrp>
        <trdgrp lng="zh">
          <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 96%">&#x96D9;&#x5CF0;&#x99F1;&#x99DD; <pr>shu&#x0101;ngf&#x0113;ng lu&ograve;tuo</pr></trd>,
          <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 96%">&#x53CC;&#x5CF0;&#x9A86;&#x9A7C; <pr>shu&#x0101;ngf&#x0113;ng lu&ograve;tuo</pr></trd>
        </trdgrp>
      </snc>
    <trd lng="en">Bactrian <ind>camel</ind></trd>
    </drv>

