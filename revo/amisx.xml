<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: amisx.xml,v 1.5 2025/10/09 03:07:59 revo Exp $">
<kap>
  <rad>ami&scirc;</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="amisx.0o">
  <kap><tld/>o</kap>
  <snc mrk="amisx.0o.KRI">
    <uzo tip="fak">KRI</uzo>
    <dif>
      Ano de <ref tip="vid" cel="amisx.0ismo.KRI"><tld/>ismo</ref>:
      <ekz>
        mi por la unua fojo en mia vivo vidis realan <tld/>on kiu iris
        sur sia &ccirc;aro
        <fnt>
          <aut>Be&ccirc;jo</aut>,
          <vrk><url ref="http://becxjo.blogspot.com/2010/09/tre-freneza-vojago-de-mi.html">
          Tre freneza voja&gcirc;o de mi</url></vrk>,
          <lok>2010-09-10</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="de" fnt="Vikt: pl; juĝis claude-opus-5">Amischer</trd>
  <trd lng="en">Amish</trd>
  <trd lng="zh" fnt="AI: en ref dif; proponis gpt-5.6-luna; taksis Jev 93%">&#x963F;&#x7C73;&#x4EC0;&#x4EBA; <pr>&#x0100;m&#x01D0;sh&iacute; r&eacute;n</pr></trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_m;&c_ib;&c_sh;</trd>,
    <trd>&c_a;&c_m;&c_a;&c_n;&c_ib;&c_t;</trd>
  </trdgrp>
  <trd lng="ca">amish <klr>(subst.)</klr></trd>
  <trd lng="fr">amish</trd>
  <trd lng="uk">&c_a;&c_m;&c_ib;&c_sh;</trd>
</drv>

<drv mrk="amisx.0ismo">
  <kap><tld/>ismo</kap>
  <snc mrk="amisx.0ismo.KRI">
    <uzo tip="fak">KRI</uzo>
    <dif>
      Doktrino kaj praktiko de
      <ref tip="vid" cel="amisx.0o.KRI"><tld/>oj</ref>;
      bran&ccirc;o de <ref tip="vid" cel="menonit.0ismo.KRI">menonitismo</ref>
      germandevena, nunepoke precipe usona,
      rimarkinda pro malakcepto de modernaj te&hcirc;nika&jcirc;oj.
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Lehre und Praxis der Amischen; Zweig des Mennonitentums deutscher Herkunft, heute vor allem in den USA verbreitet, bemerkenswert wegen der Ablehnung moderner Technik.</dif>
  <trd lng="en">Amish</trd>
  <trd lng="zh" fnt="AI: en ref dif; proponis gpt-5.6-luna; taksis Jev 85%">&#x963F;&#x7C73;&#x4EC0;&#x6559;&#x6D3E; <pr>&#x0100;m&#x01D0;sh&iacute; ji&agrave;op&agrave;i</pr></trd>
  </snc>
  <trd lng="be">&c_a;&c_m;&c_ib;&c_sh;&c_y;&c_z;&c_m;</trd>
  <trd lng="ca">doctrina amish</trd>
</drv>
</art>

