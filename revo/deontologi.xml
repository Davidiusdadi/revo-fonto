          <aut>Michel Duc Goninaz</aut>
          <vrk><url ref="&Monato;/2004/008254.html">&Jcirc;urnalisma deontologio</url></vrk>
          <lok>2004</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Honora Medalo de Paco estas konfirmo pri la kura&gcirc;o, <tld/>o
        kaj atinga&jcirc;oj de la &ccirc;inaj pacdefendaj trupanoj
        <fnt>
          <aut>lazura&ccirc;ielo</aut>,
          <vrk>&Ccirc;inaj oficiroj kaj soldatoj...</vrk>,
          <lok><url ref="http://raporto.info">Raporto.info</url>,
          2006-11-15</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="en" fnt="Vikt: en de es pl ru; juĝis claude-opus-5">deontology</trd>
