<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: aski.xml,v 1.22 2025/03/21 08:35:25 revo Exp $">
 <kap>
   <rad>Aski</rad>/o
 </kap>
 <drv mrk="aski.0o">
   <kap><tld/>o</kap>
   <snc mrk="aski.0o.KOMP">
     <uzo tip="fak">KOMP</uzo>
     <dif>
       Usondevena sepbita <ref tip="super" cel="kod.0o.SCI">kodo</ref>
       kies signaro entenas la 26 latinajn majusklajn kaj minusklajn literojn, ciferojn,
       interpunkciajn signojn kaj stirsignojn:
      <ekz>
        <nom>Marek Blahu&scaron;</nom> en tre komprenebla maniero klarigas, kio estas signokodoj, <tld/>o,
        kodpa&gcirc;oj, la Universala signaro
        <fnt>
          <bib>Monato</bib>
          <aut>Anna kaj Mati Pentus</aut>
          <vrk><url ref="&Monato;/2008/009306.php"
              >Lingvo, Interreto kaj ... alio</url></vrk>
          <lok>2008</lok>
        </fnt>;
      </ekz>
      <ekz>
        la reta Monato <klr>[&#8230;]</klr> ekzistas du retaj versioj: la <tld lit="a"/>a kaj
        la unikoda
        <fnt>
          <bib>LOdE</bib>
          <lok>2001, &#8470;11</lok>
        </fnt>.
      </ekz>
    </dif>
     <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 88%">&#x4E00;&#x79CD;&#x7F8E;&#x56FD;&#x5F00;&#x53D1;&#x7684;&#x4E03;&#x4F4D;&#x7F16;&#x7801;&#xFF0C;&#x5176;&#x5B57;&#x7B26;&#x96C6;&#x5305;&#x542B;26&#x4E2A;&#x62C9;&#x4E01;&#x5927;&#x5199;&#x548C;&#x5C0F;&#x5199;&#x5B57;&#x6BCD;&#x3001;&#x6570;&#x5B57;&#x3001;&#x6807;&#x70B9;&#x7B26;&#x53F7;&#x548C;&#x63A7;&#x5236;&#x5B57;&#x7B26;&#x3002;</dif>
    <refgrp tip="prt">
      <ref cel="po.0_signo">po-signo</ref>,
      <ref cel="helik.0o.ascii">heliko</ref>
    </refgrp>
    <trd lng="ca">ASCII</trd>
    <trd lng="de">ASCII</trd>
    <trd lng="en">ASCII</trd>
    <trd lng="fa">&a_A;&a_fatha;&a_s;&f_k;&f_y;</trd>
    <trd lng="fr">ASCII</trd>
    <trd lng="hu">ASCII</trd>
    <trd lng="it">ASCII</trd>
    <trd lng="nl">ASCII</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 92%">ASCII&#x78BC; <pr>ASCII m&#x01CE;</pr></trd>,
      <trd fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 92%">ASCII&#x7801; <pr>ASCII m&#x01CE;</pr></trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_o;&c_d; ASCII</trd>,
    <trd>ASCII</trd>,
    <trd>&#171;&c_a;&c_s;&c_k;&c_ib;&#187;</trd>
  </trdgrp>
  <trd lng="cs">ASCII <klr>(vyslov eskii)</klr></trd>
  <trd lng="ja">&#12450;&#12473;&#12461;&#12540;&#25991;&#23383;  <pr>&#12450;&#12473;&#12461;&#12540;&#12418;&#12376;</pr></trd>
  <trd lng="sk">ASCII</trd>
  <trd lng="uk">&c_k;&c_o;&c_d; ASCII</trd>
</drv>

<drv mrk="aski.0igi">
  <kap><tld lit="a"/>igi</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="aski.0igi.KOMP">
    <uzo tip="fak">KOMP</uzo>
    <dif>
      Prezenti informon per nuraj signoj de <tld/>o:
      <ekz>
        <tld lit="a"/>igi la frazon
        <ctl>e&hcirc;o&scirc;an&gcirc;o &ccirc;iu&jcirc;a&ubreve;de</ctl>
        al <ctl>e^ho^san^go ^ciu^ja^ude</ctl>;
      </ekz>
      <ekz>
        <tld lit="a"/>igita rusa teksto
        <fnt>
          <vrk><url ref="https://www.esperanto.mv.ru/MM/Lat1/BIB.html"
              >Bibliografio </url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Informationen ausschlie&szlig;lich mit Zeichen des ASCII-Codes darstellen.</dif>
    <trdgrp lng="ca">
      <trd>presentar en <ind>ASCII</ind></trd>,
      <trd>passar a <ind>ASCII</ind></trd>
    </trdgrp>
    <trd lng="de" fnt="AI: nl hu ca; proponis claude-opus-5-5; kontrolis claude-opus-5-5">in ASCII umwandeln</trd>
    <trd lng="en">ASCIIze</trd>
    <trd lng="fr">ASCIIfier</trd>
    <trd lng="hu">&aacute;talak&iacute;t <ind>ASCII-v&eacute;</ind></trd>
    <trd lng="it">ASCII-ficare</trd>
    <trd lng="nl">omzetten naar <ind>ASCII</ind></trd>
    <trd lng="zh" fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 87%">ASCII&#x5316; <pr>ASCII hu&agrave;</pr></trd>
  </snc>
<trdgrp lng="be">
  <trd>&c_p;&c_je;&c_r;&c_a;&c_w;&c_t;&c_v;&c_a;&c_r;&c_a;&c_c;&c_mol; &c_u; &c_k;&c_o;&c_d; <ind>ASCII</ind></trd>,
  <trd>&c_p;&c_r;&c_a;&c_d;&c_s;&c_t;&c_a;&c_w;&c_l;&c_ja;&c_c;&c_mol; &c_u; &c_k;&c_o;&c_d;&c_z;&c_je; <ind>ASCII</ind></trd>
</trdgrp>
</drv>
</art>
