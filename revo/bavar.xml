<kap><ofc>10</ofc>
  <rad>bavar</rad>/o
  <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="bavar.0o">
  <kap><tld/>o</kap>
  <snc mrk="bavar.0o.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      Lo&gcirc;anto de <tld lit="B"/>ujo a&ubreve; parolanto de la tiea dialekto:
      <ekz>
        en batalo &ccirc;e <nom>Hohenlinden</nom> (3-an de Decembro 1800), francoj sub komando de <nom>Moreau</nom>
        venkis a&ubreve;strojn kaj <tld/>ojn
        <fnt>
          <bib>SrT</bib>
          <lok>Libro XI.</lok>
        </fnt>;
      </ekz>
      <ekz>
        la germana kanceliero <klr>[&#x2026;]</klr> rebatis la komentojn de <nom>Stoiber</nom>,
        <klr>[&#x2026;]</klr> anka&ubreve; aliaj politikistoj kritikis la <tld/>on
        <fnt>
          <bib>Monato</bib>
          <aut>Jomo Ipfelkofer</aut>
          <vrk><url ref="&Monato;/2005/008575.php">60 jarojn poste</url></vrk>
          <lok>2005</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 91%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x7684;&#x5C45;&#x6C11;&#x6216;&#x5F53;&#x5730;&#x65B9;&#x8A00;&#x7684;&#x4F7F;&#x7528;&#x8005;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An inhabitant of Bavaria or a speaker of the local dialect.</dif>
    <trd lng="de">Bayer</trd>
    <trd lng="es">b&aacute;varo</trd>
    <trd lng="hu">bajor</trd>
    <trdgrp lng="pl">
      <trd>Bawarczyk</trd>,
      <trd>Baier<klr> (region.)</klr></trd>
    </trdgrp>
    <trd lng="ru">&c_b;&c_a;&c_v;&c_a;&c_r;&c_je;&c_c;</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr ja; proponis gpt-5.6-luna; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9E;&#x4EBA;</trd>,
      <trd fnt="AI: en fr ja; proponis gpt-5.6-luna; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x4EBA;</trd>
    </trdgrp>
  </snc>
  <snc mrk="bavar.0o.HIS">
    <uzo tip="fak">HIS</uzo>
    <dif>
      Lo&gcirc;anto de duklando <tld lit="B"/>ujo (6a &gcirc;is 12a jc, iam inkluzivanta sudan tirolon)
      kaj nomo de ano de iama &gcirc;ermana tribo.
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An inhabitant of the Duchy of Bavaria (6th to 12th centuries, at times including southern Tyrol), or a member of a former Germanic tribe.</dif>
    <trdgrp lng="de">
      <trd>Baier</trd>,
      <trd>Bajuware</trd>
    </trdgrp>
    <trd lng="es">b&aacute;varo</trd>
    <trdgrp lng="hu">
      <trd>bajor</trd>,
      <trd>bajuvar</trd>
    </trdgrp>
    <trd lng="ru">&c_b;&c_a;&c_v;&c_a;&c_r;</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 93%">&#x5DF4;&#x4F10;&#x5229;&#x4E9E;&#x4EBA;</trd>,
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 93%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x4EBA;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_v;&c_a;&c_r;&c_a;&c_c;</trd>
  <trd lng="cs">Bavor<klr>(&aacute;k)</klr></trd>
  <trd lng="en">Bavarian</trd>
  <trd lng="fr">Bavarois<klr> (habitant)</klr></trd>
  <trd lng="he">&bet;&vav;&vav;&alef;&resh;&yod;&he;</trd>
  <trdgrp lng="ja">
    <trd>&#x30D0;&#x30A4;&#x30A8;&#x30EB;&#x30F3;&#x4EBA;  <pr>&#x30D0;&#x30A4;&#x30A8;&#x30EB;&#x30F3;&#x3058;&#x3093;</pr></trd>,
    <trd>&#x30D0;&#x30D0;&#x30EA;&#x30A2;&#x4EBA;  <pr>&#x30D0;&#x30D0;&#x30EA;&#x30A2;&#x3058;&#x3093;</pr></trd>
  </trdgrp>
  <trd lng="sk">Bavor&aacute;k</trd>
  <trd lng="uk">&c_b;&c_a;&c_v;&c_a;&c_r;&c_je;&c_c;</trd>
</drv>

<drv mrk="bavar.0a">
  <kap><ofc>10</ofc><tld/>a</kap>
  <snc>
    <dif>
      Rilatanta al <tld/>oj, ilia nacieco a&ubreve; &scirc;tato:
      <ekz>
        <tld/>a biero
        <fnt>
          <bib>Monato</bib>
          <aut>Maul Stefan</aut>
          <vrk>Malbona venko</vrk>
        </fnt>;
      </ekz>
      <ekz>
        re&gcirc;a <tld lit="B"/>a centra konsilano de instruado &ccirc;e la sekreta ministra&jcirc;o de
        interna&jcirc;oj en Mun&hcirc;eno
        <fnt>
          <bib>FK</bib>
          <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld lit="B"/>a Instruista Asocio rezoluciis por la enkonduko de Esperanto en
        elementajn lernejojn
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la katastrofo eliris de la <tld/>a urbo A&ubreve;gsburgo
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk>Germanio: Pekoj de patriarko</vrk>
        </fnt>;
      </ekz>
      <ekz>
        sur la policaj ser&ccirc;listoj de la gvidintoj de la <tld/>a konsilia respubliko en
        Munkeno mankis la foto de <nom>Ret Marut</nom>
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 3</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 85%">&#x4E0E;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x4EBA;&#x3001;&#x5176;&#x6C11;&#x65CF;&#x6216;&#x5176;&#x56FD;&#x5BB6;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Relating to Bavarians, their nationality or state.</dif>
    <trdgrp lng="de">
      <trd>bayrisch</trd>,
      <trd>bayerisch</trd>
    </trdgrp>
    <trd lng="pl">bawarski</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 93%">&#x5DF4;&#x4F10;&#x5229;&#x4E9E;&#x7684;</trd>,
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 93%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x7684;</trd>
    </trdgrp>
  </snc>
  <snc>
    <uzo tip="fak">HIS</uzo>
    <dif>
      Rilatanta al <tld/>oj, ilia kulturo a&ubreve; iama duklando:
      <ekz>
        <tld/>aj dialektoj, a&ubreve;toroj;
      </ekz>
      <ekz>
        ili kovris la kapon kaj viza&gcirc;on per kapu&ccirc;o, en malnova <tld/>a dialekto nomita
        <nac>gugl</nac>
        <fnt>
          <bib>Monato</bib>
          <aut>Jomo Ipfelkofer</aut>
          <vrk><url ref="&Monato;/2006/009006.php">Monar&hcirc;o-mistero: &ccirc;u murdo a&ubreve; sinmortigo?</url></vrk>
          <lok>2006</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x4E0E;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x4EBA;&#x3001;&#x5176;&#x6587;&#x5316;&#x6216;&#x6614;&#x65E5;&#x516C;&#x56FD;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Relating to Bavarians, their culture or former duchy.</dif>
    <trdgrp lng="de">
      <trd>bairisch</trd>,
      <trd>bajuwarisch</trd>
    </trdgrp>
    <trd lng="hu">Baier</trd>
    <trd lng="pl">bawarski</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9E;&#x7684;</trd>,
      <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x7684;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_v;&c_a;&c_r;&c_s;&c_k;&c_ib;</trd>
  <trd lng="bg">&c_B;&c_a;&c_v;&c_a;&c_r;&c_s;&c_k;&c_i;</trd>
  <trd lng="cs">bavorsk&yacute;</trd>
  <trd lng="en">Bavarian</trd>
  <trd lng="es">b&aacute;varo</trd>
  <trd lng="fr">bavarois<klr> (adjectif)</klr></trd>
  <trd lng="he">&bet;&vav;&vav;&alef;&resh;&yod;&he;</trd>
  <trdgrp lng="hu">
    <trd>bajor</trd>,
    <trd>bajuvar</trd>
  </trdgrp>
  <trd lng="nl">beiers</trd>
  <trd lng="ru">&c_b;&c_a;&c_v;&c_a;&c_r;&c_s;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">bavorsk&yacute;</trd>
</drv>

<drv mrk="bavar.B0ujo">
  <kap><ofc>10</ofc><tld lit="B"/>ujo</kap>
  <uzo tip="fak">GEOG</uzo>
  <fnt><bib>PIV1</bib></fnt>
  <fnt><bib>KrED</bib></fnt>
  <snc>
    <dif>
      Unu el la federaciaj &scirc;tatoj de
      <ref tip="malprt" cel="german1.G0ujo">Germanujo</ref> kun regurbo
      Munkeno; inkluzivanta la historiajn regionojn
      Malnovbavarujo, Frankujo kaj Supra &Scirc;vabujo:
      <ekz>
        ni lasas al la legantoj elparoli la nomon kiel ili volas, ekzemple &leftquot;<nom>F&uuml;rth</nom>&rightquot; &ndash;
        urbo en <tld lit="B"/>ujo
        <fnt>
          <bib>LR</bib>
          <lok>Dua Parto &ndash; Gramatiko</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x5FB7;&#x56FD;&#x7684;&#x4E00;&#x4E2A;&#x8054;&#x90A6;&#x5DDE;&#xFF0C;&#x9996;&#x5E9C;&#x4E3A;&#x6155;&#x5C3C;&#x9ED1;&#xFF0C;&#x5305;&#x62EC;&#x65E7;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x3001;&#x5F17;&#x5170;&#x80AF;&#x548C;&#x4E0A;&#x65BD;&#x74E6;&#x672C;&#x7B49;&#x5386;&#x53F2;&#x5730;&#x533A;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">One of the federal states of Germany, with Munich as its capital, comprising the historical regions of Old Bavaria, Franconia and Upper Swabia.</dif>
    <trd lng="de">Bayern</trd>
    <trd lng="en">Bavaria</trd>
    <trd lng="es">Baviera</trd>
    <trd lng="lat">Bavaria</trd>
    <trdgrp lng="pl">
      <trd>Bawaria</trd>,
      <trd>Baiery<klr> (region.)</klr></trd>
    </trdgrp>
  </snc>
  <snc>
    <dif>
      Iama &scirc;tato de la bavara tribo, duklando, kerno de la poste
      de Napoleono kreita re&gcirc;lando <tld lit="B"/>ujo, parto de la germana
      imperio ekde 1871:
      <ekz>
        la pre&gcirc;eja sonorilo el <nom>Marbach</nom> <klr>[&#x2026;]</klr> devis migri en <tld lit="B"/>ujon
        en la fandofornon
        <fnt>
          <bib>Fab4</bib>
          <lok>Malnova pre&gcirc;eja sonorilo</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A former state of the Bavarian tribe, a duchy, the core of the Kingdom of Bavaria later created by Napoleon, and part of the German Empire from 1871.</dif>
    <trd lng="de">Baiern</trd>
    <trd lng="lat">Bavaria</trd>
  </snc>
  <trd lng="be">&c_B;&c_a;&c_v;&c_a;&c_r;&c_y;&c_ja;</trd>
  <trd lng="bg">&c_B;&c_a;&c_v;&c_a;&c_r;&c_i;&c_ja;</trd>
  <trd lng="fr">Bavi&egrave;re</trd>
  <trd lng="hu">Bajororsz&aacute;g</trd>
  <trd lng="nl">Beieren</trd>
  <trd lng="ru">&c_B;&c_a;&c_v;&c_a;&c_r;&c_i;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: el en; taksis Jev 70%">&#x62DC;&#x6069; <pr>b&agrave;i'&#x0113;n</pr></trd>,
    <trd fnt="Vikt: zh en; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9E; <pr>B&#x0101;f&aacute;l&igrave;y&agrave;</pr></trd>,
    <trd fnt="Vikt: zh en; taksis Jev 94%">&#x5DF4;&#x4F10;&#x5229;&#x4E9A; <pr>B&#x0101;f&aacute;l&igrave;y&agrave;</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 80%">&#x62DC;&#x4EC1; <pr>B&agrave;ir&eacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="bavar.Malnov0ujo">
  <kap>Malnov<tld/>ujo</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Moderna nomo por la regionoj de nuna Bavarujo, kiuj iam formis la
      historian duklandon Bavarujo.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x73B0;&#x4ECA;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x5404;&#x5730;&#x533A;&#x7684;&#x73B0;&#x4EE3;&#x540D;&#x79F0;&#xFF1B;&#x8FD9;&#x4E9B;&#x5730;&#x533A;&#x8FC7;&#x53BB;&#x66FE;&#x7EC4;&#x6210;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x5386;&#x53F2;&#x516C;&#x56FD;&#x3002;</dif>
      <trdgrp lng="zh">
        <trd fnt="AI: en de be; proponis gpt-5.6-luna; taksis Jev 90%">&#x820A;&#x5DF4;&#x4F10;&#x5229;&#x4E9E;</trd>,
        <trd fnt="AI: en de be; proponis gpt-5.6-luna; taksis Jev 90%">&#x65E7;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;</trd>
      </trdgrp>
    </snc>
    <trd lng="be">&c_S;&c_t;&c_a;&c_r;&c_a;&c_ja; <ind>&c_B;&c_a;&c_v;&c_a;&c_r;&c_y;&c_ja;</ind></trd>
    <trdgrp lng="de">
      <trd>Altbaiern</trd>,
      <trd>Altbayern</trd>
    </trdgrp>
    <trd lng="en">Old <ind>Bavaria</ind></trd>
    <trd lng="hu">t&ouml;rt&eacute;nelmi
    <ind>Bajororsz&aacute;g</ind></trd>
</drv>
<adm>
  Mi ne trovis cita&jcirc;on pri malnovabavarujo. La apartigo de sencoj &scirc;ajnas al mi ankora&ubreve; iomete tro leksikoneca
  kaj tro specifa.
  Aliaj kompareblaj artikoloj simple distingas apartenon al etno (nune kaj historie) de aparteno al sub&scirc;tato.
  <aut>WD</aut>
</adm>
</art>
