<art mrk="$Id: bilbok.xml,v 1.21 2026/03/12 17:47:00 revo Exp $">
<kap>
  <rad>bilbok</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="bilbok.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      <ref tip="lst" cel="lud.0ilo" lst="voko:ludiloj">Ludilo</ref>,
      konsistanta el borita globeto alligita per &scirc;nureto al bastoneto, per kiu
      oni devas pikkapti la globeton:
      <ekz>
        <tld/>o devenas de kanadaj inuitoj, kiuj skulptis &gcirc;in el rosmardentoj;
      </ekz> 
      <ekz>
        <tld/>o estis tre &scirc;atata dum la tempo de Henriko 3-a en Francujo.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 84%">&#x4E00;&#x79CD;&#x73A9;&#x5177;&#xFF0C;&#x7531;&#x4E00;&#x4E2A;&#x7528;&#x7EF3;&#x5B50;&#x7CFB;&#x5728;&#x5C0F;&#x68CD;&#x4E0A;&#x7684;&#x94BB;&#x5B54;&#x5C0F;&#x7403;&#x7EC4;&#x6210;&#xFF0C;&#x5FC5;&#x987B;&#x7528;&#x5C0F;&#x68CD;&#x6233;&#x4E2D;&#x5E76;&#x63A5;&#x4F4F;&#x5C0F;&#x7403;&#x3002;</dif>
    <rim>
      La nomo ventas de &leftquot;<nac>bille</nac>&rightquot; (globo) kaj &leftquot;<nac>boquet</nac>&rightquot; (kapreto), do oni povus nomi &gcirc;in
      esperante &leftquot;globkorno&rightquot;.
    </rim>
    <bld lok="&WCU;/thumb/1/11/Bilboquet_(France)%2C_possibly_ca._1780_(CH_18457451).jpg/500px-Bilboquet_(France)%2C_possibly_ca._1780_(CH_18457451).jpg" prm="PD"><tld/>o
        <fnt>
          <aut>kataloga foto</aut>
          <lok><url ref="&WCW;/File:Bilboquet_(France),_possibly_ca._1780_(CH_18457451).jpg">&WCW;/File:Bilboquet_(France),_possibly_ca._1780_(CH_18457451).jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_b;&c_ib;&c_l;&c_mol;&c_b;&c_o;&c_k;&c_e;</trd>
    <trdgrp lng="de">
      <trd>Fang-den-Ball-Spiel</trd>,
      <trd>Bilboquet</trd>
    </trdgrp>
    <trd lng="en">cup-and-ball game</trd>
    <trd lng="fr">bilboquet</trd>
    <trd lng="hu">bilboquet<klr tip="amb"> (goly&oacute;fog&oacute;
    j&aacute;t&eacute;k)</klr></trd>
    <trdgrp lng="nl">
      <trd>bilboquet</trd>,
      <trd>balvangertje</trd>
    </trdgrp>
    <trd lng="pl">bilbokiet</trd>
    <trd lng="ru">&c_b;&c_i;&c_l;&c_mol;&c_b;&c_o;&c_k;&c_je;</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: de en fr; proponis gpt-5.6-luna; taksis Jev 85%">&#x6BD4;&#x723E;&#x535A;&#x84CB; <pr>b&#x01D0;'&ecaron;rb&oacute;g&agrave;i</pr></trd>,
      <trd fnt="AI: de en fr; proponis gpt-5.6-luna; taksis Jev 85%">&#x6BD4;&#x5C14;&#x535A;&#x76D6; <pr>b&#x01D0;'&ecaron;rb&oacute;g&agrave;i</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="ja">&#x3051;&#x3093;&#x7389;  <pr>&#x3051;&#x3093;&#x3060;&#x307E;</pr></trd>
  <trd lng="uk">&#x431;&#x456;&#x43B;&#x44C;&#x431;&#x43E;&#x43A;&#x435;&#xA0;(&#x433;&#x440;&#x430;)</trd>
</drv>
