    <dif>
      Ritma, rapida speco de <ref tip="vid"
      cel="gimnas1.0o">gimnastiko</ref>
      kutime plenumata la&ubreve; muziko:
      <ekz>
        la movoj &ccirc;e <ctl>zumba</ctl> enhavas elementojn
        precipe de <tld/>o kaj latin-amerikaj dancoj
        <fnt>
          <aut>&Eacute;. Baloghn&eacute; Fodor</aut>,
          <vrk><url ref="&Monato;/2016/011774.php">Zumba: ne nur por gejunuloj</url></vrk>,
          <bib>Monato</bib>
          <lok>2016/12, p. 23</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x901A;&#x5E38;&#x4F34;&#x968F;&#x97F3;&#x4E50;&#x8FDB;&#x884C;&#x7684;&#x6709;&#x8282;&#x594F;&#x7684;&#x5FEB;&#x901F;&#x4F53;&#x64CD;&#x3002;</dif>
    <trd lng="de" fnt="Vikt: fr; juĝis claude-opus-5">Aerobic</trd>
    <trd lng="zh" fnt="AI: en dif; proponis gpt-5.6-luna; taksis Jev 92%">&#x6709;&#x6C27;&#x64CD;</trd>
  </snc>
  <trd lng="be">&c_a;&c_e;&c_r;&c_o;&c_b;&c_ib;&c_k;&c_a;</trd>
  <trd lng="en">aerobics</trd>
  <trd lng="fr">a&eacute;robic</trd>
  <trd lng="nl">aerobics</trd>
</drv>
</art>

