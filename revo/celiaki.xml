<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: celiaki.xml,v 1.9 2025/03/28 16:48:05 revo Exp $">
<kap>
    <rad>celiaki</rad>/o
</kap>
<drv mrk="celiaki.0o">
  <kap><tld/>o</kap>
  <snc mrk="celiaki.0o.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      Hereda <ref tip="lst" cel="san.mal0o.MED" lst="voko:malsanoj">Malsano</ref> karakterizita de kronika inflamo de la maldika intesto pro netolerado de gluteno:
      <ekz>
        gluteno estas dividita en du grupoj da proteinoj, gluteninoj kaj gliadinoj, nur
        la gliadinofrakcio povas ka&ubreve;zi <tld/>on
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=23203">Gluteno</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        en grandaj superbazaroj eblas trovi apartajn man&gcirc;a&jcirc;ojn por <tld/>uloj
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="en">
      <trd fnt="Vikt: en es fr ku; juĝis claude-opus-5">coeliac disease <klr>(British)</klr></trd>,
      <trd fnt="Vikt: fr ru; juĝis claude-opus-5">celiac disease <klr>(US)</klr></trd>,
      <trd fnt="Vikt: ru; juĝis claude-opus-5">gluten enteropathy</trd>
    </trdgrp>
  </snc>
  <rim>
    La&#365; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>glutenmalsano</ke>, <ke>glutennetolero</ke>. 
  </rim>

  <trd lng="be">&c_c;&c_e;&c_l;&c_ib;&c_ja;&c_k;&c_ib;&c_ja;</trd>
  <trdgrp lng="ca">
    <trd>malaltia <ind>cel&iacute;ac</ind>a</trd>,
    <trd>celiaquia</trd>,
    <trd>malaltia de Thaysen</trd>
  </trdgrp>
  <trd lng="de">Z&ouml;liakie</trd>
  <trdgrp lng="fr">
    <trd>maladie coeliaque</trd>,
    <trd>coeliaquie</trd>,
    <trd>sprue</trd>
  </trdgrp>
  <trd lng="it">celiachia</trd>
  <trd lng="pl">celiakia</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en es fr ku; taksis Jev 93%">&#x4E73;&#x7CDC;&#x7009; <pr>r&#x01D4;m&iacute;xi&egrave;</pr></trd>,
    <trd fnt="Vikt: en es fr ku; taksis Jev 93%">&#x4E73;&#x7CDC;&#x6CFB; <pr>r&#x01D4;m&iacute;xi&egrave;</pr></trd>,
    <trd fnt="Vikt: en ku; taksis Jev 91%">&#x4E73;&#x7CDC;&#x6D29;</trd>,
    <trd fnt="Vikt: en ku; taksis Jev 91%">&#x4E73;&#x7CDC;&#x6CC4;</trd>,
    <trd fnt="Vikt: en; taksis Jev 89%">&#x4E73;&#x7CDC;&#x6CC4;</trd>,
    <trd fnt="Vikt: en; taksis Jev 89%">&#x4E73;&#x7CDC;&#x6D29;</trd>
  </trdgrp>
</drv>
</art>

