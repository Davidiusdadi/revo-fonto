  <trd lng="be">&c_A;&c_r;&c_n;&c_e;&c_m;</trd>
  <trd lng="ca">Arnhem</trd>
  <trdgrp lng="de">
    <trd>Arnheim</trd>,
    <trd>Arnhem</trd>
  </trdgrp>
  <trd lng="en">Arnhem</trd>
  <trd lng="fr">Arnhem</trd>
  <trd lng="hu">Arnhem</trd>
  <trd lng="it">Arnhem</trd>
