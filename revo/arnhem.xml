        <tld/>o vokas vin
        <fnt><aut>a&ubreve;toro nekonata</aut>:
           <vrk>Arnhemo vokas vin (turisma bro&scirc;uro)</vrk>
        </fnt>;
      </ekz>
      <ekz>
        Al <tld/>o iru &ccirc;iuj,
        tie staras nia Dom&#8217;
        <fnt><vrk>el kanto</vrk></fnt>!
       </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x8377;&#x5170;&#x6D77;&#x5C14;&#x5FB7;&#x5170;&#x7701;&#x7684;&#x4E00;&#x5EA7;&#x57CE;&#x5E02;&#xFF08;&#x4E1C;&#x7ECF;5&deg;55&minute;&#xFF0C;&#x5317;&#x7EAC;52&deg;00&minute;&#xFF09;&#x3002;</dif>
