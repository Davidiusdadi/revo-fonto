<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: avare.xml,v 1.11 2026/07/24 14:10:23 revo Exp $">
<kap>
  <rad>avare</rad>/o
</kap>
<drv mrk="avare.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">HIS</uzo>
  <snc>
    <dif>
      Ano de orientdevena hordo, poparte tjurk-, slav- kaj
      &gcirc;ermanlingva, kiu regis teritorion de proksimume nuna Hungarujo,
      inter jaroj 550a kaj 800a, ofte rabeksursante al bizancia
      Balkanio, Bavario, Norditalujo:
      <ekz>
        la enigma gento de <tld/>oj, kiu dum la 6a jarcento invadis la
        stepon<fnt><aut>Jouko Lindstedt</aut>: <vrk>La deveno de la
        slavoj</vrk>, <lok>Literatura foiro, numero 160a, 1996-04, p.
        89-95a</lok></fnt>
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x4E00;&#x79CD;&#x4E1C;&#x90E8;&#x8D77;&#x6E90;&#x7684;&#x90E8;&#x843D;&#xFF0C;&#x90E8;&#x5206;&#x4F7F;&#x7528;&#x7A81;&#x53A5;&#x8BED;&#x3001;&#x65AF;&#x62C9;&#x592B;&#x8BED;&#x548C;&#x65E5;&#x8033;&#x66FC;&#x8BED;&#xFF0C;&#x7EA6;&#x5728;550&#x5E74;&#x81F3;800&#x5E74;&#x7EDF;&#x6CBB;&#x4ECA;&#x5308;&#x7259;&#x5229;&#x4E00;&#x5E26;&#x7684;&#x5730;&#x533A;&#xFF0C;&#x5E76;&#x7ECF;&#x5E38;&#x88AD;&#x63A0;&#x62DC;&#x5360;&#x5EAD;&#x7684;&#x5DF4;&#x5C14;&#x5E72;&#x5730;&#x533A;&#x3001;&#x5DF4;&#x4F10;&#x5229;&#x4E9A;&#x548C;&#x5317;&#x610F;&#x5927;&#x5229;&#x3002;</dif>
    <rim num="1">
      Oni ne konfuzu la historiajn <tld/>ojn kun la moderna ka&ubreve;kazia
      popolo, kies nomo en aliaj lingvoj sonas simile (dum ili mem
      nomas sin <ctl>ma'arul</ctl>).
      <aut>Sergio Pokrovskij</aut>
    </rim>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_v;&c_a;&c_r;</trd>,
    <trd>&c_o;&c_b;&c_r;</trd>
  </trdgrp>
  <trd lng="ca">&agrave;var<klr> (subst.)</klr></trd>
  <trd lng="de">Aware</trd>
  <trdgrp lng="en">
    <trd>Pannonian Avar</trd>,
    <trd>Avar</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>Avar<klr> (subst.)</klr></trd>
  </trdgrp>
  <trd lng="hu">avar</trd>
  <trd lng="it">Avaro</trd>
  <trd lng="pl">Awar</trd>
  <trdgrp lng="ru">
    <trd>&c_a;&c_v;&c_a;&c_r;<klr> (&c_i;&c_s;&c_t;.)</klr></trd>,
    <trd>&c_o;&c_b;&c_r;<klr> (&c_i;&c_s;&c_t;.)</klr></trd>,
    <trd>&c_o;&c_b;&c_r;&c_i;&c_n;<klr> (&c_i;&c_s;&c_t;.)</klr></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="AI: en de; proponis gpt-5.6-luna; taksis Jev 92%">&#x963F;&#x74E6;&#x723E;&#x4EBA; <pr>&#x0100;w&#x01CE;'&ecaron;rr&eacute;n</pr></trd>,
    <trd fnt="AI: en de; proponis gpt-5.6-luna; taksis Jev 92%">&#x963F;&#x74E6;&#x5C14;&#x4EBA; <pr>&#x0100;w&#x01CE;'&ecaron;rr&eacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="avare.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Rilata al <tld/>oj.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x4E0E;&#x963F;&#x74E6;&#x5C14;&#x4EBA;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
  </snc>
  <trd lng="be">&c_a;&c_v;&c_a;&c_r;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">&agrave;var<klr> (adj.)</klr></trd>
  <trd lng="de">awarisch</trd>
  <trd lng="en">Avarian</trd>
  <trdgrp lng="fr">
    <trd>avar<klr> (adj.)</klr></trd>
  </trdgrp>
  <trd lng="hu">avar</trd>
  <trd lng="it">degli <ind>Avari</ind></trd>
  <trd lng="pl">awarski</trd>
  <trd lng="ru">&c_a;&c_v;&c_a;&c_r;&c_s;&c_k;&c_i;&c_j;<klr> (&c_i;&c_s;&c_t;.)</klr></trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en de; proponis gpt-5.6-luna; taksis Jev 83%">&#x963F;&#x74E6;&#x723E;&#x4EBA;&#x7684; <pr>&#x0100;w&#x01CE;'&ecaron;rr&eacute;n de</pr></trd>,
    <trd fnt="AI: en de; proponis gpt-5.6-luna; taksis Jev 83%">&#x963F;&#x74E6;&#x5C14;&#x4EBA;&#x7684; <pr>&#x0100;w&#x01CE;'&ecaron;rr&eacute;n de</pr></trd>
  </trdgrp>
</drv>
</art>
