<vortaro>
  <art mrk="$Id: bordun.xml,v 1.2 2025/11/18 10:38:42 afido Exp $">
    <kap>
      <rad>bordun</rad>/o
    </kap>

<drv mrk="bordun.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MUZ</uzo>
  <snc>
    <dif>
      Plej baza bassono, kontinue akompananta plurvo&ccirc;an muzika&jcirc;on;
      sonorilo de tia sono, basa kordo, fluto en iu instrumento:
      <ekz>
        <klr>[&ccirc;e la &scirc;losila harpo]</klr> kutima aran&gcirc;o por kordoj kaj &scirc;losiloj estas: &ndash;
        tri ludkordoj kun &scirc;losiloj por &ccirc;iuj duontonoj je respektiva kordo &ndash; unu basa
        ludkordo sen &scirc;losiloj, <tld/>o &ndash; dekdu resonancaj kordoj
        <fnt>
          <aut>Lasse Granat</aut>
          <vrk><url ref="https://www.esperanto-gbg.org/oraklubo/Ora_Jxurnalo_n-ro_34.pdf"
              >La &scirc;losila harpo</url></vrk>
          <lok>Ora &Jcirc;urnalo, n-ro 34, nov. 2020</lok>
        </fnt>;
      </ekz>
      <ekz>
        la bodego estas pli granda <klr>[&#8230;]</klr> kaj &gcirc;ia ru&ccirc;ilo (a&ubreve; <tld/>o) ludas la
        noton F, kiam la skota ludas la noton Bb
        <fnt>
          <bib>Kon11</bib>
          <lok>Intervjuo</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 80%">&#x6301;&#x7EED;&#x4E3A;&#x591A;&#x58F0;&#x90E8;&#x4E50;&#x66F2;&#x4F34;&#x594F;&#x7684;&#x6700;&#x4F4E;&#x97F3;&#xFF1B;&#x53D1;&#x51FA;&#x8FD9;&#x79CD;&#x58F0;&#x97F3;&#x7684;&#x949F;&#x3001;&#x4F4E;&#x97F3;&#x5F26;&#xFF0C;&#x4EE5;&#x53CA;&#x67D0;&#x4E9B;&#x4E50;&#x5668;&#x4E2D;&#x7684;&#x4F4E;&#x97F3;&#x7BA1;&#x3002;</dif>
    <trd lng="de">Bordun</trd>
    <trd lng="en">drone <klr>(sound)</klr></trd>
    <trd lng="fr">bourdon <klr>(musique)</klr></trd>
    <trd lng="it">bordone <klr>(musica)</klr></trd>
    <trd lng="ru">&c_b;&c_u;&c_r;&c_d;&c_o;&c_n; <klr>(&c_m;&c_u;&c_z;&c_y;&c_k;&c_a;)</klr></trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr it; proponis gpt-5.6-luna; taksis Jev 83%">&#x6301;&#x7E8C;&#x4F4E;&#x97F3; <pr>ch&iacute;x&ugrave; d&#x012B;y&#x012B;n</pr></trd>,
      <trd fnt="AI: en fr it; proponis gpt-5.6-luna; taksis Jev 83%">&#x6301;&#x7EED;&#x4F4E;&#x97F3; <pr>ch&iacute;x&ugrave; d&#x012B;y&#x012B;n</pr></trd>
    </trdgrp>
  </snc>
<trd lng="be">&c_b;&c_u;&c_r;&c_d;&c_o;&c_n;</trd>
</drv>

