<drv mrk="bagel.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KUI</uzo>
  <snc>
    <dif>
      Ringa <ref tip="super" cel="bulk.0o">bulko</ref>, origina el orienta E&ubreve;ropo, tipa en
      Nordameriko,
      kies tritikan paston oni kuiras anta&ubreve; la bakado:
      <ekz>
        Montreala <tld/>o
        <fnt>
          <vrk><url
          ref="https://bitoteko.esperanto.es/xmlui/bitstream/handle/11013/5936/Riverego142-144.pdf?"
              >Vi maltrafis virtualajn eventojn</url></vrk>
          <lok>La Riverego, n-ro 142-144, a&ubreve;tuno-vintro 2020 &ndash; printempo 2021p. 29</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Rosillo</nom>, estro de la <tld/>-butiko, kreis la vaste &scirc;atatan &leftquot;&ccirc;ielarkan
        <tld/>on&rightquot;
        <fnt>
          <vrk><url ref="http://esperanto.china.org.cn/2016-02/18/content_37819229.htm"
              >La plej bela bagelo en la mondo</url></vrk>
          <lok>2016-02-18</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="kring.0o">kringo</ref>,
      <ref cel="pan.ringo0o">ringopano</ref>
    </refgrp>
    <trd lng="de">Bagel</trd>
    <trd lng="en">bagel</trd>
    <trd lng="fr">bagel</trd>
    <trd lng="id">bagel</trd>
    <trd lng="ru">&c_b;&c_je;&c_j;&c_g;&c_l;</trd>
    <trd lng="yi">&bet;&#1522;&#8503;&lamed;</trd>
    <trdgrp lng="zh">
      <trd fnt="Vikt: zh en; taksis Jev 95%">&#x8C9D;&#x679C; <pr>b&egrave;igu&#x01D2;</pr></trd>,
      <trd fnt="Vikt: zh en; taksis Jev 95%">&#x8D1D;&#x679C; <pr>b&egrave;igu&#x01D2;</pr></trd>,
      <trd fnt="Vikt: en; taksis Jev 84%">&#x57F9;&#x679C;</trd>,
      <trd fnt="Vikt: en; taksis Jev 86%">&#x7119;&#x679C;</trd>
    </trdgrp>

  </snc>
  <trd lng="ca">bagel</trd>

