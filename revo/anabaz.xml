<vortaro>
<art mrk="$Id: anabaz.xml,v 1.7 2026/07/24 19:44:35 revo Exp $">
<kap>
  <rad>Anabaz</rad>/o <fnt><bib>NePiv</bib></fnt>
</kap>
<drv mrk="anabaz.0o">
  <kap><tld/>o</kap>
  <snc mrk="anabaz.0o.BELE">
    <uzo tip="fak">BELE</uzo>
    <dif>
    Antikva greka rakonto de
    <ref tip="vid" cel="ksenofon.0o">Ksenofonto</ref> pri la malfacila
    hejmenrevena vojo de helenaj dungosoldatoj tra Anatolio dum
    la jaro 401a a.K.:
    <ekz>
      &ccirc;u vi parolas pri la <ctl>Anabazo</ctl> de Ksenofonto?
      Tiam la helenaj dungosoldatoj retiri&gcirc;is, ne estante
      &ccirc;irka&ubreve;itaj de malamikoj
      <fnt>
        <aut>I. Efremov, trad. J. Finkel</aut>,
        <vrk><url ref="http://www.esperanto.mv.ru/Efremov/tais_10.html">
        Tais el Ateno</url></vrk>,
        <lok>2008</lok>
      </fnt>.
    </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x53E4;&#x5E0C;&#x814A;&#x4F5C;&#x5BB6;&#x8272;&#x8BFA;&#x82AC;&#x8BB0;&#x8FF0;&#x7684;&#x4E00;&#x4E2A;&#x6545;&#x4E8B;&#xFF0C;&#x8BB2;&#x8FF0;&#x516C;&#x5143;&#x524D;401&#x5E74;&#x5E0C;&#x814A;&#x96C7;&#x4F63;&#x5175;&#x7A7F;&#x8D8A;&#x5B89;&#x7EB3;&#x6258;&#x5229;&#x4E9A;&#x8270;&#x96BE;&#x8FD4;&#x4E61;&#x7684;&#x65C5;&#x7A0B;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An ancient Greek account by Xenophon of the difficult journey home of Greek mercenaries through Anatolia in 401 BC.</dif>
  </snc>
  <trd lng="be">&c_A;&c_n;&c_a;&c_b;&c_a;&c_s;&c_y;&c_s;</trd>
  <trd lng="ca">An&agrave;basi</trd>
  <trd lng="de">Anabasis</trd>
  <trd lng="el">&Alfa_psili;&ny;&alfa_ton;&beta;&alfa;&sigma;&jota;&sigma_fina;</trd>
  <trd lng="en" fnt="AI: de el fr it pl; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">Anabasis</trd>
  <trd lng="fr">Anabase</trd>
  <trd lng="it">Anabasi</trd>
  <trdgrp lng="pl">
    <trd>Anabaza</trd>,
    <trd>Wyprawa Cyrusa</trd>
  </trdgrp>
</drv>
</art>

