<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: android.xml,v 1.14 2026/08/01 13:51:09 revo Exp $">
<kap>
    <rad>android</rad>/o <fnt><bib>Viki</bib></fnt>
</kap>
<drv mrk="android.0o">
  <kap><tld/>o</kap>
  <snc mrk="android.0o.TEK">
    <uzo tip="fak">TEK</uzo>
    <dif>
      <ref tip="super" cel="robot.0o">Roboto</ref>, kiu tre similas al
      homo kaj kondutas simile al homo:
      <ekz>
        la <tld/>o <nom>Data</nom> &ccirc;iam strebas alpreni homajn
        karakteriza&jcirc;ojn, aparte homajn emociojn
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=287621">Stela
          Voja&gcirc;o: La Sekva Generacio</url></lok>
        </fnt>.
      </ekz>
     </dif>
       <trdgrp lng="de">
         <trd fnt="Vikt: en fr; juĝis claude-opus-5">Android</trd>,
         <trd fnt="Vikt: en fr; juĝis claude-opus-5">Androide</trd>,
         <trd fnt="Vikt: fr; juĝis claude-opus-5">Maschinenmensch</trd>
       </trdgrp>
     </snc>
    <trd lng="be">&c_a;&c_n;&c_d;&c_r;&c_o;&c_ib;&c_d;</trd>
  <trd lng="en">android</trd>
  <trd lng="es">androide</trd>
  <trd lng="fr">andro&iuml;de</trd>
  <trd lng="pl">android</trd>
  <trd lng="pt">androide</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en fr; taksis Jev 88%">&#x4EBA;&#x5F62;&#x6A5F;&#x5668;&#x4EBA; <pr>r&eacute;nx&iacute;ngj&#x012B;q&igrave;r&eacute;n</pr></trd>,
    <trd fnt="Vikt: en fr; taksis Jev 88%">&#x4EBA;&#x5F62;&#x673A;&#x5668;&#x4EBA; <pr>r&eacute;nx&iacute;ngj&#x012B;q&igrave;r&eacute;n</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 86%">&#x4EBA;&#x9020;&#x4EBA; <pr>r&eacute;nz&agrave;or&eacute;n</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 84%">&#x4EFF;&#x751F;&#x4EBA; <pr>f&#x01CE;ngsh&#x0113;ngr&eacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="android.A0o">
  <kap><tld lit="A"/>o</kap>
  <snc mrk="android.A0o.KOMP">
    <uzo tip="fak">KOMP</uzo>
    <uzo tip="fak">TEL</uzo>
    <dif>
      Po&scirc;telefona <ref tip="super" cel="operac.0umo">operaciumo</ref>,
      kies kerno uzas <ref tip="super" cel="linuks.0o">Linukson</ref>:
      <ekz>
        Linukso a&ubreve; <tld lit="A"/>o estas ekzemploj de malfermkodaj
        programoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=509559">Malferma
          kodo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Betriebssystem f&uuml;r Mobiltelefone, das auf einem Linux-Kernel beruht.</dif>
  </snc>
  <trd lng="be">&c_A;&c_n;&c_d;&c_r;&c_o;&c_ib;&c_d;</trd>
  <trd lng="de" fnt="AI: en es pl pt id; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Android</trd>
  <trd lng="en">Android <klr>(operating system)</klr></trd>
  <trd lng="es">Android</trd>
  <trd lng="fr">Andro&iuml;d</trd>
  <trd lng="id">Android</trd>
  <trd lng="pl">Android</trd>
  <trd lng="pt">Android</trd>
  <trdgrp lng="zh">
    <trd>&#26426;&#22120;&#20154; <pr>j&imacron;q&igrave;r&eacute;n</pr></trd>,
    <trd>&#27231;&#22120;&#20154; <pr>j&imacron;q&igrave;r&eacute;n</pr></trd>,
    <trd>&#20154;&#36896;&#20154; <pr>r&eacute;nz&agrave;or&eacute;n</pr></trd>,
    <trd>&#20223;&#29983;&#20154; <pr>f&#462;ngsh&emacron;ngr&eacute;n</pr></trd>
  </trdgrp>
</drv>
</art>

