<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: boks.xml,v 1.34 2026/08/12 19:19:30 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>boks</rad>/i <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="boks.0i">
  <kap><tld/>i</kap>
  <gra><vspec>x</vspec></gra>
  <snc mrk="boks.0i.lukti">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Korpe batali, uzante la membrojn por frapi la kontra&ubreve;ulon:
      <ekz>
        personoj kiuj kvaza&ubreve; <tld/>as unu la alian kaj konkuras por
        akiri la regpovon
        <fnt>
          <aut>Platono, trad. D. Broadribb</aut>
          <vrk>La Respubliko</vrk>
          <lok>1993</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To fight physically, using the limbs to strike the opponent.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">K&ouml;rperlich k&auml;mpfen, wobei man die Gliedma&szlig;en benutzt, um den Gegner zu schlagen.</dif>
    <trdgrp lng="zh">
    <trd>&#29992;&#25331;&#25171;&#25549; <pr>y&ograve;ngqu&aacute;nd&#462;z&ograve;u</pr></trd>,
    <trd>&#25331;&#20987; <pr>qu&aacute;nj&iacute;</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="be">
    <trd>&c_b;&c_a;&c_k;&c_s;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_z;&c_a;&c_j;&c_m;&c_a;&c_c;&c_c;&c_a; <ind>&c_b;&c_o;&c_k;&c_s;&c_a;&c_m;</ind></trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>boxejar</trd>,
    <trd>boxar</trd>
  </trdgrp>
  <trd lng="cs">boxovat</trd>
  <trd lng="de">boxen</trd>
  <trd lng="en">box</trd>
  <trd lng="es">boxear</trd>
  <trd lng="fr">boxer</trd>
  <trd lng="he">&lamed;&he;&tav;&alef;&#8503;&resh;&fpe;</trd>
  <trd lng="hu">bokszol</trd>
  <trdgrp lng="it">
     <trd>boxare</trd>,
     <trd>pugilare</trd></trdgrp>
  <trd lng="ja">&#25331;&#38360;&#12377;&#12427;  <pr>&#12369;&#12435;&#12392;&#12358;&#12377;&#12427;</pr></trd>
  <trd lng="nl">boksen</trd>
  <trd lng="pl">boksowa&cacute;</trd>
  <trd lng="ru">&c_b;&c_o;&c_k;&c_s;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
  <trd lng="sk">boxova&tcaron;</trd>
  <trd lng="sv">boxas</trd>
  <trd lng="uk">&c_b;&c_o;&c_k;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
</drv>

<drv mrk="boks.0o">
  <kap><tld/>o</kap>
  <snc mrk="boks.0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      <ref tip="super" cel="art.batal0o.SPO">Batalarto</ref>
      en kiu la kontra&ubreve;ulon oni penas faligi
      per frapado, neniam per tenado:
      <ekz>
        al racie pensanta homo &scirc;ajnas strange, ke oni nomas <tld/>on
        <ctl>la nobla arto</ctl>
        <fnt>
          <aut>J. Dias Pinto</aut>
          <vrk>La arto politiki</vrk>
          <lok>Brazila Esperantisto, 2014-07, numero 349a</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A martial art in which one tries to knock down the opponent by striking, never by holding.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Kampfkunst, in der man den Gegner durch Schl&auml;ge, niemals durch Festhalten, zu Fall zu bringen versucht.</dif>
    <trdgrp lng="zh">
      <trd>&#20114;&#27572; <pr>h&ugrave;&omacron;u</pr></trd>,
      <trd>&#25331;&#20987; <pr>qu&aacute;nj&iacute;</pr></trd>,
      <trd>&#25331;&#20987;&#27604;&#36187; <pr>qu&aacute;nj&imacron;b&#464;s&agrave;i</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_b;&c_o;&c_k;&c_s;</trd>
  <trd lng="ca">boxa</trd>
  <trd lng="cs">box</trd>
  <trdgrp lng="de">
     <trd>Boxen</trd>,
     <trd>Faustkampf</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>boxing</trd>,
    <trd>pugilism</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>boxeo</trd>,
    <trd>box</trd>,
    <trd>pugilismo</trd>
  </trdgrp>
  <trd lng="fr">boxe <klr tip="ind">(sport)</klr></trd>
  <trd lng="he">&alef;&#1460;&#8503;&resh;&vav;&#1468;&fpe;</trd>
  <trdgrp lng="hu">
     <trd>&ouml;k&ouml;lv&iacute;v&aacute;s</trd>,
     <trd>boksz</trd>
  </trdgrp>
  <trdgrp lng="it">
     <trd>boxe</trd>,
     <trd>pugilato</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#25331;&#38360;  <pr>&#12369;&#12435;&#12392;&#12358;</pr></trd>,
    <trd>&#12508;&#12463;&#12471;&#12531;&#12464;  <pr>&#12412;&#12367;&#12375;&#12435;&#12368;</pr></trd>
  </trdgrp>
  <trd lng="nl">boksen<klr> (de sport)</klr></trd>
  <trd lng="pl">boks</trd>
  <trd lng="ru">&c_b;&c_o;&c_k;&c_s;</trd>
  <trd lng="sk">box</trd>
  <trd lng="sv">boxning</trd>
  <trd lng="uk">&c_b;&c_o;&c_k;&c_s;</trd>
</drv>

<drv mrk="boks.angla0o">
  <kap>angla <tld/>o</kap>
  <snc mrk="boks.angla0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Angladevena, vaste konata speco de
      <ref tip="super" cel="boks.0o.SPO">bokso</ref>,
      en kiu oni frapas nur per la pugnoj:
      <ekz>
        Pa&ubreve;&ccirc;jo a&ubreve;skultis la unuan mallongan lekcion pri la angla <tld/>o
        <fnt>
          <aut>N. Ostrovskij, trad. S. Cins</aut>
          <vrk><url ref="http://www.elerno.cn/elibro/kiel_sxtalo_estas_hardata.pdf">
          Kiel &scirc;talo estis hardata</url></vrk>
          <lok>[1997]</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x6E90;&#x81EA;&#x82F1;&#x56FD;&#x3001;&#x5E7F;&#x4E3A;&#x4EBA;&#x77E5;&#x7684;&#x4E00;&#x79CD;&#x62F3;&#x51FB;&#xFF0C;&#x6BD4;&#x8D5B;&#x4E2D;&#x53EA;&#x80FD;&#x7528;&#x62F3;&#x5934;&#x51FB;&#x6253;&#x3002;</dif>
  </snc>
  <trd lng="be">&c_a;&c_n;&c_g;&c_je;&c_l;&c_mol;&c_s;&c_k;&c_ib;
  <ind>&c_b;&c_o;&c_k;&c_s;</ind></trd>
  <trdgrp lng="de">
    <trd>englisches Boxen</trd>,
    <trd>Boxen <klr>(nach Queensberry-Regeln)</klr></trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>English boxing</trd>,
    <trd>Western boxing</trd>,
    <trd>modern boxing <klr>(following the Queensbury Rules)</klr></trd>
  </trdgrp>
  <trd lng="fr">boxe anglaise</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 92%">&#x82F1;&#x5F0F;&#x62F3;&#x64CA; <pr>Y&#x012B;ngsh&igrave; qu&aacute;nj&#x012B;</pr></trd>,
    <trd fnt="AI: en fr de; proponis gpt-5.6-luna; taksis Jev 92%">&#x82F1;&#x5F0F;&#x62F3;&#x51FB; <pr>Y&#x012B;ngsh&igrave; qu&aacute;nj&#x012B;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="boks.franca0o">
  <kap>franca <tld/>o</kap>
  <snc mrk="boks.franca0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Francdevena
      <ref tip="super" cel="boks.0o.SPO">bokso</ref>,
      en kiu oni frapas per la pugnoj kaj piedoj:
      <ekz>
        franca <tld/>o estas unu el kelkaj stiloj de pied<tld/>ado
        en kiuj la luktantoj kutime uzas &scirc;uojn
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="&Viki;/Franca_bokso">
          Franca bokso</url>, 2015-11-21</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Boxing originating in France, in which one strikes with the fists and feet.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Aus Frankreich stammendes Boxen, bei dem man mit den F&auml;usten und F&uuml;&szlig;en schl&auml;gt.</dif>
    <trd lng="zh">&#27861;&#22269;&#25331;&#20987; <pr>f&#462;gu&oacute;qu&aacute;nj&imacron;</pr></trd>
</snc>
  <trd lng="be">&c_f;&c_r;&c_a;&c_n;&c_c;&c_u;&c_s;&c_k;&c_ib; <ind>&c_b;&c_o;&c_k;&c_s;</ind></trd>
  <trd lng="de">Savate <klr>(franz&ouml;sischer Kampfsport)</klr></trd>
  <trdgrp lng="en">
    <trd>savate</trd>,
    <trd>savate boxing</trd>,
    <trd>French boxing</trd>,
    <trd>French footfighting</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>boxe fran&ccedil;aise</trd>,
    <trd>savate<klr> (boxe fran&ccedil;aise)</klr></trd>
  </trdgrp>
</drv>

<drv mrk="boks.taja0o">
  <kap>taja <tld/>o</kap>
  <snc mrk="boks.taja0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Tajdevena
      <ref tip="super" cel="boks.0o.SPO">bokso</ref>,
      en kiu oni frapas per la pugnoj, kubutoj, genuoj
      kaj piedoj:
      <ekz>
        la trejnado por taja <tld/>o estas fama
        pro sia intenseco kaj rigoreco
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="&Viki;/Taja_bokso">
          Taja bokso</url>, 2015-11-21</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Boxing originating in Thailand, in which one strikes with the fists, elbows, knees and feet.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Aus Thailand stammendes Boxen, bei dem man mit den F&auml;usten, Ellbogen, Knien und F&uuml;&szlig;en schl&auml;gt.</dif>
    <trd lng="zh">&#27888;&#25331; <pr>t&agrave;iqu&aacute;n</pr></trd>
</snc>
  <trd lng="be">&c_t;&c_a;&c_j;&c_s;&c_k;&c_ib; <ind>&c_b;&c_o;&c_k;&c_s;</ind></trd>
  <trd lng="ca">boxa tailandesa</trd>
  <trdgrp lng="de">
    <trd>Thaiboxen</trd>,
    <trd>Muay Thai</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>Thai boxing</trd>,
    <trd>Muay Thai</trd>
  </trdgrp>
  <trd lng="fr">boxe tha&iuml;e</trd>
</drv>
</art>
