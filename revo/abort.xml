<fnt><bib>JED</bib></fnt></kap>

<drv mrk="abort.0i">
  <kap><tld/>i</kap>
  <gra><vspec>x</vspec></gra>
  <snc mrk="abort.0i.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      Naski anta&ubreve;tempe nevivpovan idon:
      <ekz>
        <klr>[se viro]</klr> frapos gravedan virinon, kaj &scirc;i
        <tld/>os,
        tiam oni punu lin per monpuno
        <fnt><bib>MT</bib>, <lok>&Eli; 21:22</lok></fnt>;
      </ekz>
      <ekz>
        donu al ili ventron <tld/>eman kaj mamojn seki&gcirc;intajn
        <fnt><bib>MT</bib>, <lok>&Hos; 9:14</lok></fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x8FC7;&#x65E9;&#x4EA7;&#x4E0B;&#x65E0;&#x6CD5;&#x5B58;&#x6D3B;&#x7684;&#x80CE;&#x513F;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To give birth prematurely to nonviable offspring.</dif>
    <trd lng="be">&c_s;&c_k;&c_ib;&c_d;&c_a;&c_c;&c_mol; &c_p;&c_l;&c_o;&c_d;</trd>
    <trd lng="de">fehlgeb&auml;ren</trd>
    <trd lng="es">abortar</trd>
    <trdgrp lng="hu">
      <trd>elvet&eacute;l</trd>,
      <trd>abort&aacute;l</trd>
    </trdgrp>
    <trd lng="ms">menggugurkan</trd>
    <trd lng="nl">ontijdig bevallen</trd>
    <trd lng="pl">poroni&cacute;</trd>
    <trd lng="ru">&c_v;&c_y;&c_k;&c_i;&c_n;&c_u;&c_t;&c_mol;
    &c_p;&c_l;&c_o;&c_d;</trd>
    <trd lng="sk">potrati&tcaron;</trd>
    <trd lng="sv">f&aring; missfall</trd>
  </snc>
  <snc mrk="abort.0i.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Halti en sia malvolvo, senrezultati&gcirc;i, fiaski:
      <ekz>
        la senprudenta entrepreno <tld/>is.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x5728;&#x53D1;&#x5C55;&#x8FC7;&#x7A0B;&#x4E2D;&#x505C;&#x6B62;&#xFF0C;&#x843D;&#x7A7A;&#xFF0C;&#x5931;&#x8D25;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To stop in its development, come to nothing, fail.</dif>
    <trdgrp lng="be">
      <trd>&c_n;&c_je; <ind>&c_w;&c_d;&c_a;&c_v;&c_a;&c_c;&c_c;&c_a;</ind></trd>,
      <trd>&c_c;&c_ja;&c_r;&c_p;&c_je;&c_c;&c_mol; <ind>&c_k;&c_r;&c_a;&c_h;</ind></trd>
    </trdgrp>
    <trd lng="de">zusammenbrechen</trd>
    <trd lng="hu">kudarcot vall</trd>
    <trd lng="nl">mislukken</trd>
    <trdgrp lng="pl">
      <trd>chybi&cacute;</trd>,
      <trd>nie <ind>uda&cacute; si&eogonek;</ind></trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_o;&c_k;&c_o;&c_n;&c_ch;&c_i;&c_t;&c_s;&c_ja;
      <ind>&c_p;&c_r;&c_o;&c_v;&c_a;&c_l;&c_o;&c_m;</ind></trd>,
      <trd>&c_p;&c_o;&c_t;&c_je;&c_r;&c_p;&c_je;&c_t;&c_mol;
      <ind>&c_n;&c_je;&c_u;&c_d;&c_a;&c_ch;&c_u;</ind></trd>,
      <trd>&c_n;&c_je;
      <ind>&c_u;&c_d;&c_a;&c_t;&c_mol;&c_s;&c_ja;</ind></trd>
    </trdgrp>
    <trd lng="zh" fnt="AI: en ref; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x592D;&#x6298; <pr>y&#x0101;ozh&eacute;</pr></trd>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>misnaski</ke>;
    (en la senco 'la plano <tld/>is') prefere diru
    <ke><ref tip="super" cel="fiask.0i">fiaski</ref></ke>,
    <ke><ref tip="super" cel="sukces.mal0i">malsukcesi</ref></ke>,
    <ke>ruini&gcirc;i</ke>.
  </rim>
  <rim>
    En la medicina senco la subjekto montras al la naskintino, dum
    en la figura &gcirc;i montras al la <ctl>naskita&jcirc;o</ctl>.
  </rim>
  <trd lng="ca">avortar</trd>
  <trdgrp lng="cs">
    <trd>potratit</trd>,
    <trd>rozb&iacute;t se</trd>,
    <trd>ztroskotat</trd>
  </trdgrp>
  <trd lng="da">abortere</trd>
  <trdgrp lng="en">
    <trd>miscarry</trd>,
    <trd>abort</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>avorter<klr tip="ind"> (intr.)</klr></trd>,
    <trd>tourner court</trd>,
    <trd>capoter</trd>
  </trdgrp>
  <trd lng="he">&lamed;&he;&pe;&yod;&lamed;</trd>
  <trd lng="it">abortire</trd>
  <trdgrp lng="ja">
    <trd>&#x6D41;&#29987;&#12377;&#x308B;  <pr>&#x308A;&#12421;&#12358;&#12374;&#12435;&#12377;&#x308B;</pr></trd>,
    <trd>&#x4E2D;&#x6B62;&#x306B;&#x306A;&#x308B;  <pr>&#12385;&#12421;&#12358;&#12375;&#x306B;&#x306A;&#x308B;</pr></trd>
  </trdgrp>
  <trd lng="pt">abortar</trd>
  <trdgrp lng="sk">
    <trd>abortova&tcaron;</trd>,
    <trd>potrati&tcaron; plod</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_v;&c_i;&c_k;&c_i;&c_n;&c_u;&c_t;&c_i; &c_p;&c_l;&c_ib;&c_d;</trd>,
    <trd>&c_p;&c_je;&c_r;&c_je;&c_d;&c_ch;&c_a;&c_s;&c_n;&c_o; &c_n;&c_a;&c_r;&c_o;&c_d;&c_i;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en pl pt; taksis Jev 84%">&#x6D41;&#x7522; <pr>li&uacute;ch&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en pl pt; taksis Jev 84%">&#x6D41;&#x4EA7; <pr>li&uacute;ch&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 46%">&#x58AE;&#x80CE; <pr>du&ograve;t&#x0101;i</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 46%">&#x5815;&#x80CE; <pr>du&ograve;t&#x0101;i</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 71%">&#x5C0F;&#x7522; <pr>xi&#x01CE;och&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 71%">&#x5C0F;&#x4EA7; <pr>xi&#x01CE;och&#x01CE;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="abort.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc>
    <dif>
      Ago <tld/>i:
      <ekz>
        &scirc;i ricevis pro <tld/>oj kaj malfacila laboro virinajn malsanojn
        <fnt>
          <bib>Metrop</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_s;&c_p;&c_a;&c_r;&c_o;&c_n;</trd>,
    <trd>&c_s;&c_k;&c_ib;&c_d;&c_a;&c_n;&c_mol;&c_n;&c_je; &c_p;&c_l;&c_o;&c_d;&c_a;</trd>
  </trdgrp>
  <trd lng="ca">avortament</trd>
  <trdgrp lng="cs">
    <trd>abortace</trd>,
    <trd>zakrn&ecaron;n&iacute;</trd>
  </trdgrp>
  <trd lng="da">abort</trd>
  <trd lng="de">Fehlgeburt <klr>(Handlung)</klr></trd>
  <trdgrp lng="en">
    <trd>miscarriage</trd>,
    <trd>abortion</trd>
  </trdgrp>
  <trd lng="es">aborto</trd>
  <trd lng="fr">avortement</trd>
  <trd lng="he">&he;&pe;&lamed;&he;</trd>
  <trd lng="ja">&#x6D41;&#29987;  <pr>&#x308A;&#12421;&#12358;&#12374;&#12435;</pr></trd>
  <trd lng="pl">poronienie</trd>
  <trd lng="ru">&c_a;&c_b;&c_o;&c_r;&c_t;</trd>
  <trdgrp lng="sk">
    <trd>abort&aacute;cia</trd>,
    <trd>zakrpatenie</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en ja; taksis Jev 69%">&#x5C0F;&#x7522; <pr>xi&#x01CE;och&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en ja; taksis Jev 69%">&#x5C0F;&#x4EA7; <pr>xi&#x01CE;och&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en ja; taksis Jev 79%">&#x6D41;&#x7522; <pr>li&uacute;ch&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en ja; taksis Jev 79%">&#x6D41;&#x4EA7; <pr>li&uacute;ch&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en ja; taksis Jev 60%">&#x81EA;&#x7136;&#x6D41;&#x7522; <pr>z&igrave;r&aacute;nli&uacute;ch&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en ja; taksis Jev 60%">&#x81EA;&#x7136;&#x6D41;&#x4EA7; <pr>z&igrave;r&aacute;nli&uacute;ch&#x01CE;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="abort.0ajxo">
  <kap><tld/>a&jcirc;o, <var><kap><tld/>ulo</kap></var></kap>
  <snc>
    <dif>
      Nevivpova ido:
      <ekz>
        ili malaperu, kiel <tld/>a&jcirc;o virina, kiu ne vidis la sunon
        <fnt><bib>MT</bib>, <lok>&Psa; 58:8</lok></fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x65E0;&#x6CD5;&#x5B58;&#x6D3B;&#x7684;&#x80CE;&#x513F;&#x3002;</dif>
    <rim>
      La Biblio similsence uzas anka&ubreve; <ctl><tld/>ito</ctl> kaj
      <ctl><tld/>ita&jcirc;o</ctl>. La pasiva formo sugestas, ke <tld/>i
      povus havi akuzativforman komplementon (same kiel naski), sed tia
      uzo
      ne disvasti&gcirc;is.
    </rim>
    <trdgrp lng="en">
      <trd kod="ARK" fnt="Vikt: ru; juĝis claude-opus-5">slink <klr>(dated)</klr></trd>,
      <trd kod="ARK" fnt="Vikt: it; juĝis claude-opus-5">abortion <klr>(dated)</klr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_v;&c_y;&c_k;&c_ib;&c_d;&c_a;&c_k;</trd>
  <trd lng="ca">avort&iacute;</trd>
  <trd lng="cs">nedoch&uring;d&ccaron;e</trd>
  <trd lng="de">Fehlgeburt <klr>(F&ouml;tus)</klr></trd>
  <trdgrp lng="es">
    <trd>feto abortado</trd>,
    <trd>aborto</trd>
  </trdgrp>
  <trd lng="fr">avorton</trd>
  <trd lng="he">&he;&pe;&lamed;&he;</trd>
  <trd lng="hu">elvet&eacute;lt <ind>magzat</ind></trd>
  <trd lng="it">aborto</trd>
  <trdgrp lng="ja">
    <trd>&#x6D41;&#29987;&#20816;  <pr>&#x308A;&#12421;&#12358;&#12374;&#12435;&#12376;</pr></trd>,
    <trd>&#12391;&#x304D;&#x305D;&#12371;&#x306A;&#12356;</trd>
  </trdgrp>
  <trd lng="nl">afgedreven vrucht</trd>
  <trdgrp lng="pl">
    <trd>rzecz  <ind>poroniona</ind></trd>,
    <trd>poroniony p&lstroke;&oacute;d</trd>
  </trdgrp>
  <trd lng="pt">aborto</trd>
  <trd lng="ru">&c_v;&c_y;&c_k;&c_i;&c_d;&c_y;&c_sh;</trd>
  <trd lng="sk">nedonosenec</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: de ja; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x6D41;&#x7522;&#x5152; <pr>li&uacute;ch&#x01CE;n'&eacute;r</pr></trd>,
    <trd fnt="AI: de ja; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x6D41;&#x4EA7;&#x513F; <pr>li&uacute;ch&#x01CE;n'&eacute;r</pr></trd>
  </trdgrp>
</drv>

<drv mrk="abort.0igi">
  <kap><tld/>igi</kap>
  <snc mrk="abort.0igi.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      Ka&ubreve;zi <tld/>on:
      <ekz>
        <klr>[en iu lando]</klr>, kie e&ccirc; <ind><tld/>igo</ind>
        estas konsiderata kiel murdo, oni nun sloganas por mortigo de
        &ccirc;iuj
        <klr>[aidos]</klr>-suferantoj
        <fnt><bib>UrdHadda</bib>, <lok>p. 26</lok></fnt>;
        <trd lng="fr">avortement</trd>
      </ekz>
      <ekz>
        infanoj kun genetikaj difektoj estas <tld/>igataj anta&ubreve; a&ubreve; mortigataj tuj post
        la naski&gcirc;o
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <ind><tld/>iga</ind> drogo.
        <trd lng="fr">abortif</trd>
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x5BFC;&#x81F4;&#x6D41;&#x4EA7;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To cause an abortion.</dif>
    <trd lng="be">&c_r;&c_a;&c_b;&c_ib;&c_c;&c_mol; <ind>&c_a;&c_b;&c_o;&c_r;&c_t;</ind></trd>
    <trd lng="bg">&c_a;&c_b;&c_o;&c_r;&c_t;&c_i;&c_r;&c_a;&c_m;</trd>
    <trd lng="ca">provocar l'avortament</trd>
    <trd lng="de">abtreiben</trd>
    <trdgrp lng="es">
      <trd>provocar un aborto</trd>,
      <trd>abortar</trd>
    </trdgrp>
    <trd lng="hu">abortuszt hajt v&eacute;gre</trd>
    <trdgrp lng="nl">
      <trd>aborteren</trd>,
      <trd>abortus plegen</trd>,
      <trd>een vrucht <ind>afdrijven</ind></trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>wywo&lstroke;a&cacute; <ind>poronienie</ind></trd>,
      <trd>przerywa&cacute; <ind>ci&aogonek;&zdot;&eogonek;</ind></trd>,
      <trd>sp&eogonek;dza&cacute; <ind>p&lstroke;&oacute;d</ind></trd>
    </trdgrp>
    <trdgrp lng="pt">
      <trd>fazer aborto</trd>,
      <trd>provocar aborto</trd>
    </trdgrp>
    <trd lng="ru">&c_s;&c_d;&c_je;&c_l;&c_a;&c_t;&c_mol;
      &c_a;&c_b;&c_o;&c_r;&c_t;</trd>
    <trd lng="sk">zapr&iacute;&ccaron;ini&tcaron;</trd>
    <trd lng="sv">g&ouml;ra abort</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x58AE;&#x80CE; <pr>du&ograve;t&#x0101;i</pr></trd>,
      <trd fnt="AI: en de; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x5815;&#x80CE; <pr>du&ograve;t&#x0101;i</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="abort.0igi.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Haltigi la malvolvon, sukceson de io, senrezultatigi, fiaskigi:
      <ekz>
        kio Vin interesas cele <klr>[&#8230;]</klr> <tld/>igi liajn beletrajn planojn
        <fnt>
          <bib>MMa</bib>
          <lok>&Ccirc;apitro 9</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x4F7F;&#x67D0;&#x4E8B;&#x7684;&#x53D1;&#x5C55;&#x6216;&#x6210;&#x529F;&#x4E2D;&#x6B62;&#xFF0C;&#x4F7F;&#x5176;&#x843D;&#x7A7A;&#x6216;&#x5931;&#x8D25;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To stop the development or success of something, causing it to come to nothing or fail.</dif>
    <trdgrp lng="be">
      <trd>&c_s;&c_p;&c_y;&c_n;&c_ja;&c_c;&c_mol;</trd>,
      <trd>&c_p;&c_je;&c_r;&c_a;&c_r;&c_y;&c_v;&c_a;&c_c;&c_mol;</trd>
    </trdgrp>
    <trd lng="ca">fer fracassar</trd>
    <trdgrp lng="de">
      <trd>abbrechen</trd>,
      <trd>abw&uuml;rgen</trd>
    </trdgrp>
    <trd lng="hu">meghi&uacute;s&iacute;t</trd>
    <trd lng="nl">doen <ind>mislukken</ind></trd>
    <trdgrp lng="pl">
      <trd>przerywa&cacute;</trd>,
      <trd>udaremnia&cacute;</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_p;&c_r;&c_je;&c_r;&c_y;&c_v;&c_a;&c_t;&c_mol;</trd>,
      <trd>&c_p;&c_r;&c_je;&c_r;&c_v;&c_a;&c_t;&c_mol;</trd>,
      <trd>&c_p;&c_r;&c_je;&c_k;&c_r;&c_a;&c_shch;&c_a;&c_t;&c_mol;</trd>,
      <trd>&c_p;&c_r;&c_je;&c_k;&c_r;&c_a;&c_t;&c_i;&c_t;&c_mol;</trd>
    </trdgrp>
    <trd lng="sk">zmari&tcaron; snahu niekoho</trd>
  </snc>
  <trd lng="ca">fer avortar</trd>
  <trdgrp lng="cs">
    <trd>pozastavit</trd>,
    <trd>p&rcaron;en. p&rcaron;edej&iacute;t</trd>,
    <trd>p&rcaron;ivodit potrat</trd>,
    <trd>um&ecaron;le p&rcaron;eru&scaron;it t&ecaron;hotenstv&iacute;</trd>
  </trdgrp>
  <trd lng="en">abort</trd>
  <trdgrp lng="fr">
    <trd>provoquer l'<ind>avortement</ind></trd>,
    <trd>faire <ind>avorter</ind></trd>,
    <trd>avorter<klr tip="ind"> (tr.)</klr></trd>,
    <trd>faire <ind>capoter</ind></trd>
  </trdgrp>
  <trd lng="he">&lamed;&gimel;&resh;&vav;&fmem; &lamed;&he;&pe;&lamed;&he;</trd>
  <trdgrp lng="ja">
    <trd>&#x6D41;&#29987;&#12373;&#x305B;&#x308B;  <pr>&#x308A;&#12421;&#12358;&#12374;&#12435;&#12373;&#x305B;&#x308B;</pr></trd>,
    <trd>&#x598A;&#x5A20;&#x4E2D;&#x7D76;&#12373;&#x305B;&#x308B;
    <pr>&#x306B;&#12435;&#12375;&#12435;&#12385;&#12421;&#12358;&#x305C;&#12388;&#12373;&#x305B;&#x308B;</pr></trd>,
    <trd>&#x4E2D;&#x6B62;&#12377;&#x308B;  <pr>&#12385;&#12421;&#12358;&#12375;&#12377;&#x308B;</pr></trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>vyvola&tcaron; potrat</trd>,
    <trd>zapr&iacute;&ccaron;ini&tcaron; fiasko</trd>
  </trdgrp>
  <trdgrp lng="zh">
