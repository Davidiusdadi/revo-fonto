<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: bogomil.xml,v 1.5 2022/10/12 19:35:49 revo Exp $">
<kap>
  <rad>bogomil</rad>/o <fnt><bib>NePiv</bib></fnt>
</kap>

<drv mrk="bogomil.0o">
  <kap><tld/>o</kap>
  <snc mrk="bogomil.0o.HIS">
    <uzo tip="fak">HIS</uzo>
    <uzo tip="fak">REL</uzo>
    <dif>
      Ano de kristandevena sekto prosperinta en Oriente&ubreve;ropo de la fino
      de
      la 10a jarcento &gcirc;is la 12a jarcento:
      <ekz>
        islamaj lo&gcirc;antoj en Bosnio estis origine kristanoj de <ind><tld
        lit="B"/>a Sekto</ind>
        <fnt><bib>HomojMan&gcirc;antaj</bib>, <lok>&leftquot;diversaj man&gcirc;otabloj&rightquot;, p.
        101a</lok></fnt>.
        <trd lng="ca">bogomilisme</trd>
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x516C;&#x5143;10&#x4E16;&#x7EAA;&#x672B;&#x81F3;12&#x4E16;&#x7EAA;&#x5728;&#x4E1C;&#x6B27;&#x5174;&#x76DB;&#x7684;&#x4E00;&#x4E2A;&#x57FA;&#x7763;&#x6559;&#x6D3E;&#x7684;&#x6210;&#x5458;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A member of a sect of Christian origin that flourished in Eastern Europe from the end of the 10th century to the 12th century.</dif>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_g;&c_a;&c_m;&c_ib;&c_l;</trd>
  <trd lng="bg">&c_b;&c_o;&c_g;&c_o;&c_m;&c_i;&c_l;</trd>
  <trd lng="ca">bogomil</trd>
  <trd lng="de">Bogomile</trd>
  <trd lng="en" kod="HIS" fnt="AI: de fr ca bg ru; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">Bogomil <klr>(historical)</klr></trd>
  <trd lng="fr">bogomile</trd>
  <trd lng="ru">&c_b;&c_o;&c_g;&c_o;&c_m;&c_i;&c_l;</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: de fr ru; proponis gpt-5.6-luna; taksis Jev 90%">&#x535A;&#x6208;&#x7C73;&#x723E;&#x6D3E;&#x6210;&#x54E1;</trd>,
    <trd fnt="AI: de fr ru; proponis gpt-5.6-luna; taksis Jev 90%">&#x535A;&#x6208;&#x7C73;&#x5C14;&#x6D3E;&#x6210;&#x5458;</trd>
  </trdgrp>
</drv>
</art>

