<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: fanerozoik.xml,v 1.9 2025/03/21 20:29:46 revo Exp $">
<kap>
  <rad>fanerozoik</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="fanerozoik.0o">
  <kap><tld/>o</kap>
  <snc mrk="fanerozoik.0o.GEOL">
    <uzo tip="fak">GEOL</uzo>
    <dif>
      La 3a <ref tip="super" cel="eon.0o.GEOL">eono</ref>
      ampleksanta la geologiajn tempojn de la komenco de
      <ref tip="sub" cel="paleozoik.0o.GEOL">paleozoiko</ref> &gcirc;is
      nun; <tld/>o da&ubreve;ras proksimume de 600 milionoj da jaroj.
      <ekz>
        dum <tld/>o la spuroj de vivo estas abundaj
        <fnt><bib>PIV2</bib></fnt>.
      </ekz>
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Das dritte &Auml;on, das die geologischen Zeiten vom Beginn des Pal&auml;ozoikums bis heute umfasst; das Phanerozoikum dauert seit etwa 600 Millionen Jahren an.</dif>
    <ref tip="sub" cel="mezozoik.0o.GEOL">mezozoiko</ref>
    <ref tip="sub" cel="kenozoik.0o.GEOL">kenozoiko</ref>
  </snc>
  <trdgrp lng="be">
    <trd>&c_f;&c_a;&c_n;&c_e;&c_r;&c_a;&c_z;&c_o;&c_j;</trd>,
    <trd>&c_f;&c_a;&c_n;&c_e;&c_r;&c_a;&c_z;&c_o;&c_j;&c_s;&c_k;&c_ib; &c_e;&c_o;&c_n;</trd>
  </trdgrp>
  <trd lng="ca">fanerozoic</trd>
  <trd lng="de" fnt="AI: fr pl pt ca; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Phanerozoikum</trd>
  <trd lng="en" fnt="AI: fr pt ca pl; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Phanerozoic</trd>
  <trd lng="fr">Phan&eacute;rozo&iuml;que</trd>
  <trd lng="pl">fanerozoik</trd>
  <trd lng="pt">Faneroz&oacute;ico</trd>
  <trd lng="uk">&c_f;&c_a;&#x43D;&c_je;&c_r;&#x43E;&c_z;&#x43E;&c_j;</trd>
  <trd lng="zh">&#x663E;&#x751F;&#x5B99; <pr>xi&#x1CE;nsh&emacron;ngzh&#xF2;u</pr></trd>
</drv>
</art>
