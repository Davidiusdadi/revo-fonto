<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: martinik.xml,v 1.3 2026/07/17 15:28:03 afido Exp $">
    <kap>
      <ofc>10</ofc><rad>Martinik</rad>/o
    </kap>

<drv mrk="martinik.0o">
  <kap><ofc>10</ofc><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      <ref tip="lst" lst="voko:insuloj" cel="insul.0o.GEOG">Insulo</ref> de
      <ref tip="malprt" cel="antil.Malgrandaj_0oj">Malgrandaj Antiloj</ref>, inter
      <ref tip="prt" cel="dominik1.0o">Dominiko</ref> kaj
      <ref tip="prt" cel="luci.Sankta_0o">Sankta Lucio</ref>:
      <ekz>
        vizito de insulo post insulo! Trinidado, Barbados, <tld/>o
        <fnt>
          <bib>ChV</bib>
          <lok>16</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Martinique</trd>
    <trd lng="en">Martinique</trd>
    <trd lng="fr">Martinique</trd>
    <trd lng="pl">Martynika</trd>
    <trdgrp lng="zh">
      <trd fnt="Vikt: zh en fr; taksis Jev 93%">&#x99AC;&#x63D0;&#x5C3C;&#x514B; <pr>M&#x01CE;t&iacute;n&iacute;k&egrave;</pr></trd>,
      <trd fnt="Vikt: zh en fr; taksis Jev 93%">&#x9A6C;&#x63D0;&#x5C3C;&#x514B; <pr>M&#x01CE;t&iacute;n&iacute;k&egrave;</pr></trd>,
      <trd fnt="Vikt: zh; taksis Jev 88%">&#x99AC;&#x4E01;&#x5C3C;&#x514B; <pr>M&#x01CE;d&#x012B;ngn&iacute;k&egrave;</pr></trd>,
      <trd fnt="Vikt: zh; taksis Jev 88%">&#x9A6C;&#x4E01;&#x5C3C;&#x514B; <pr>M&#x01CE;d&#x012B;ngn&iacute;k&egrave;</pr></trd>
    </trdgrp>
  </snc>
<trd lng="be">&c_M;&c_a;&c_r;&c_t;&c_y;&c_n;&c_ib;&c_k;&c_a;</trd>
</drv>

<drv mrk="martinik.0a">
  <kap>
    <ofc>10</ofc><tld lit="m"/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o, &gcirc;iaj lo&gcirc;antaj kaj ties gvadelupa lingvo.
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Bezogen auf Martinique, seine Bewohner und deren guadeloupische Sprache.</dif>
  </snc>
   <trd lng="be">&c_m;&c_a;&c_r;&c_t;&c_y;&c_n;&c_ib;&c_k;&c_a;&c_n;&c_s;&c_k;&c_ib;</trd>
   <trd lng="de" fnt="AI: pl be; proponis claude-opus-5-5; kontrolis claude-opus-5-5; serĉo">martiniquisch</trd>
   <trd lng="pl">martynika&nacute;ski</trd>
</drv>

<drv mrk="martinik.0ano">
  <kap>
    <ofc>10</ofc> <tld lit="m"/>ano
  </kap>
  <snc>
    <dif>
      Insulano de <tld/>o.
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Bewohner der Insel Martinique.</dif>
  </snc>
    <trd lng="be">&c_m;&c_a;&c_r;&c_t;&c_y;&c_n;&c_ib;&c_k;&c_a;&c_n;&c_je;&c_c;</trd>
    <trd lng="de" fnt="AI: pl be; proponis claude-opus-5-5; kontrolis claude-opus-5-5; serĉo">Martiniquer</trd>
    <trd lng="pl">Martynikanin</trd>
</drv>
</art>

