<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: janki.xml,v 1.5 2026/06/06 08:48:56 revo Exp $">
<kap>
  <rad>janki</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="janki.0o">
  <kap><tld/>o</kap>
  <snc mrk="janki.0o.ETN">
    <dif>
      <ref tip="dif" cel="uson.0ano.GEOG">Usonano</ref>;
      en Usono precipe iu el la nordorienta parto de la lando::
      <ekz>
        la <tld/>oj ne devis akiri siajn sidlokojn same kiel mi;
        sendube ili sciis, kiam estas sa&gcirc;e lasi fali kelkajn dolarojn
        <fnt>
          <aut>T. Steele</aut>
          <vrk>Konvinka Kamufla&jcirc;o</vrk>
          <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd fnt="Vikt: de en zh; juĝis claude-opus-5">Yankee</trd>,
      <trd fnt="Vikt: en zh; juĝis claude-opus-5">Ami <klr>[ugs.]</klr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_ja;&c_n;&c_k;&c_ib; <klr>(&c_a;&c_m;&c_e;&c_r;&c_y;&c_k;&c_a;&c_n;&c_je;&c_c;)</klr></trd>
  <trd lng="en">yankee</trd>
  <trd lng="es">yanqui</trd>
  <trdgrp lng="fr">
    <trd>yanquee</trd>,
    <trd>yanqui</trd>
  </trdgrp>
  <trd lng="pl">jankes</trd>
  <trd lng="uk">&#x44F;&#x43D;&#x43A;&c_ib;</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: zh en; taksis Jev 86%">&#x6D0B;&#x57FA; <pr>Y&aacute;ngj&#x012B;</pr></trd>,
    <trd fnt="Vikt: zh en; taksis Jev 66%">&#x7F8E;&#x570B;&#x4F6C; <pr>M&ecaron;igu&oacute;l&#x01CE;o</pr></trd>,
    <trd fnt="Vikt: zh en; taksis Jev 66%">&#x7F8E;&#x56FD;&#x4F6C; <pr>M&ecaron;igu&oacute;l&#x01CE;o</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 87%">&#x63DA;&#x57FA; <pr>Y&aacute;ngj&#x012B;</pr></trd>
  </trdgrp>
</drv>
</art>

