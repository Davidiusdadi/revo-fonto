<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ekspektor.xml,v 1.10 2025/03/29 13:06:04 revo Exp $">
<kap>
  <rad>ekspektor</rad>/i <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="ekspektor.0i">
  <kap><tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="ekspektor.0i.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      El<ref tip="vid" cel="sput.0i.FIZL">sputi</ref>
      embarasa&jcirc;ojn, 
      mukon el la spirtuboj:
      <ekz>
        kapitano van To&hcirc; <tld/>is. <ctl>Kaj ... kiel ili aspektas?</ctl>
        <fnt>
        <bib>Salamandroj</bib>,
        <lok>libro 1a, &ccirc;apitro 1a</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">To spit out obstructive matter or mucus from the respiratory tract.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">St&ouml;rende Absonderungen, Schleim aus den Atemwegen ausspucken.</dif>
  </snc>
  <rim>
    La&#365; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>kra&#265;i</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_a;&c_d;&c_h;&c_a;&c_r;&c_k;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_h;&c_a;&c_r;&c_k;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="ca">expectorar</trd>
  <trdgrp lng="cs">
    <trd>odka&scaron;lat <klr>(pr&#367;du&scaron;kov&#253; hlen)</klr></trd>,
    <trd>vyka&scaron;lat</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd fnt="AI: cs sk pl uk; proponis claude-opus-5-5; kontrolis claude-opus-5-5">abhusten</trd>,
    <trd kod="FAK" fnt="AI: fr it pt ca; proponis claude-opus-5-5; kontrolis claude-opus-5-5">expektorieren <klr>(fachspr.)</klr></trd>
  </trdgrp>
  <trd lng="en" kod="FAK" fnt="AI: ca fr it pt dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">expectorate <klr>(jargon)</klr></trd>
  <trd lng="fr">expectorer</trd>
  <trd lng="it">espettorare</trd>
  <trdgrp lng="pl">
    <trd>wykrztusi&cacute;</trd>,
    <trd>charka&cacute;<klr> (wulg.)</klr></trd>
  </trdgrp>
  <trd lng="pt">expectorar</trd>
  <trdgrp lng="sk">
    <trd>odka&scaron;la&tcaron;</trd>,
    <trd>vyka&scaron;la&tcaron;</trd>
  </trdgrp>
  <trd lng="uk">&c_v;&c_ib;&c_d;&c_h;&c_a;&c_r;&#1082;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
</drv>
</art>

