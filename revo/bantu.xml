<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: bantu.xml,v 1.10 2025/01/23 10:32:04 revo Exp $">
    <kap><ofc>10</ofc>
      <rad>bantu</rad>/o
      <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="bantu.0o">
  <kap><ofc>10</ofc> <tld/>o</kap>
  <snc>
  <uzo tip="fak">LIN</uzo>
    <dif>
      Iu el mult<ref tip="lst" lst="voko:popolanoj" cel="etn.0o">etn</ref>a grupo
      de suda parto de <ref tip="malprt" cel="afrik.A0o.mondparto">Afriko</ref>,
      karakterizata de parenca lingvaro:
      <ekz>
        la <tld/>-lingvoj
        <fnt>
          <aut>Werner Fu&szlig;</aut>
          <vrk><url ref="www.esperanto-muenchen.de/prelegoj/prelego1_wf.pps">Lingvofamilioj,
          migradoj de popoloj  kaj genetikaj
              parencecoj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x5357;&#x90E8;&#x975E;&#x6D32;&#x4E00;&#x4E2A;&#x591A;&#x6C11;&#x65CF;&#x7FA4;&#x4F53;&#x4E2D;&#x7684;&#x6210;&#x5458;&#xFF0C;&#x8BE5;&#x7FA4;&#x4F53;&#x4EE5;&#x4E00;&#x7EC4;&#x6709;&#x4EB2;&#x7F18;&#x5173;&#x7CFB;&#x7684;&#x8BED;&#x8A00;&#x4E3A;&#x7279;&#x5F81;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A member of a multi-ethnic group in southern Africa characterised by a family of related languages.</dif>
    <ref tip="sub" cel="zulu.0o">zuluo</ref>
    <trd lng="de">Bantu</trd>
    <trd lng="en" fnt="AI: de fr pl ro; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">Bantu <klr>(derogatory)</klr></trd>
    <trd lng="fr">Bantou</trd>
    <trd lng="pl">Bantu</trd>
    <trd lng="ro">Bantu</trd>
    <trd lng="uk">&c_b;&c_a;&c_n;&c_t;&c_u;</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de fr ref; proponis gpt-5.6-luna; taksis Jev 93%">&#x73ED;&#x5716;&#x4EBA;</trd>,
      <trd fnt="AI: en de fr ref; proponis gpt-5.6-luna; taksis Jev 93%">&#x73ED;&#x56FE;&#x4EBA;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_n;&c_t;&c_u;</trd>
  <trd lng="ja">&#12496;&#12531;&#12488;&#12453;&#12540;&#20154;  <pr>&#12496;&#12531;&#12488;&#12453;&#12540;&#12376;&#12435;</pr></trd>
</drv>

<drv mrk="bantu.0a">
  <kap>
    <ofc>10</ofc> <tld/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>oj, aparte iliaj lingvoj:
      <ekz>
        li tre bone parolas almena&ubreve; la &ccirc;efajn <tld/>ajn lingvojn
        <fnt>
          <bib>ChC</bib>
          <lok>20</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[la]</klr> burunda lingvo <klr>[&#8230;]</klr> estas <tld/>a
        lingvo parolata de &ccirc;irka&ubreve; 6 milionoj da homoj, &ccirc;efe en Burundo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=28716">Burunda lingvo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 88%">&#x4E0E;&#x73ED;&#x56FE;&#x4EBA;&#x6709;&#x5173;&#x7684;&#xFF0C;&#x5C24;&#x5176;&#x662F;&#x4E0E;&#x5176;&#x8BED;&#x8A00;&#x6709;&#x5173;&#x7684;&#x3002;</dif>
    <trd lng="de" fnt="Vikt: fr; juĝis claude-opus-5">Bantu</trd>
    <trd lng="en" fnt="Vikt: fr; juĝis claude-opus-5">Bantu</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de fr ref; proponis gpt-5.6-luna; taksis Jev 92%">&#x73ED;&#x5716;&#x7684;</trd>,
      <trd fnt="AI: en de fr ref; proponis gpt-5.6-luna; taksis Jev 92%">&#x73ED;&#x56FE;&#x7684;</trd>
    </trdgrp>
  </snc>
<trdgrp lng="be">
  <trd>&c_b;&c_a;&c_n;&c_t;&c_u; <klr>(&c_p;&c_r;&c_y;&c_m;.)</klr></trd>,
  <trd>&c_s;&c_ja;&c_m;&#8217;&c_ib; <ind>&c_b;&c_a;&c_n;&c_t;&c_u;</ind></trd>
</trdgrp>
</drv>

  </art>

