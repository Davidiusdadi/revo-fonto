<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: banjan.xml,v 1.7 2025/03/02 11:21:23 revo Exp $">
<kap>
  <rad>banjan</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="banjan.0o">
  <kap><tld/>o</kap>
  <snc mrk="banjan.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      Epifita arbo hinddevena, kiu plejofte komence
      pendigas radikojn de la bran&ccirc;oj de la gastarbo,
      poste radikas kaj tre vasti&gcirc;as;
      specio el genro
      <ref tip="super" cel="fig.0arbo">figarbo</ref>
      (<trd lng="la">Ficus benghalensis</trd>):
      <ekz>
        en la ombro de giganta <tld/>o estis templeto
        <fnt>
          <aut>Ba Jin, trad. Li Shijun</aut>,
          <vrk>A&ubreve;tuno en la Printempo</vrk>,
          <lok>1980</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 80%">&#x4E00;&#x79CD;&#x539F;&#x4EA7;&#x4E8E;&#x5370;&#x5EA6;&#x7684;&#x9644;&#x751F;&#x6811;&#xFF0C;&#x901A;&#x5E38;&#x5148;&#x4ECE;&#x5BC4;&#x4E3B;&#x6811;&#x7684;&#x679D;&#x6761;&#x4E0A;&#x5782;&#x4E0B;&#x6839;&#xFF0C;&#x968F;&#x540E;&#x624E;&#x6839;&#x5E76;&#x5927;&#x5E45;&#x6269;&#x5C55;&#xFF1B;&#x6995;&#x5C5E;&#x7684;&#x4E00;&#x79CD;&#xFF08;Ficus benghalensis&#xFF09;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An epiphytic tree native to India that usually begins by sending down roots from the branches of its host tree, then takes root and spreads very widely; a species of fig (Ficus benghalensis).</dif>
    <trdgrp lng="de">
      <trd fnt="Vikt: fr; juĝis claude-opus-5">Waringin</trd>,
      <trd fnt="Vikt: fr; juĝis claude-opus-5">Waringinbaum</trd>,
      <trd fnt="Vikt: fr; juĝis claude-opus-5">indischer Feigenbaum</trd>
    </trdgrp>
    <trd lng="zh" fnt="AI: dif ref; proponis gpt-5.6-luna; taksis Jev 91%">&#x5B5F;&#x52A0;&#x62C9;&#x6995; <pr>M&egrave;ngji&#x0101;l&#x0101; r&oacute;ng</pr></trd>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_n;&c_mol;&c_ja;&c_n;</trd>
  <trd lng="en">banyan</trd>
  <trdgrp lng="es">
    <trd>baniano</trd>,
    <trd>higuera de Bengala</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>banian</trd>,
    <trd>figuier des banians</trd>
  </trdgrp>
  <trd lng="he">&#x5E4;&#x5D9;&#x5E7;&#x5D5;&#x5E1; &#x5D4;&#x5D5;&#x5D3;&#x5D9;</trd>
  <trdgrp lng="pl">
    <trd>banian</trd>,
    <trd>figowiec bengalski</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_b;&c_a;&#x43D;&c_ib;&c_a;&#x43D;</trd>,
    <trd>&c_b;&c_a;&#x43D;&#x44C;&#x44F;&#x43D;</trd>,
    <trd>&c_b;&c_je;&#x43D;&c_gu;&c_a;&#x43B;&#x44C;&c_s;&#x44C;&#x43A;&c_i;&c_j; &c_f;&c_ib;&#x43A;&c_u;&c_s;</trd>
  </trdgrp>
</drv>
</art>

