<drv mrk="abisen.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Iu el <tld lit="A"/>ujo, regno de 12jc &gcirc;is 1974 sur nuna teritorio de
      <ref tip="prt" cel="etiop.E0ujo">Etiopujo</ref> kaj
      <ref tip="prt" cel="eritre.E0o">Eritreo</ref>:
      <ekz>
        Italio pravigis sian <tld/>an agadon per la argumento, ke ili intencas liberigi
        la <tld/>ojn de la subpremado kaj disvastigi inter ili la kulturon
        <fnt>
          <bib>VaK</bib>
          <lok>Unua &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        do vi estas perso, &ccirc;u? &dash; ne, mi estas <tld/>o
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 30</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Abbesinier</trd>
    <trd lng="en" kod="ARK" fnt="Vikt: pl ru; juĝis claude-opus-5">Abyssinian <klr>(dated)</klr></trd>
    <trd lng="pl">Abisy&nacute;czyk</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: de pl dif ref; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x963F;&#x6BD4;&#x897F;&#x5C3C;&#x4E9E;&#x4EBA; <pr>&#x0100;b&#x01D0;x&#x012B;n&iacute;y&agrave;r&eacute;n</pr></trd>,
      <trd fnt="AI: de pl dif ref; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x963F;&#x6BD4;&#x897F;&#x5C3C;&#x4E9A;&#x4EBA; <pr>&#x0100;b&#x01D0;x&#x012B;n&iacute;y&agrave;r&eacute;n</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_b;&c_ib;&c_s;&c_ib;&c_n;&c_je;&c_c;</trd>
  <trd lng="id">orang Abisinia</trd>
</drv>
