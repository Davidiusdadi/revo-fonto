<art mrk="$Id: amid.xml,v 1.11 2025/03/02 08:19:43 revo Exp $">
<kap>
    <rad>amid</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="amid.0o">
  <kap><tld/>o</kap>
  <snc mrk="amid.0o.KEM">
    <uzo tip="fak">KEM</uzo>
    <dif>
      Organika kombina&jcirc;o derivita el karbonacido, kun
      azota atomo ligita kun karbonila grupo:
      <ekz>
        niacino estas alia internacia nomo por nikotin-<tld/>o
        <fnt>
          <aut>D. Portmann, D. Pogers</aut>,
          <vrk><url ref="&STEB;kemio/doug-portmann/kemio-glosaro.htm">
          Glosaro</url></vrk>,
          <lok>en: Kemia kaj sciencteknika vortaro, 1993</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Organische Verbindung, abgeleitet von Kohlens&auml;ure, mit einem an eine Carbonylgruppe gebundenen Stickstoffatom</dif>
  </snc>
  <trd lng="be">&c_a;&c_m;&c_ib;&c_d;</trd>
  <trd lng="ca">amida</trd>
  <trd lng="cs">amid</trd>
  <trd lng="de" fnt="AI: en fr cs pl; proponis claude-opus-5-5; kontrolis claude-opus-5-5">Amid</trd>
  <trd lng="en">amide</trd>
  <trd lng="fr">amide</trd>
  <trd lng="pl">amid</trd>
  <trd lng="sk">amid</trd>
  <trd lng="uk">&c_a;&#x43C;&c_ib;&c_d;</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en fr pl dif; proponis gpt-5.6-luna; taksis Jev 93%">&#x91AF;&#x80FA; <pr>xi&#x0101;n'&agrave;n</pr></trd>,
    <trd fnt="AI: en fr pl dif; proponis gpt-5.6-luna; taksis Jev 93%">&#x9170;&#x80FA; <pr>xi&#x0101;n'&agrave;n</pr></trd>
  </trdgrp>
</drv>
</art>

