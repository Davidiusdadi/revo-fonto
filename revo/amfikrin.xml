<vortaro>
<art mrk="$Id: amfikrin.xml,v 1.8 2025/11/05 08:41:49 revo Exp $">
<kap>
    <rad>amfikrin</rad>/a
    <fnt>
      <aut>Vikipedio</aut>,
      <vrk><url
      ref="&Viki;/Glando">Glando</url></vrk>
    </fnt>
</kap>
<drv mrk="amfikrin.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">FIZL</uzo>
  <!-- nebezone distingi KOMUNE kaj FIZL, unue trovu ekz-ojn, kie distingo necesas
  <snc mrk="amfikrin.0a.KOMUNE">
  <uzo tip="stl">KOMUNE</uzo>
    <dif>
      Rilata al la <tld/>aj <ref tip="malprt"
      cel="gland.0o">glandoj</ref>.
    </dif>
  </snc>
  -->
  <snc mrk="amfikrin.0a.FIZL">
  <uzo tip="klr">(p.p. glando)</uzo>
    <dif>
      Kiu estas samtempe <ref tip="vid"
      cel="endokrin.0a.FIZL">endokrina</ref> kaj <ref tip="vid"
      cel="ekzokrin.0a.FIZL">ekzokrina</ref>, jen &ccirc;ar &gcirc;i enhavas amba&ubreve;
      tipojn da &ccirc;eloj (ekz. pankreato, gonadoj), jen &ccirc;ar &gcirc;iaj &ccirc;eloj
      havas
      amba&ubreve; funkciojn (ekz. hepato).
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x540C;&#x65F6;&#x5177;&#x6709;&#x5185;&#x5206;&#x6CCC;&#x548C;&#x5916;&#x5206;&#x6CCC;&#x6027;&#x8D28;&#x7684;&#xFF1A;&#x6216;&#x8005;&#x56E0;&#x4E3A;&#x542B;&#x6709;&#x4E24;&#x79CD;&#x7EC6;&#x80DE;&#xFF08;&#x4F8B;&#x5982;&#x80F0;&#x817A;&#x3001;&#x6027;&#x817A;&#xFF09;&#xFF0C;&#x6216;&#x8005;&#x56E0;&#x4E3A;&#x5176;&#x7EC6;&#x80DE;&#x5177;&#x6709;&#x4E24;&#x79CD;&#x529F;&#x80FD;&#xFF08;&#x4F8B;&#x5982;&#x809D;&#x810F;&#xFF09;&#x3002;</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Von einer Dr&uuml;se: gleichzeitig endokrin und exokrin, sei es, weil sie beide Zelltypen enth&auml;lt (z. B. Bauchspeicheldr&uuml;se, Keimdr&uuml;sen), sei es, weil ihre Zellen beide Funktionen haben (z. B. Leber).</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: en fr; proponis gpt-5.6-luna; taksis Jev 82%">&#x5169;&#x5206;&#x6CCC;&#x7684;</trd>,
      <trd fnt="AI: en fr; proponis gpt-5.6-luna; taksis Jev 82%">&#x4E24;&#x5206;&#x6CCC;&#x7684;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_m;&c_f;&c_ib;&c_k;&c_r;&c_y;&c_n;&c_n;&c_y;</trd>
  <trd lng="de" fnt="AI: en fr pl; proponis claude-opus-5-5; kontrolis claude-opus-5-5; serĉo">amphikrin</trd>
  <trd lng="en">amphicrine</trd>
  <trd lng="fr">amphicrine</trd>
  <trd lng="pl">amfikryna</trd>
</drv>
</art>

