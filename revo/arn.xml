<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: arn.xml,v 1.7 2024/09/02 21:26:13 afido Exp $">
  <kap>
    <rad>Arn</rad>/o
    <fnt><bib>PIV1</bib></fnt>
  </kap>

<drv mrk="arn.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">GEOG</uzo>
    <dif>
      <ref tip="lst" lst="voko:riveroj" cel="river.0o.GEOG">Rivero</ref>
      en la nordo de Toskano, &ccirc; 240&#x202F;km longa, trafluanta
      <ref cel="florenc.0o">Florenco</ref>n:
      <ekz>
        li ne sciis, &ccirc;u li devas &jcirc;eti sin en <tld/>on a&ubreve; iri hejmen kaj &ccirc;ion konfesi
        <fnt>
          <bib>Fab1</bib>
          <lok>Kupra porko</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o fluas tra antikva parto de la urbo kaj ludas gravan rolon en &gcirc;ia
        historio, portante ri&ccirc;econ per komerco kaj malri&ccirc;econ pro oftaj inundoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=19410">Florenco</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x6258;&#x65AF;&#x5361;&#x7EB3;&#x5317;&#x90E8;&#x7684;&#x4E00;&#x6761;&#x6CB3;&#x6D41;&#xFF0C;&#x957F;&#x7EA6;240&#x516C;&#x91CC;&#xFF0C;&#x6D41;&#x7ECF;&#x4F5B;&#x7F57;&#x4F26;&#x8428;&#x3002;</dif>
    <rim>
      Arno estas anka&ubreve; vira nomo, vd <ref cel="arnold.0o">Arnoldo</ref>.
    </rim>
    <trd lng="be">&c_A;&c_r;&c_n;&c_o; <klr>(&c_r;&c_a;&c_k;&c_a; &c_w; &c_Ib;&c_t;&c_a;&c_l;&c_ib;&c_ib;)</klr></trd>
    <trd lng="de">Arno<klr> (Fluss)</klr></trd>
    <trd lng="en">Arno<klr> (river)</klr></trd>
    <trd lng="fr">Arno<klr> (fleuve)</klr></trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en ref; proponis gpt-5.6-luna; taksis Jev 95%">&#x963F;&#x723E;&#x8AFE;&#x6CB3; <pr>&#x0100;'&ecaron;rn&ograve; h&eacute;</pr></trd>,
      <trd fnt="AI: en ref; proponis gpt-5.6-luna; taksis Jev 95%">&#x963F;&#x5C14;&#x8BFA;&#x6CB3; <pr>&#x0100;'&ecaron;rn&ograve; h&eacute;</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="ja">&#x30A2;&#x30EB;&#x30CE;&#x5DDD; 
  <pr>&#x30A2;&#x30EB;&#x30CE;&#x304B;&#x308F;</pr></trd>
  <trd lng="pl">Arno</trd>
  <trd lng="uk">&c_A;&c_r;&#x43D;&#x43E;</trd>
</drv>
</art>

