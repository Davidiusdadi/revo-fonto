<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: arhxi.xml,v 1.4 2026/07/13 21:13:18 afido Exp $">
    <kap>
      <rad>ar&hcirc;i</rad>-
      <var><kap><rad var="k">arki</rad>- <fnt><bib>PIV1</bib></fnt></kap></var>
    </kap>

<drv mrk="arhxi.0">
  <kap><tld/>-, <var><kap><tld var="k"/>-</kap></var></kap>
  <uzo tip="stl">RAR</uzo>
  <snc>
    <dif>
      De supera rango, <ref tip="dif" cel="cxef.0">&ccirc;ef-</ref>:
      <ekz>
        <tld/>friponoj, protokanajloj
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto kvina</lok>
        </fnt>!
      </ekz>
      <ekz>
        en tiu impona renkonti&gcirc;o de la tutmonda ortodoksa eklezio partoprenos 15
        patriarkoj kaj <tld/>episkopoj
        <fnt>
          <bib>Monato</bib>
          <aut>Evgeni Georgiev</aut>
          <vrk>Grekio: Jarmila festego ortodoksa</vrk>
        </fnt>;
      </ekz>
      <ekz>
        vi devas fari&gcirc;i nia <tld/>&scirc;lamufo, nia &scirc;lamufestro, nia &scirc;lamufgeneralo
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Minejo de l' Bildoj</lok>
        </fnt>!
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x8868;&#x793A;&#x7B49;&#x7EA7;&#x9AD8;&#x3001;&#x9996;&#x8981;&#x7684;&#x3002;</dif>
    <refgrp tip="vid">
      <ref cel="arkidu.0o">ar&hcirc;iduko</ref>,
      <ref cel="arhxiepiskop.0o">ar&hcirc;iepiskopo</ref>
    </refgrp>
    <trd lng="de">Erz-</trd>
    <trd lng="en">arch-</trd>
    <trd lng="fr">arch-</trd>
    <trdgrp lng="pl">
      <trd>archi-</trd>,
      <trd>arcy-</trd>
    </trdgrp>
  </snc>
<trd lng="be">&c_a;&c_r;&c_h;&c_ib;-</trd>
</drv>
</art>

