<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: bok.xml,v 1.4 2026/03/13 15:42:57 afido Exp $">
    <kap>
      <rad>bok</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="bok.0o">
  <kap><tld/>o</kap>
  <snc mrk="bok.0o.kapro">
    <uzo tip="fak">ZOO</uzo><uzo tip="fak">AGR</uzo>
    <dif>
      Vira rema&ccirc;ulo (kapro, cervo):
      <ekz>
        Tibeta antilopino ne havas kornon, dum la <tld/>o havas paron da longaj kaj
        rektaj kornoj nigre brilantaj
        <fnt>
          <bib>EP&Ccirc;</bib>
          <vrk><url ref="http://www.espero.com.cn/old/epch/08h/08h-01/ziran1-6.htm"
              >Antilopo de Tibeto</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A male ruminant (goat, deer).</dif>
    <trdgrp lng="be">
      <trd>&c_k;&c_a;&c_z;&c_jo;&c_l;</trd>,
      <trd>&c_b;&c_a;&c_r;&c_a;&c_n;</trd>
    </trdgrp>
    <trdgrp lng="ca">
      <trd>boc</trd>,
      <trd>cabrot</trd>,
      <trd>cabr&oacute;</trd>
    </trdgrp>
    <trd lng="de">Bock <klr>(Tier)</klr></trd>
    <trd lng="en" fnt="AI: de ca; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">buck</trd>
  </snc>
  <snc>
    <uzo tip="fak">SPO</uzo><uzo tip="fak">KON</uzo>
    <dif>
      <ref tip="super" cel="stabl.0o.TEK">Stablo</ref> a&ubreve; simpla <ref tip="super"
      cel="benk.0o">benko</ref>;
      stirbenko de &ccirc;eval&ccirc;aro:
      <ekz>
        Ustimenko ordinare sidadis apud la ko&ccirc;ero, sur la <tld/>o
        <fnt>
          <aut>Jurij German, trad. Jurij Finkel</aut>
          <vrk><url ref="https://www.esperanto.mv.ru/German/afero-07-1.html"
              >La afero, al kiu vi servas</url></vrk>
          <lok>&ccirc;ap. 7, Ambulanco</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A trestle or simple bench; the driver's seat of a horse-drawn carriage.</dif>
    <bld
      lok="&WCU;/thumb/1/1e/Bundesarchiv_Bild_183-33533-0008%2C_Leipzig%2C_DHfK%2C_&Uuml;bung_am_Bock.jpg/250px-Bundesarchiv_Bild_183-33533-0008%2C_Leipzig%2C_DHfK%2C_&Uuml;bung_am_Bock.jpg"
      prm="CC BY-SA 3.0 de"
      >ekzercado per <ind>salt<tld/>o</ind>
      <trd lng="ca">cavall de salts</trd>
        <fnt>
          <aut>Bundesarchiv, Bild 183-33533-0008 / CC-BY-SA 3.0, This image was provided to
          Wikimedia Commons by the German Federal Archive (Deutsches Bundesarchiv) as part of a
          cooperation project. The German Federal Archive guarantees an authentic representation
          only using the originals (negative and/or positive), resp. the digitalization of the
          originals as provided by the Digital Image Archive.</aut>
          <lok><url
          ref="&WCW;/File:Bundesarchiv_Bild_183-33533-0008,_Leipzig,_DHfK,_%C3%9Cbung_am_Bock.jpg"
              >https://commons.wikimedia.org/wiki/File:Bundesarchiv_Bild_183-33533-0008,_Leipzig,_DHfK,_&Uuml;bung_am_Bock.jpg</url></lok>
        </fnt>
    </bld>
    <trdgrp lng="be">
      <trd>&c_k;&c_a;&c_z;&c_jo;&c_l; <klr>(&c_s;&c_p;&c_a;&c_r;&c_t;.)</klr></trd>,
      <trd>&c_k;&c_a;&c_z;&c_l;&c_y; <klr>(&c_p;&c_r;&c_y;&c_l;&c_a;&c_d;&c_a;)</klr></trd>,
      <trd>&c_s;&c_t;&c_a;&c_l;&c_ju;&c_g;&c_a;</trd>
    </trdgrp>
    <trd lng="ca">pescant<klr tip="amb"> (seient)</klr></trd>
    <trd lng="de">Bock<klr> (Kutsche, Ger&auml;t)</klr></trd>
    <trd lng="en">sawhorse</trd>
    <trd lng="fr">tr&eacute;teau</trd>
  </snc>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en ku; taksis Jev 58%">&#x96C4;&#x5C71;&#x7F8A; <pr>xi&oacute;ngsh&#x0101;ny&aacute;ng</pr></trd>,
    <trd fnt="Vikt: fr; taksis Jev 59%">&#x516C;&#x5C71;&#x7F8A; <pr>g&#x014D;ngsh&#x0101;ny&aacute;ng</pr></trd>,
    <trd fnt="Vikt: ru; taksis Jev 9%">&#x7F8A; <pr>y&aacute;ng</pr></trd>
  </trdgrp>
</drv>

  </art>

