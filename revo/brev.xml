    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x6BD4;&#x6559;&#x5B97;&#x8BCF;&#x4E66;&#x7B80;&#x77ED;&#x4E14;&#x4E0D;&#x90A3;&#x4E48;&#x5E84;&#x91CD;&#x7684;&#x6559;&#x5B97;&#x4FE1;&#x51FD;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A papal letter shorter and less solemn than a bull.</dif>
    <trd lng="de">Breve</trd>
