<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: anon.xml,v 1.13 2026/08/05 19:54:25 revo Exp $">
<kap>
  <rad>anon</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>

<drv mrk="anon.0o">
  <kap><tld/>o</kap>
  <snc mrk="anon.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      <ref tip="super" cel="frukt.0o.KUI">Frukto</ref>
      de kelkaj specioj de <tld/>arbo, mezgranda, kun verda &scirc;elo kaj
      blanka
       karno.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 87%">&#x67D0;&#x4E9B;&#x756A;&#x8354;&#x679D;&#x5C5E;&#x690D;&#x7269;&#x7684;&#x679C;&#x5B9E;&#xFF0C;&#x4E2D;&#x7B49;&#x5927;&#x5C0F;&#xFF0C;&#x679C;&#x76AE;&#x7EFF;&#x8272;&#xFF0C;&#x679C;&#x8089;&#x767D;&#x8272;&#x3002;</dif>
    <ref tip="sub" cel="pom.suker0o">sukerpomo</ref>
    <trd lng="zh" fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 88%">&#x756A;&#x8354;&#x679D; <pr>f&#x0101;nl&igrave;zh&#x012B;</pr></trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_n;&c_o;&c_n;&c_a; <klr tip="amb">(&c_p;&c_l;&c_o;&c_d;)</klr></trd>,
    <trd>&c_ch;&c_e;&c_r;&c_y;&c_m;&c_o;&c_ja; <klr tip="amb">(&c_p;&c_l;&c_o;&c_d;)</klr></trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Cherimoya</trd>,
    <trd>S&uuml;&szlig;sack</trd>
    <trd>Sauersack</trd>
  </trdgrp>
  <trd lng="en">cherimoya</trd>
  <trdgrp lng="es">
    <trd>anona</trd>,
    <trd>chirimoya</trd>
  </trdgrp>
  <trd lng="fr">anone</trd>
  <trd lng="hu">ann&oacute;na</trd>
  <trd lng="nl">cherimoya<klr tip="ind"> (vrucht)</klr></trd>
  <trd lng="uk">&c_a;&#x43D;&#x43E;&#x43D;&#x43D;&c_a;</trd>
</drv>

<drv mrk="anon.0arbo">
  <kap><tld/>arbo, <var><kap><tld/>ujo</kap></var></kap>
  <snc mrk="anon.0arbo.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
       Monta <ref tip="lst" cel="arb.0o" lst="voko:magnolioparencoj">arbo</ref>
       kreskanta en tropikaj kaj subtropikaj regionoj,
       kies kelkaj specioj estas kultivataj pro la fruktoj, ekz.
       <trd lng="la">Annona cherimola</trd>, <trd lng="la">Annona
       squamosa</trd> kaj
       <trd lng="la">Annona muricata</trd>;
       <ref tip="lst" cel="genr.0o.BIO" lst="voko:botanikaj_genroj">genro</ref>
        el familio <ref tip="malprt" cel="anonac.0oj">anonacoj</ref>
      (<trd lng="la">Annona</trd>):
      <ekz>
        <ctl>mi fartas bone, Ariero</ctl>, diras Tomegino, kiu sidas
        sur la <tld/>arbo
        <fnt>
        <aut>A. Lef&oacute;nst Sardi&ntilde;as, trad. J. de Jes&uacute;s Campos
        Pacheco</aut>,
        <vrk><url ref="http://membres.lycos.fr/vilhelmo/Kuba_infanliteraturo.html">
        Kuba infanliteraturo</url>, En la montaro</vrk>,
        <lok>1999-2002</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A tree growing in mountainous regions of the tropics and subtropics, some species of which are cultivated for their fruit, e.g. Annona cherimola, Annona squamosa and Annona muricata; a genus of the custard-apple family (Annona).</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Baum der Bergregionen der Tropen und Subtropen, von dem einige Arten wegen ihrer Fr&uuml;chte angebaut werden; Gattung aus der Familie der Annonengew&auml;chse.</dif>
    <trd lng="zh">&#x523A;&#x679C;&#x756A;&#33620;&#x679D;
    <pr>c&#xEC;gu&#x1D2;f&amacron;nl&#xEC;zh&#x12B;</pr></trd>
</snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_n;&c_o;&c_n;&c_a; <klr tip="amb">(&c_r;&c_a;&c_s;&c_mol;&c_l;&c_ib;&c_n;&c_a;)</klr></trd>,
    <trd>&c_ch;&c_e;&c_r;&c_y;&c_m;&c_o;&c_ja; <klr tip="amb">(&c_r;&c_a;&c_s;&c_mol;&c_l;&c_ib;&c_n;&c_a;)</klr></trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Cherimoyabaum</trd>,
    <trd>Zimtapfelbaum</trd>,
    <trd>Stachelannone</trd>
  </trdgrp>
  <trd lng="en" fnt="AI: de es fr hu nl; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">annona</trd>
  <trd lng="es">chirimoyo</trd>
  <trd lng="fr">anonier</trd>
  <trdgrp lng="hu">
    <trd>cserimoj&oacute;fa</trd>,
    <trd>kr&eacute;malmafa</trd>
  </trdgrp>
  <trd lng="nl">cherimoya<klr tip="ind"> (boom)</klr></trd>
</drv>
</art>

