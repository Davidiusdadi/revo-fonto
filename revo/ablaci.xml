<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ablaci.xml,v 1.16 2025/03/24 19:26:35 revo Exp $">
<kap>
  <rad>ablaci</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="ablaci.0o">
  <kap><tld/>o</kap>
  <snc mrk="ablaci.0o.SCI">
    <uzo tip="fak">SCI</uzo>
    <dif>
      Forigo de materialo.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x6750;&#x6599;&#x7684;&#x53BB;&#x9664;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Removal of material.</dif>
    <subsnc mrk="ablaci.0o.GEOL">
      <uzo tip="fak">GEOL</uzo>
      <dif>
        Surfaca <ref tip="vid" cel="erozi.0o">erozio</ref>:
        <ekz>
          <tld/>o estas masperdo de la gla&ccirc;ero dum la metamorfozproceso
          <fnt>
            <bib>Viki</bib>,
            <vrk><url ref="&Viki;/Gla%C4%89ero#Ablacio">Gla&ccirc;ero</url></vrk>
          </fnt>.
        </ekz>
      </dif>
      <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x8868;&#x9762;&#x4FB5;&#x8680;&#x3002;</dif>
      <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Surface erosion.</dif>
      <ref tip="vid" cel="abrazi.0o">abrazio</ref>
      <trd lng="de">Abschmelzen</trd>
      <trdgrp lng="zh">
        <trd>&#28040;&#34645; <pr>xiāo yíng</pr></trd>,
        <trd>&#28040;&#34432; <pr>xiāo yíng</pr></trd>
      </trdgrp>
    </subsnc>
    <subsnc mrk="ablaci.0o.MED">
      <uzo tip="fak">MED</uzo>
      <uzo tip="fak">KIR</uzo>
      <dif>
        <ref tip="vid" cel="hxirur.0a.MED">&Hcirc;irurgia</ref> forigo:
        <ekz>
          <tld/>o de tumora histo;
        </ekz>
        <ekz>
          <uzo tip="stl">FIG</uzo>
          sen tia drasta <tld/>o la morto de UEA &scirc;ajnas certa
          <fnt>
            <vrk><url ref="https://www.esperantio.net/index.php?id=3888">Du domoj en komparo:
            nederlanda kaj svisa</url></vrk>
            <lok>HeKo 717 1-A, 25a a&ubreve;g. 2019</lok>
          </fnt>.
        </ekz>
      </dif>
      <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x5916;&#x79D1;&#x5207;&#x9664;&#x3002;</dif>
      <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Surgical removal.</dif>
      <rim>
        La&#365; <fnt><bib>BL</bib></fnt>: (en operacio) prefere diru <ke>forigo</ke>, <ke>fortran&#265;o</ke>.
      </rim>
      <trd lng="de">Ver&ouml;dung</trd>
      <trd lng="zh" fnt="AI: en de dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x6D88;&#x878D;</trd>
    </subsnc>
    <subsnc mrk="ablaci.0o.AST">
      <uzo tip="fak">AST</uzo>
      <dif>
        <ref tip="vid" cel="erozi.0o">Erozio</ref> a&ubreve; elvapori&gcirc;o
        pro frotado tra la atmosfero a&ubreve; radiado.
      </dif>
      <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x7531;&#x4E8E;&#x7A7F;&#x8D8A;&#x5927;&#x6C14;&#x5C42;&#x65F6;&#x7684;&#x6469;&#x64E6;&#x6216;&#x8F90;&#x5C04;&#x9020;&#x6210;&#x7684;&#x4FB5;&#x8680;&#x6216;&#x84B8;&#x53D1;&#x3002;</dif>
      <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Erosion or evaporation caused by friction during passage through the atmosphere, or by radiation.</dif>
    </subsnc>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_b;&c_l;&c_ja;&c_c;&c_y;&c_ja;</trd>,
    <trd>&c_z;&c_m;&c_y;&c_w;</trd>
  </trdgrp>
  <trd lng="ca">ablaci&oacute;</trd>
  <trdgrp lng="cs">
    <trd>ablace</trd>,
    <trd>kon&ccaron;etiny</trd>,
    <trd>odn&ecaron;t&iacute; tk&aacute;n&ecaron;</trd>,
    <trd>org&aacute;nu</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Ablation</trd>,
    <trd>Abtrag</trd>
  </trdgrp>
  <trd lng="en">ablation</trd>
  <trd lng="es">ablaci&oacute;n</trd>
  <trd lng="fr">ablation</trd>
  <trd lng="it">ablazione</trd>
  <trd lng="pl">ablacja</trd>
  <trd lng="ro">abla&#539;iune</trd>
  <trdgrp lng="sk">
    <trd>abl&aacute;cia</trd>,
    <trd>od&ncaron;atie tkaniva</trd>,
    <trd>org&aacute;nu</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_a;&c_b;&c_l;&c_ja;&c_c;&c_ib;&c_ja;</trd>,
    <trd>&c_v;&c_i;&c_d;&c_a;&c_l;&c_je;&c_n;&c_n;&c_ja; &c_o;&c_r;&c_g;&c_a;&c_n;&c_a;</trd>
  </trdgrp>
</drv>

<drv mrk="ablaci.0agxo">
 <kap><tld/>a a&gcirc;o
   <fnt><vrk>Astronomia Terminaro</vrk></fnt>
  </kap>
  <snc mrk="ablaci.0agxo.AST">
    <uzo tip="fak">AST</uzo>
    <dif>
      Tempoda&ubreve;ro ekde la fandi&gcirc;o de la vitra surfaco de
      aer&scirc;tono pro &gcirc;ia enirado tra la atmosfero.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x4ECE;&#x9668;&#x77F3;&#x56E0;&#x8FDB;&#x5165;&#x5927;&#x6C14;&#x5C42;&#x800C;&#x4F7F;&#x5176;&#x73BB;&#x7483;&#x8D28;&#x8868;&#x9762;&#x7194;&#x5316;&#x65F6;&#x8D77;&#x7B97;&#x7684;&#x4E00;&#x6BB5;&#x65F6;&#x95F4;&#x3002;</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Zeitdauer seit dem Schmelzen der glasigen Oberfl&auml;che eines Meteoriten bei seinem Eintritt in die Atmosph&auml;re.</dif>
  </snc>
  <trd lng="be">&c_t;&c_e;&c_r;&c_m;&c_ib;&c_n; <ind>&c_a;&c_b;&c_l;&c_ja;&c_c;&c_y;&c_ib;</ind></trd>
  <trd lng="ca">temps d'ablaci&oacute;</trd>
  <trd lng="en">ablation age</trd>
  <trd lng="it">tempo di ablazione</trd>
  <trd lng="pl">wiek lodowcowy</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: en dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x71D2;&#x8755;&#x5E74;&#x9F61;</trd>,
    <trd fnt="AI: en dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x70E7;&#x8680;&#x5E74;&#x9F84;</trd>
  </trdgrp>
</drv>
</art>
