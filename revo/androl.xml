<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: androl.xml,v 1.7 2024/10/17 18:36:26 revo Exp $">
<kap>
  <rad>androlog</rad>/o
</kap>
<drv mrk="androl.0o">
  <kap><tld/>o</kap>
  <snc mrk="androl.0o.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      <ref tip="super" cel="kurac.0isto">Kuracisto</ref>, kies fako
      estas <ref tip="vid" cel="androl1.0o"><tld/>io</ref>:
      <ekz>
        &gcirc;is tiam, tamen, <tld/>oj kaj iliaj pacientoj &ndash;
        kadre de
        ordinara anamnezo &ndash; povos klopodi konsideri tiun aspekton
        por
        klarigi la kialojn de ekzistantaj erekti&gcirc;aj problemoj
        <fnt>
          <aut>Roberto Pigro</aut>: <vrk>Armitaj &gcirc;is la dentoj
          &ndash; kontra&ubreve;
          impotenteco</vrk>, <bib>Monato</bib><lok>jaro 2013a, numero
          10a, p. 20a</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x4EE5;&#x7537;&#x79D1;&#x5B66;&#x4E3A;&#x4E13;&#x4E1A;&#x7684;&#x533B;&#x751F;&#x3002;</dif>
    <ref tip="sin" cel="androl1.0isto"><tld/>iisto.</ref>
    <rim>
      <ekz>Andrologo</ekz> kaj <ekz><tld/>iisto</ekz> (kiu ne
      trovi&gcirc;as
      en PIV) estas sinonimoj. Sed, pro la longeco de tiu lasta vorto,
      kaj pro la malagrabla duobla &rightquot;i&#8221;,
      <ekz><tld/>o</ekz> normale estas
      preferinda.
      <fnt>
        <bib>PMEG</bib>,
        <vrk><url
        ref="&PMEG;vortfarado/neoficialaj_afiksoj/sufiksoj/i.html">39.1.12.
        Neoficiala sufikso I</url></vrk>
      </fnt>.
    </rim>
    <trdgrp lng="zh">
      <trd fnt="AI: en ref; proponis gpt-5.6-luna; taksis Jev 93%">&#x7537;&#x79D1;&#x91AB;&#x751F; <pr>n&aacute;nk&#x0113; y&#x012B;sh&#x0113;ng</pr></trd>,
      <trd fnt="AI: en ref; proponis gpt-5.6-luna; taksis Jev 93%">&#x7537;&#x79D1;&#x533B;&#x751F; <pr>n&aacute;nk&#x0113; y&#x012B;sh&#x0113;ng</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_n;&c_d;&c_r;&c_o;&c_l;&c_ja;&c_g;</trd>
  <trdgrp lng="de">
    <trd>Androloge</trd>,
    <trd>M&auml;nnerarzt</trd>
  </trdgrp>
  <trd lng="en">andrologist</trd>
  <trd lng="es">andr&oacute;logo</trd>
  <trd lng="fi">andrologi</trd>
  <trd lng="fr">andrologue</trd>
  <trd lng="io">andrologo</trd>
  <trdgrp lng="it">
    <trd>andrologo</trd>,
    <trd>androloga</trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>androloog</trd>,
    <trd>mannenarts</trd>
  </trdgrp>
  <trd lng="pl">androlog</trd>
  <trdgrp lng="pt">
    <trd>andrologista</trd>,
    <trd>andr&oacute;logo</trd>
  </trdgrp>
  <trd lng="vo">manasanan</trd>
</drv>
</art>

