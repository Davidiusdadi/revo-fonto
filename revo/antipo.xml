<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: antipo.xml,v 1.26 2025/10/17 04:36:24 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>antipod</rad>/o
  <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="antipo.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">FIL</uzo><uzo tip="fak">HIS</uzo>
  <snc mrk="antipo.0o.homo">
    <dif>
      <klr>(la&ubreve; la antikvaj filozofoj postulantaj terglobon,
      t.e. Pitagoro, Platono, Cicerono kc)</klr>, la homoj lo&gcirc;antaj en la
      kontra&ubreve;a flanko de la terglobo, do kun la piedoj kontra&ubreve;e
      (greke: <nac>&alfa_psili;&ny;&tau;&jota_ton;</nac> = kontra&ubreve;, <nac>&pi;&omikron;&ypsilon_ton;&sigma_fina;</nac> =
      piedo, latinigite <trd lng="la">antipodes</trd>, do kontra&ubreve;pieduloj):
      <ekz>
        poste venas cito el A&ubreve;gustinus: &leftquot;instruo pri <tld/>oj estas nekonforma al la
        principoj de la religio, &ccirc;ar tio &ccirc;i signifus, ke ekzistas homoj, kiuj ne
        devenas de Adamo&#8230;&rightquot;
        <fnt>
          <bib>FK</bib>
        </fnt>;
      </ekz>
      <ekz>
        li malatentas pri vi, kvaza&ubreve; vi sidus &ccirc;e la <tld/>o
        <fnt>
          <bib>Lanti</bib>
        </fnt>;
      </ekz>
      <ekz>
        tri grupetoj de <nom>Esperantotur</nom> vizitis samtempe la &leftquot;<tld/>ojn&rightquot;
        <fnt>
          <bib>LOdE</bib>
          <vrk><url ref="&Tekstaro;?nomo=ondo-de-esperanto">Sesdek mil kilometroj per
          Esperanto</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 82%">&#x6839;&#x636E;&#x4E3B;&#x5F20;&#x5730;&#x7403;&#x4E3A;&#x7403;&#x4F53;&#x7684;&#x53E4;&#x4EE3;&#x54F2;&#x5B66;&#x5BB6;&#xFF08;&#x5373;&#x6BD5;&#x8FBE;&#x54E5;&#x62C9;&#x65AF;&#x3001;&#x67CF;&#x62C9;&#x56FE;&#x3001;&#x897F;&#x585E;&#x7F57;&#x7B49;&#xFF09;&#x7684;&#x8BF4;&#x6CD5;&#xFF0C;&#x5C45;&#x4F4F;&#x5728;&#x5730;&#x7403;&#x53E6;&#x4E00;&#x9762;&#x7684;&#x90A3;&#x4E9B;&#x4EBA;&#xFF0C;&#x56E0;&#x6B64;&#x53CC;&#x811A;&#x671D;&#x5411;&#x76F8;&#x53CD;&#x65B9;&#x5411;&#x7684;&#x4EBA;&#xFF08;&#x5E0C;&#x814A;&#x8BED;&#xFF1A;&alfa_psili;&ny;&tau;&jota_ton;&#xFF1D;&#x76F8;&#x53CD;&#xFF0C;&pi;&omikron;&ypsilon_ton;&sigma_fina;&#xFF1D;&#x811A;&#xFF0C;&#x62C9;&#x4E01;&#x5316;&#x4E3A; antipodes&#xFF0C;&#x610F;&#x4E3A;&#x53CC;&#x811A;&#x76F8;&#x53CD;&#x7684;&#x4EBA;&#xFF09;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">According to the ancient philosophers who posited a spherical Earth, i.e. Pythagoras, Plato, Cicero and others, the people living on the opposite side of the globe, hence with their feet opposite (Greek: &alfa_psili;&ny;&tau;&jota_ton; = opposite, &pi;&omikron;&ypsilon_ton;&sigma_fina; = foot, Latinised as antipodes, hence people with opposite feet).</dif>
    <trd lng="de">Antipode</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 83%">&#x5C0D;&#x8E60;&#x9EDE;&#x5C45;&#x6C11; <pr>du&igrave;zh&iacute;di&#x01CE;n j&#x016B;m&iacute;n</pr></trd>,
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 83%">&#x5BF9;&#x8DD6;&#x70B9;&#x5C45;&#x6C11; <pr>du&igrave;zh&iacute;di&#x01CE;n j&#x016B;m&iacute;n</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="antipo.0o.flanko">
    <dif>
      Lo&gcirc;regiono de tiuj &leftquot;kontra&ubreve;pieduloj&rightquot;; figurasence la kompleta kontra&ubreve;o de io:
      <ekz>
        la francaj doktrinoj, &ccirc;efe &gcirc;is 1908, estis la <tld/>oj de tiuj de la novaperinta
        Budape&scirc;ta Skolo
        <fnt>
          <bib>EeP</bib>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>e, en vintra A&ubreve;stralio, anka&ubreve; okazis luktoj, la plej belaj kaj grandaj
        someraj Olimpikaj Ludoj de amatoroj
        <fnt>
	<aut>Stefan Maul</aut>
	<vrk><url ref="&Monato;/2000/007252.php">Du mil</url></vrk>
	<bib>Monato</bib>
	<lok>2000/12, p. 25</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 86%">&#x90A3;&#x4E9B;&rightquot;&#x811A;&#x671D;&#x5411;&#x76F8;&#x53CD;&#x65B9;&#x5411;&#x7684;&#x4EBA;&#x201D;&#x5C45;&#x4F4F;&#x7684;&#x5730;&#x533A;&#xFF1B;&#x5F15;&#x7533;&#x4E49;&#x4E3A;&#x67D0;&#x4E8B;&#x7269;&#x7684;&#x5B8C;&#x5168;&#x76F8;&#x53CD;&#x9762;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">The region inhabited by those &#x2018;people with opposite feet&#x2019;; figuratively, the complete opposite of something.</dif>
    <trd lng="de">Gegenort</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x5C0D;&#x8E60;&#x9EDE; <pr>du&igrave;zh&iacute;di&#x01CE;n</pr></trd>,
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x5BF9;&#x8DD6;&#x70B9; <pr>du&igrave;zh&iacute;di&#x01CE;n</pr></trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_n;&c_t;&c_y;&c_p;&c_o;&c_d;</trd>,
    <trd>&c_d;&c_y;&c_ja;&c_m;&c_e;&c_t;&c_r;&c_a;&c_l;&c_mol;&c_n;&c_a; &c_p;&c_r;&c_o;&c_c;&c_ib;&c_l;&c_je;&c_g;&c_l;&c_y; &c_p;&c_u;&c_n;&c_k;&c_t;</trd>
  </trdgrp>
  <trd lng="bg">&c_a;&c_n;&c_t;&c_i;&c_p;&c_o;&c_d;</trd>
  <trdgrp lng="cs">
    <trd>antipod</trd>,
    <trd>protino&zcaron;ec</trd>,
    <trd>p&rcaron;en. odp&uring;rce</trd>
  </trdgrp>

  <trd lng="en">antipode</trd>
  <trd lng="es">ant&iacute;poda</trd>
  <trd lng="fa">&f_p;&a_A;&a_d;&f_p;&a_A;</trd>
  <trd lng="fr">antipode</trd>
  <trdgrp lng="he">
    <trd>&alef;&nun;&tet;&yod;&pe;&vav;&dalet;</trd>,
    <trd>&he;&tsadi;&dalet; &he;&shin;&nun;&yod; &shin;&lamed; &kaf;&dalet;&vav;&resh; &he;&alef;&resh;&ftsadi;</trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>antipoda</trd>,
    <trd>antipode</trd>
  </trdgrp>
  <trd lng="ja">&#23550;&#36448;&#22320;  <pr>&#12383;&#12356;&#12379;&#12365;&#12385;</pr></trd>
  <trd lng="nl">antipode</trd>
  <trd lng="ru">&c_a;&c_n;&c_t;&c_i;&c_p;&c_o;&c_d;</trd>
  <trdgrp lng="sk">
    <trd>antip&oacute;d</trd>,
    <trd>protichodec</trd>,
    <trd>protino&zcaron;ec</trd>,
    <trd>protivn&iacute;k</trd>
  </trdgrp>
  <trd lng="uk">&c_a;&c_n;&c_t;&c_i;&c_p;&c_o;&c_d;</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en; taksis Jev 85%">&#x5C0D;&#x8E60;&#x9EDE; <pr>du&igrave;zh&iacute;di&#x01CE;n</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 85%">&#x5BF9;&#x8E60;&#x70B9; <pr>du&igrave;zh&iacute;di&#x01CE;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="antipo.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Kontra&ubreve;flanka de la terglobo; figurasence tute <ref tip="super"
      cel="kontraux.0a.KOMUNE">kontra&ubreve;a</ref>:
      <ekz>
        se ni prenos infanon el kiu ajn lando a&ubreve; nacio kaj <klr>[&#8230;]</klr> edukados &gcirc;in
        inter personoj de nacio tute fremda kaj e&ccirc; <tld/>a por &gcirc;i, &gcirc;i parolados en la
        lingvo de tiu &ccirc;i nacio tiel same bonege kaj pure, kiel &ccirc;iu natura filo de tiu
        &ccirc;i nacio
        <fnt>
          <bib>EE</bib>
        </fnt>;
      </ekz>
      <ekz>
        dektrian fojon en iu <tld/>a Universala Kongreso
        <fnt>
          <bib>Kon11</bib>
          <aut>Istv&aacute;n Ertl</aut>
          <vrk>Tiel la mondo ...</vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 85%">&#x5730;&#x7403;&#x53E6;&#x4E00;&#x9762;&#x7684;&#xFF1B;&#x5F15;&#x7533;&#x4E49;&#x4E3A;&#x5B8C;&#x5168;&#x76F8;&#x53CD;&#x7684;&#x3002;</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 84%">&#x5C0D;&#x8E60;&#x7684; <pr>du&igrave;zh&iacute; de</pr></trd>,
      <trd fnt="AI: dif; proponis gpt-5.6-luna; taksis Jev 84%">&#x5BF9;&#x8DD6;&#x7684; <pr>du&igrave;zh&iacute; de</pr></trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_n;&c_t;&c_y;&c_p;&c_o;&c_d;&c_n;&c_y;</trd>,
    <trd>&c_p;&c_r;&c_o;&c_c;&c_ib;&c_l;&c_je;&c_g;&c_l;&c_y;</trd>,
    <trd>&c_s;&c_u;&c_p;&c_r;&c_a;&c_c;&c_mol;&c_l;&c_je;&c_g;&c_l;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>antipodick&yacute;</trd>,
    <trd>antipodn&iacute;</trd>,
    <trd>opa&ccaron;n&yacute;</trd>,
    <trd>protich&uring;dn&yacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>antipodisch</trd>,
    <trd>gegen&uuml;berstehend</trd>,
    <trd>gegens&auml;tzlich</trd>,
    <trd>kontr&auml;r</trd>,
  </trdgrp>
  <trd lng="en">antipodal</trd>
  <trd lng="fa">&a_m;&a_t;&a_D;&a_A;&a_d;</trd>
  <trd lng="id">antipodal</trd>
  <trdgrp lng="ja">
    <trd>&#23550;&#36448;&#30340;&#12394;  <pr>&#12383;&#12356;&#12379;&#12365;&#12390;&#12365;&#12394;</pr></trd>,
    <trd>&#27491;&#21453;&#23550;&#12398;  <pr>&#12379;&#12356;&#12399;&#12435;&#12383;&#12356;&#12398;</pr></trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_a;&c_n;&c_t;&c_i;&c_p;&c_o;&c_d;&c_n;&c_y;&c_j;</trd>,
    <trd>&c_p;&c_r;&c_o;&c_t;&c_i;&c_v;&c_o;&c_p;&c_o;&c_l;&c_o;&c_zh;&c_n;&c_y;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>antipodick&yacute;</trd>,
    <trd>antipodi&aacute;lny</trd>
  </trdgrp>
</drv>
</art>
