<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: acipenser.xml,v 1.29 2025/06/22 16:36:04 revo Exp $">
<kap>
  <rad>acipenser</rad>/o
  <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="acipenser.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:zoologiaj_genroj">Genro</ref> el familio
      <ref tip="malprt" cel="acipen1.0oj"><tld/>edoj</ref>
      (<trd lng="la">Acipenser</trd>) de grandaj primitivaj
      <ref tip="lst" cel="fisx.osto0oj" lst="voko:fi&scirc;oj">ostofi&scirc;oj</ref>,
      vivantaj en maroj de la norda duonsfero kaj frajantaj en riveroj;
      el la frajo de kelkaj &gcirc;iaj specioj oni faras
      <ref cel="kaviar.0o">kaviaron</ref>:
      <ekz>
        en Jenisejo vivas 55 specoj de fi&scirc;oj <klr>[&#8230;]</klr> ekzemple, la sib<klr>[e]</klr>ria
        <tld/>o, la sib<klr>[e]</klr>ria karpo ktp
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=25449">Jenisejo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x9C9F;&#x79D1;&#x4E2D;&#x5927;&#x578B;&#x539F;&#x59CB;&#x786C;&#x9AA8;&#x9C7C;&#x7684;&#x4E00;&#x4E2A;&#x5C5E;&#xFF08;Acipenser&#xFF09;&#xFF0C;&#x751F;&#x6D3B;&#x5728;&#x5317;&#x534A;&#x7403;&#x7684;&#x6D77;&#x6D0B;&#x4E2D;&#x5E76;&#x5728;&#x6CB3;&#x6D41;&#x4E2D;&#x4EA7;&#x5375;&#xFF1B;&#x5176;&#x82E5;&#x5E72;&#x7269;&#x79CD;&#x7684;&#x5375;&#x53EF;&#x5236;&#x6210;&#x9C7C;&#x5B50;&#x9171;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A genus of large primitive bony fish in the family Acipenseridae (Acipenser), living in seas of the Northern Hemisphere and spawning in rivers; caviar is made from the roe of some of its species.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Gattung aus der Familie der St&ouml;re mit gro&szlig;en, urt&uuml;mlichen Knochenfischen, die in den Meeren der Nordhalbkugel leben und in Fl&uuml;ssen laichen; aus dem Rogen einiger ihrer Arten wird Kaviar hergestellt.</dif>
        <refgrp tip="prt">
      <ref cel="sturg.0o">sturgo</ref>,
      <ref cel="sevrug.0o">sevrugo</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_a;&c_s;&c_je;&c_t;&c_r;</trd>
  <trdgrp lng="ca">
    <trd>esturi&oacute;</trd>,
    <trd>esterlet</trd>
  </trdgrp>
  <trd lng="cs">jeseter</trd>
  <trd lng="de">St&ouml;r</trd>
  <trd lng="en">sturgeon</trd>
  <trd lng="fr">esturgeon</trd>
  <trd lng="hu">tok(hal)</trd>
  <trd lng="id">sturgeon</trd>
  <trd lng="it">storione</trd>
  <trd lng="nl">steur</trd>
  <trd lng="no">st&oslash;r</trd>
  <trd lng="pl">jesiotr</trd>
  <trd lng="pt">acip&ecirc;nser</trd>
  <trd lng="ro">morun</trd>
  <trd lng="ru">&c_o;&c_s;&c_jo;&c_t;&c_r;</trd>
  <trd lng="sk">jeseter</trd>
  <trd lng="sv">st&ouml;r</trd>
  <trd lng="uk">&#x43E;&c_s;&c_je;&c_t;&c_je;&c_r;</trd>
  <trdgrp lng="zh">
    <trd fnt="Vikt: de en; taksis Jev 94%">&#x9C58;&#x9B5A; <pr>x&uacute;ny&uacute;</pr></trd>,
    <trd fnt="Vikt: de en; taksis Jev 94%">&#x9C9F;&#x9C7C; <pr>x&uacute;ny&uacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="acipenser.0formaj">
  <kap><tld/>formaj</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
      <ref tip="lst" cel="ord.0o.BIO" lst="voko:zoologiaj_ordoj">Ordo</ref> de <ref tip="malprt"
      cel="fisx.osto0oj">ostofi&scirc;oj</ref>
      (<trd lng="la">Acipenseriformes</trd>), kun parte kartilaga
      skeleto.
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x786C;&#x9AA8;&#x9C7C;&#x7684;&#x4E00;&#x4E2A;&#x76EE;&#xFF08;Acipenseriformes&#xFF09;&#xFF0C;&#x9AA8;&#x9ABC;&#x90E8;&#x5206;&#x4E3A;&#x8F6F;&#x9AA8;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">An order of bony fish (Acipenseriformes), with a partly cartilaginous skeleton.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Ordnung der Knochenfische mit teilweise knorpeligem Skelett.</dif>
  </snc>
  <trd lng="be">&c_a;&c_s;&c_je;&c_t;&c_r;&c_a;&c_p;&c_a;&c_d;&c_o;&c_b;&c_n;&c_y;&c_ja; <klr tip="amb">(&c_a;&c_t;&c_r;&c_a;&c_d;)</klr></trd>
  <trd lng="ca">acipenseriformes</trd>
  <trd lng="de">st&ouml;rartige Fische</trd>
  <trd lng="en" fnt="AI: la dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">Acipenseriformes</trd>
  <trd lng="fr">acipens&eacute;riformes</trd>
  <trd lng="hu">tokalak&uacute;ak</trd>
  <trd lng="it">storioniformi</trd>
  <trd lng="nl">steurachtigen</trd>
  <trd lng="pl">jesiotrokszta&lstroke;tne</trd>
  <trd lng="ru">&c_o;&c_s;&c_je;&c_t;&c_r;&c_o;&c_o;&c_b;&c_r;&c_a;&c_z;&c_n;&c_y;&c_je; <klr tip="amb">(&c_o;&c_t;&c_r;&c_ja;&c_d;)</klr></trd>
  <trd lng="sv">st&ouml;rartade fiskar</trd>
  <trdgrp lng="zh">
    <trd fnt="AI: la dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x9C58;&#x5F62;&#x76EE; <pr>x&uacute;nx&iacute;ngm&ugrave;</pr></trd>,
    <trd fnt="AI: la dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x9C9F;&#x5F62;&#x76EE; <pr>x&uacute;nx&iacute;ngm&ugrave;</pr></trd>
  </trdgrp>
</drv>
</art>
