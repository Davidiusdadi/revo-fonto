<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: asasin.xml,v 1.5 2025/09/15 16:37:48 revo Exp $">
    <kap>
      <rad>asasin</rad>/o
    </kap>

<drv mrk="asasin.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">HIS</uzo><uzo tip="fak">ISL</uzo>
  <snc mrk="asasin.0o.HIS">
    <dif>
      Ano de &scirc;ijasma-islama komunumo, kiu dum la krucmilitoj ekhavis renomon de sinoferaj murdistoj:
      <ekz>
        la nomo <nom>&scirc;aj&hcirc; al-&gcirc;abal</nom> (&leftquot;&Scirc;ejko de la Montoj&rightquot;) estis &gcirc;enerala nomumo de gvidanto
        de <tld/>a sekto, kiun la krucmilitistoj mistradukis kiel &leftquot;oldulo de la Monto&rightquot;
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=63897">&Scirc;ejko</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        la vorto <tld/>o esti&gcirc;is ver&scirc;ajne per franca transskribo de esprimo &leftquot;<nac>ha&scirc;i&scirc;iun</nac>&rightquot;,
        kiu aperas en la islama literaturo kaj &gcirc;i signifas &leftquot;konsumanto de ha&scirc;i&scirc;o&rightquot;
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=231764">Asasinoj</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 81%">&#x4EC0;&#x53F6;&#x6D3E;&#x7A46;&#x65AF;&#x6797;&#x793E;&#x7FA4;&#x7684;&#x6210;&#x5458;&#xFF1B;&#x8BE5;&#x793E;&#x7FA4;&#x6210;&#x5458;&#x5728;&#x5341;&#x5B57;&#x519B;&#x4E1C;&#x5F81;&#x671F;&#x95F4;&#x56E0;&#x820D;&#x751F;&#x5FD8;&#x6B7B;&#x5730;&#x884C;&#x523A;&#x6740;&#x4EBA;&#x800C;&#x58F0;&#x540D;&#x72FC;&#x85C9;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A member of a Shia Muslim community whose members became renowned during the Crusades as self-sacrificing murderers.</dif>
    <refgrp tip="vid">
       <ref cel="sxinob.0o">&scirc;inobo</ref>,
       <ref cel="sikari.0o">sikario</ref>
    </refgrp>
    <trd lng="de">Assasine</trd>
    <trd lng="en" kod="HIS" fnt="AI: de id pl dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">Assassin <klr>(historical)</klr></trd>
    <trdgrp lng="zh">
      <trd fnt="AI: de dif; proponis gpt-5.6-luna; taksis Jev 88%">&#x963F;&#x85A9;&#x8F9B;&#x6D3E;&#x6210;&#x54E1;</trd>,
      <trd fnt="AI: de dif; proponis gpt-5.6-luna; taksis Jev 88%">&#x963F;&#x8428;&#x8F9B;&#x6D3E;&#x6210;&#x5458;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_s;&c_a;&c_s;&c_y;&c_n;</trd>
  <trd lng="he">&#x5DE;&#x5B4;&#x5EA;&#x5E0;&#x5B7;&#x5E7;&#x5B5;&#x5E9;&#x5C1;</trd>
  <trdgrp lng="id">
    <trd>Assassin<klr tip="amb"> (Syiah)</klr></trd>,
    <trd>Hassasin<klr tip="amb"> (Syiah)</klr></trd>,
    <trd>Hasyasyiyyin<klr tip="amb"> (Syiah)</klr></trd>,
    <trd>Hasyisyin<klr tip="amb"> (Syiah)</klr></trd>,
    <trd>Hasysyasyin<klr tip="amb"> (Syiah)</klr></trd>
  </trdgrp>
  <trd lng="pl">asasin</trd>
</drv>
  </art>

