<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: baf.xml,v 1.4 2012/08/24 19:10:23 revo Exp $">
<kap>
  <rad>baf</rad> <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="baf.0">
  <kap><tld/></kap>
  <gra><vspec>ekkrio</vspec></gra>
  <snc mrk="baf.0.KOMUNE">
    <dif>
      Malgrave, neinterese, elrevige, indiferente:
      <ekz>
        kaj nun, <tld/>, mi ne scias kiel mi miksi&gcirc;is kun vi
        <fnt>
          <aut>M. de Seabra</aut>,
          <vrk>Deely Bobbers por Lucy</vrk>,
          <lok>Promeso en obskuro, 1997</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>, &scirc;ajnas tede, sed mi rigardos
        <fnt>
          <aut>C. Smith</aut>,
          <vrk><url
          ref="http://www.liberafolio.org/2011/vikipedio-en-esperanto-baldau-dekjara">
          Vikipedio en Esperanto - balda&ubreve; dekjara </url></vrk>,
          <lok>libera folio, 2011-01-16</lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 83%">&#x65E0;&#x5173;&#x7D27;&#x8981;&#x3001;&#x65E0;&#x8DA3;&#x3001;&#x4EE4;&#x4EBA;&#x5931;&#x671B;&#x6216;&#x6F20;&#x4E0D;&#x5173;&#x5FC3;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Of no importance, uninteresting, disappointing or a matter of indifference.</dif>
    <dif lng="de" fnt="AI: eo; tradukis claude-opus-5-5; kontrolis claude-opus-5-5">Unwichtig, uninteressant, entt&auml;uschend, gleichg&uuml;ltig.</dif>
  </snc>
  <trd lng="ca">bah!</trd>
  <trdgrp lng="de">
    <trd fnt="AI: fr ca it; proponis claude-opus-5-5; kontrolis claude-opus-5-5">pah</trd>,
    <trd fnt="AI: fr it dif; proponis claude-opus-5-5; kontrolis claude-opus-5-5">na ja</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd fnt="AI: fr dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">meh <klr>(colloquial)</klr></trd>,
    <trd fnt="AI: dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">oh well</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>bah !</trd>,
    <trd>bof !</trd>
  </trdgrp>
 <trdgrp lng="hu">
   <trd>&aacute;h</trd>,
   <trd>l&aacute;ri-f&aacute;ri</trd>
 </trdgrp> 
 <trdgrp lng="it">
    <trd>mah</trd>,
    <trd>boh</trd>,
    <trd>uffa</trd>
  </trdgrp>
</drv>
</art>

