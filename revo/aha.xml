<art mrk="$Id: aha.xml,v 1.7 2024/10/22 10:33:31 revo Exp $">
<kap>
  <rad>aha</rad> <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="aha.0">
  <kap><tld/></kap>
  <gra><vspec>ekkrio</vspec></gra>
  <snc mrk="aha.0.ekscio">
    <dif>
      Tio estas interesa nova&jcirc;o! Tio kompletigas jamajn sciojn:
      <ekz>
        &ndash; <tld lit="A"/>, tiel
        <fnt><bib>Metrop</bib></fnt>!
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd fnt="Vikt: en pl; juĝis claude-opus-5">aha</trd>,
      <trd fnt="Vikt: pl; juĝis claude-opus-5">ach so</trd>
    </trdgrp>
    <trd lng="en" fnt="Vikt: en pl; juĝis claude-opus-5">aha</trd>
  </snc>
  <trd lng="be">&c_a;&c_g;&c_a;!</trd>
  <trdgrp lng="es">
    <trd>aj&aacute;!</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>aha !</trd>,
    <trd>tiens-tiens !</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x306F;&#x306F;&#12354;</trd>,
    <trd>&#x306A;&#x308B;&#x307B;&#12393;</trd>,
    <trd>&#12354;&#12354;&#x305D;&#12358;&#x304B;</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>aha!</trd>,
    <trd>ha!</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_a;&c_g;&c_a;!</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd fnt="Vikt: en; taksis Jev 53%">&#x554A;</trd>,
    <trd fnt="Vikt: en; taksis Jev 75%">&#x554A;&#x54C8; <pr>&#x0101;h&#x0101;</pr></trd>,
    <trd fnt="Vikt: en; taksis Jev 36%">&#x55EF;</trd>
  </trdgrp>
</drv>
</art>

