<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: arnulf.xml,v 1.4 2024/10/17 18:36:28 revo Exp $">
    <kap>
      <rad>Arnulf</rad>/o
    </kap>

<drv mrk="arnulf.0o">
  <kap><tld/>o</kap>
  <snc mrk="arnulf.0o.nomo">
    <uzo tip="fak">NOM</uzo>
    <dif>
      Vira <ref tip="lst" lst="voko:personaj_nomoj" cel="nom.antaux0o">anta&ubreve;nomo</ref>
      germandevena, signifanta aglo kaj lupo,
      foje uzata sinonime al <ref tip="sin" cel="arnold.0o">Arnoldo</ref>:
      <ekz>
        pranepo de du el la plej gravaj figuroj de la A&ubreve;strazia Regno, nome Sankta
        <tld/>o de <nom>Metz</nom> kaj Pepino el <nom>Landen</nom>
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=7739"
              >Karolo la Granda</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        la <tld/>ista Partio estas politika partio en Panamo, la nomo estas derivita
        oma&gcirc;e al <tld/>o Arias, kiu estis la trifoja prezidento de Panamo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=19984"
              >Arnulfista Partio</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 90%">&#x6E90;&#x81EA;&#x65E5;&#x8033;&#x66FC;&#x8BED;&#x7684;&#x7537;&#x6027;&#x540D;&#x5B57;&#xFF0C;&#x610F;&#x4E3A;&#x9E70;&#x548C;&#x72FC;&#xFF0C;&#x6709;&#x65F6;&#x4F5C;&#x4E3A;&#x963F;&#x8BFA;&#x5FB7;&#x7684;&#x540C;&#x4E49;&#x8BCD;&#x4F7F;&#x7528;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">A male given name of Germanic origin, meaning eagle and wolf, sometimes used synonymously with Arnold.</dif>
    <trdgrp lng="de">
      <trd>Arnulf</trd>,
      <trd>Arnolf</trd>
    </trdgrp>
    <trd lng="en" fnt="AI: de pl; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">Arnulf</trd>
    <trd lng="pl">Arnulf</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: de ref; proponis gpt-5.6-luna; taksis Jev 89%">&#x963F;&#x52AA;&#x723E;&#x592B; <pr>&#x0100;n&#x01D4;'&ecaron;rf&#x016B;</pr></trd>,
      <trd fnt="AI: de ref; proponis gpt-5.6-luna; taksis Jev 89%">&#x963F;&#x52AA;&#x5C14;&#x592B; <pr>&#x0100;n&#x01D4;'&ecaron;rf&#x016B;</pr></trd>
    </trdgrp>
  </snc>
<trd lng="be">&c_A;&c_r;&c_n;&c_u;&c_l;&c_mol;&c_f;</trd>
</drv>

<drv mrk="arnulf.0idoj">
  <kap>
    <tld/>idoj
  </kap>
  <snc>
    <uzo tip="fak">HIS</uzo>
    <dif>
      Posteuloj de <tld/>o de Meco:
      <ekz>
        la idoj la&ubreve; agnata linio de <tld/>o de <nom>Metz</nom> estas do nomitaj <tld lit="a"/>idoj,
        &gcirc;is Karolo Martelo ekde kiu oni parolas pri karolidoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=511793"
              >Arnulfidoj</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 88%">&#x6885;&#x65AF;&#x7684;&#x963F;&#x52AA;&#x5C14;&#x592B;&#x7684;&#x540E;&#x88D4;&#x3002;</dif>
    <dif lng="en" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">Descendants of Arnulf of Metz.</dif>
    <trdgrp lng="zh">
      <trd fnt="AI: de pl dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x963F;&#x52AA;&#x723E;&#x82AC;&#x683C;&#x5BB6;&#x65CF;&#x6210;&#x54E1; <pr>&#x0100;n&#x01D4;'&ecaron;rf&#x016B;n g&eacute; ji&#x0101;z&uacute; ch&eacute;ngyu&aacute;n</pr></trd>,
      <trd fnt="AI: de pl dif; proponis gpt-5.6-luna; taksis Jev 81%">&#x963F;&#x52AA;&#x5C14;&#x82AC;&#x683C;&#x5BB6;&#x65CF;&#x6210;&#x5458; <pr>&#x0100;n&#x01D4;'&ecaron;rf&#x016B;n g&eacute; ji&#x0101;z&uacute; ch&eacute;ngyu&aacute;n</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_s;&c_mol;&c_l;&c_ja;&c_d;&c_o;&c_w;&c_n;&c_ib;&c_k;&c_ib; <ind>&c_A;&c_r;&c_n;&c_u;&c_l;&c_mol;&c_f;&c_a;</ind> &c_M;&c_e;&c_c;&c_k;&c_a;&c_g;&c_a;</trd>
  <trd lng="de">Arnolfinger</trd>
  <trd lng="en" kod="HIS" fnt="AI: de pl; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol">Arnulfing <klr>(historical)</klr></trd>
  <trd lng="pl">Arnulfingowie</trd>
</drv>
  </art>

