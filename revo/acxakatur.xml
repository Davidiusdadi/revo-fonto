<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: acxakatur.xml,v 1.16 2024/08/15 01:38:32 revo Exp $">
<kap>
  <rad>a&ccirc;akatur</rad>/o <fnt><bib>MuzTerm</bib></fnt>
</kap>
<drv mrk="acxakatur.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MUZ</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="ornam.melodi0o">Melodiornamo</ref>
      uzata en klasika e&ubreve;ropa muziko, kiu anta&ubreve;metas anta&ubreve; la tono
      tre mallongan komencan tonon duon- a&ubreve; plendute diferencan,
      a&ubreve;datan kiel preska&ubreve; samtempan:
      <ekz>
        la <tld/>on oni eble plej bone rigardu pli mallongan, malpli melodie gravan, varia&jcirc;on de la
        apo&gcirc;aturo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=32272">Ornamo (muziko)</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x7528;&#x4E8E;&#x6B27;&#x6D32;&#x53E4;&#x5178;&#x97F3;&#x4E50;&#x7684;&#x4E00;&#x79CD;&#x65CB;&#x5F8B;&#x88C5;&#x9970;&#x97F3;&#xFF0C;&#x5728;&#x672C;&#x97F3;&#x4E4B;&#x524D;&#x52A0;&#x4E0A;&#x4E00;&#x4E2A;&#x6781;&#x77ED;&#x7684;&#x8D77;&#x59CB;&#x97F3;&#xFF0C;&#x8BE5;&#x97F3;&#x4E0E;&#x672C;&#x97F3;&#x76F8;&#x5DEE;&#x534A;&#x97F3;&#x6216;&#x5168;&#x97F3;&#xFF0C;&#x542C;&#x8D77;&#x6765;&#x51E0;&#x4E4E;&#x4E0E;&#x672C;&#x97F3;&#x540C;&#x65F6;&#x53D1;&#x51FA;&#x3002;</dif>
    <refgrp tip="vid">
      <ref cel="apogxa.0o">apo&gcirc;aturo</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_a;&c_ch;&c_a;&c_k;&c_a;&c_t;&c_u;&c_r;&c_a;</trd>
  <trd lng="bg">&c_a;&c_ch;&c_a;&c_k;&c_a;&c_t;&c_u;&c_r;&c_a;</trd>
  <trdgrp lng="ca">
    <trd>acciaccatura</trd>,
    <trd>appoggiatura breu</trd>
  </trdgrp>
  <trd lng="de">kurzer <ind>Vorschlag</ind> <klr>(Musik)</klr></trd>
  <trdgrp lng="en">
    <trd>acciaccatura</trd>,
    <trd>crushed <ind>note</ind></trd>,
    <trd>short <ind>grace note</ind></trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>acciaccatura</trd>
  </trdgrp>
  <trd lng="he">&#x5E2;&#x5E5; &#x5D4;&#x5E9;&#x5D9;&#x5D8;&#x5D4;</trd>
  <trdgrp lng="hu">
    <trd>fel&uuml;t&eacute;s</trd>,
    <trd>acciaccatura</trd>
  </trdgrp>
  <trdgrp lng="it">
    <trd>appoggiatura breve</trd>,
    <trd>acciaccatura<klr> (mus.)</klr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>acciaccatura</trd>,
    <trd>pinc&eacute;</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>przednutka</trd>,
    <trd>acciaccatura</trd>
  </trdgrp>
  <trd lng="ru">&c_a;&c_ch;&c_ch;&c_a;&c_k;&c_k;&c_a;&c_t;&c_u;&c_r;&c_a;</trd>
  <trd lng="zh" fnt="AI: en de dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x77ED;&#x501A;&#x97F3; <pr>du&#x01CE;ny&#x01D0;y&#x012B;n</pr></trd>
</drv>
</art>

