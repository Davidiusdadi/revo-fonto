<vortaro>
  <art mrk="$Id: abutil.xml,v 1.4 2026/03/10 07:08:08 afido Exp $">
    <kap>
      <rad>abutil</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="abutil.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BOT</uzo>
  <snc mrk="abutil.0o.genro">
    <dif>
      <ref tip="lst" lst="voko:botanikaj_genroj" cel="genr.0o.BIO">Genro</ref>
      el familio <ref tip="malprt" cel="malvac.0oj">malvacoj</ref> (<trd lng="la">Abutilon</trd>),
      de tropikaj kaj
      subtropikaj specioj, pluraj el kiuj estas kultivataj ornamcele:
      <ekz>
        <tld/>o <klr>[&#8230;]</klr> estas kultivataj por ornamo a&ubreve; (ekz. A. theophrastii, el
        &Ccirc;inio) por fibroj utiligataj por <ref cel="jut.0o">juto</ref>
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=298842"
              >Abutilo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-sol; kontrolis gpt-5.6-sol">&#x9526;&#x8475;&#x79D1;&#x4E2D;&#x7531;&#x70ED;&#x5E26;&#x548C;&#x4E9A;&#x70ED;&#x5E26;&#x7269;&#x79CD;&#x7EC4;&#x6210;&#x7684;&#x4E00;&#x4E2A;&#x5C5E;&#xFF08;Abutilon&#xFF09;&#xFF0C;&#x5176;&#x4E2D;&#x82E5;&#x5E72;&#x79CD;&#x4F5C;&#x4E3A;&#x89C2;&#x8D4F;&#x690D;&#x7269;&#x683D;&#x57F9;&#x3002;</dif>
    <bld
      lok="&WCU;/thumb/0/08/Starr_070215-4594_Abutilon_grandifolium.jpg/330px-Starr_070215-4594_Abutilon_grandifolium.jpg"
      prm="CC BY 3.0"
      ><tld/>o (Abutilon grandifolium), Maui, Waihee
        <fnt>
          <aut>Forest &amp; Kim Starr, Plants of Hawaii, Image 070215-4594 from
          http://www.hear.org/starr/plants/images/image/?q=070215-4594</aut>
          <lok><url ref="&WCW;/File:Starr_070215-4594_Abutilon_grandifolium.jpg"
              >https://commons.wikimedia.org/wiki/File:Starr_070215-4594_Abutilon_grandifolium.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_a;&c_b;&c_u;&c_t;&c_y;&c_l;&c_jo;&c_n;</trd>
    <trd lng="de">Abutilon</trd>
    <trd lng="en">Abutilon</trd>
    <trd lng="fr">Abutilon</trd>
    <trd lng="pl">za&sacute;laz</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de fr la ref dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x82D8;&#x9EBB;&#x5C6C;</trd>,
      <trd fnt="AI: en de fr la ref dif; proponis gpt-5.6-sol; kontrolis gpt-5.6-sol; serĉo">&#x82D8;&#x9EBB;&#x5C5E;</trd>
    </trdgrp>
  </snc>
</drv>
