<drv mrk="bopal.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Granda <ref tip="lst" lst="voko:urboj" cel="urb.0o.ARKI">urbo</ref>
      en la centro de <ref tip="malprt" cel="barat.B0o">Barato</ref>,
      &ccirc;. 500&#8239;km oriente de <ref cel="ahmadabad.0o">Ahmadabado</ref>
      kaj sudokcidente de <ref cel="laknaux.0o">Lakna&ubreve;o</ref>:
      <ekz>
        oni nomas <tld/>on urbo de lagoj pro la multaj lagoj tie, &gcirc;i estas
        <klr>[&#8230;]</klr> kultura centro de urdua poezio
        <fnt>
          <bib>Viki</bib>
          <vrk><url ref="&Viki;/Bopalo">Bopalo</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        en <tld/>o la 300&#8239;000 post-vivantoj de la industria akcidento de la uzino &leftquot;Union
        Carbide&rightquot; en 1984 timas nun forpasi pro la kronviruso
        <fnt>
          <vrk><url
          ref="http://neniammilitointerni.over-blog.com/2020/04/kronviruso-en-barato-la-postvivantoj-de-bopalo-estas-aparte-vundeblaj.html"
          >Kronviruso en Barato: la postvivantoj de Bopalo estas aparte vundeblaj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <dif lng="zh" fnt="AI: eo; tradukis gpt-5.6-luna; taksis Jev 89%">&#x5370;&#x5EA6;&#x4E2D;&#x90E8;&#x7684;&#x4E00;&#x5EA7;&#x5927;&#x57CE;&#x5E02;&#xFF0C;&#x4F4D;&#x4E8E;&#x827E;&#x54C8;&#x8FC8;&#x8FBE;&#x5DF4;&#x5FB7;&#x4EE5;&#x4E1C;&#x7EA6;500&#x516C;&#x91CC;&#x3001;&#x52D2;&#x514B;&#x7459;&#x7684;&#x897F;&#x5357;&#x65B9;&#x3002;</dif>
    <trd lng="be">&c_B;&c_h;&c_a;&c_p;&c_a;&c_l;</trd>
    <trd lng="de">Bhopal</trd>
    <trd lng="en">Bhopal</trd>
    <trd lng="fr">Bhopal</trd>
    <trd lng="hi">&#2349;&#2379;&#2346;&#2366;&#2354;</trd>
    <trd lng="pl">Bhopal</trd>
    <trd lng="ur">&a_b;&#1726;&a_w;&f_p;&a_A;&a_l;</trd>
    <trdgrp lng="zh">
      <trd fnt="AI: en de hi; proponis gpt-5.6-luna; taksis Jev 94%">&#x535A;&#x5E15;&#x723E; <pr>B&oacute;p&agrave;'&ecaron;r</pr></trd>,
      <trd fnt="AI: en de hi; proponis gpt-5.6-luna; taksis Jev 94%">&#x535A;&#x5E15;&#x5C14; <pr>B&oacute;p&agrave;'&ecaron;r</pr></trd>
    </trdgrp>
  </snc>
